{
  "system_meta": {
    "framework": "Mosco Pure Material System",
    "version": "4.0.0",
    "architecture": "Single Font Family Native Design (High-Performance DRY)",
    "language": "en-US"
  },
  "theme": {
    "dark": {
      "brand": {
        "primary": "#24A1DE",
        "primary_variant": "#1A7AAB",
        "secondary": "#FFD952"
      },
      "semantic": {
        "background": "#0F172A",
        "surface": "#1E293B",
        "surface_variant": "#334155",
        "text_primary": "#F8FAFC",
        "text_secondary": "#94A3B8",
        "on_primary": "#FFFFFF"
      }
    }
  },
  "shape": {
    "corner_radius": "33px",
    "circular_radius": "9999px"
  },
  "typography_mapping": {
    "fonts": {
      "global_font_family": "Roboto, sans-serif"
    },
    "contexts": {
      "fragment_title": {
        "font": "Roboto",
        "weight": 900,
        "case": "normal"
      },
      "character_heading": {
        "font": "Roboto",
        "weight": 700,
        "case": "normal"
      },
      "resource_value_technical": {
        "font": "Roboto",
        "weight": 700
      },
      "buttons_text": {
        "font": "Roboto",
        "weight": 700
      },
      "body_and_dialog_text": {
        "font": "Roboto",
        "weight": 400
      }
    }
  }
}