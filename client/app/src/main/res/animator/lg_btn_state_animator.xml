<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:duration="100" android:valueTo="0.96" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic"/>
            <objectAnimator android:propertyName="scaleY" android:duration="100" android:valueTo="0.96" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic"/>
            <objectAnimator android:propertyName="alpha" android:duration="100" android:valueTo="0.85" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:duration="250" android:valueTo="1.0" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot"/>
            <objectAnimator android:propertyName="scaleY" android:duration="250" android:valueTo="1.0" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot"/>
            <objectAnimator android:propertyName="alpha" android:duration="250" android:valueTo="1.0" android:valueType="floatType" />
        </set>
    </item>
</selector>
