<?xml version="1.0" encoding="utf-8"?>
<!-- Item cho mỗi dòng xếp hạng: Hạng | Avatar | Tên | Chỉ số -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_rank_item"
    android:paddingHorizontal="@dimen/rank_item_padding_h"
    android:paddingVertical="@dimen/rank_item_padding_v"
    android:layout_marginBottom="8dp">

    <!-- Rank Badge Area (Crown with Number inside) -->
    <FrameLayout
        android:layout_width="@dimen/rank_badge_size"
        android:layout_height="@dimen/rank_badge_size"
        android:layout_marginEnd="@dimen/spacing_8dp">


        <TextView
            android:id="@+id/tv_rank_position"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            style="@style/MoscoText.Luxury.Nav"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontWeight="900"
            android:textColor="@color/white" />
    </FrameLayout>

    <!-- Avatar Area with Crown -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_partner_avatar"
            android:layout_width="@dimen/rank_avatar_size"
            android:layout_height="@dimen/rank_avatar_size"
            android:layout_marginStart="24dp"
            app:cardCornerRadius="@dimen/spacing_100dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/lg_glass_surface_high"
            app:strokeColor="@color/mosco_white_20"
            app:strokeWidth="0.8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_partner_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_avatar"
            android:layout_width="@dimen/rank_avatar_size"
            android:layout_height="@dimen/rank_avatar_size"
            app:cardCornerRadius="@dimen/spacing_100dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/lg_glass_surface_high"
            app:strokeColor="@color/mosco_white_20"
            app:strokeWidth="0.8dp">

            <ImageView
                android:id="@+id/iv_rank_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Tên người chơi -->
    <TextView
        android:id="@+id/tv_rank_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/radius_lg"
        android:layout_marginEnd="@dimen/spacing_sm"
        style="@style/MoscoText.Luxury.Body"
        android:textSize="@dimen/text_size_hud_small"
        android:textStyle="bold"
        android:fontWeight="700"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Chỉ số (Level / OVR / Card Count) -->
    <LinearLayout
        android:id="@+id/layout_rank_value_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/tv_rank_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.Price"
            android:textColor="@color/item_diamond"
            android:textSize="@dimen/text_size_hud_large"
            android:textStyle="bold"
            android:fontWeight="700" />
    </LinearLayout>
</LinearLayout>


