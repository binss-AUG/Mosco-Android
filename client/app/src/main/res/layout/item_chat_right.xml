<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end|bottom"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="0dp">

    <!-- Flat Premium Message Frame (No Bubble, completely borderless and seamless) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bubble_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_self"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:maxWidth="260dp">

        <!-- Message text (Premium Inline Layout: paddingEnd reserves space for time) -->
        <TextView
            android:id="@+id/tv_chat_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="240dp"
            app:layout_constraintWidth_max="240dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:breakStrategy="simple"
            android:clipToPadding="false"
            android:paddingEnd="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0.0"
            tools:text="Good morning! Japan looks amazing!" />

        <!-- Spacer + Time aligned at bottom right -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Subtle spacer -->
            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <!-- Time Stamp -->
            <TextView
                android:id="@+id/tv_chat_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:paddingEnd="2dp"
                android:textColor="@color/mosco_white_60"
                tools:text="10:10" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
