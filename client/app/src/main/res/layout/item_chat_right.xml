<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_xs"
    android:gravity="bottom|end">

    <TextView
        android:id="@+id/tv_chat_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="@drawable/bg_chat_bubble_self"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_body_sm" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_chat_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/mosco_card_bg_variant"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_chat_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
