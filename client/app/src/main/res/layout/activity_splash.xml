<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mosco_screen_bg">

    <include layout="@layout/layout_auth_background" />


    <!-- Khung Loading Trung tâm -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_logo_lottie"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loading" />

    <!-- 📝 TEXT TRẠNG THÁI (Luôn hiển thị để user biết app đang làm gì) -->
    <TextView
        android:id="@+id/tv_download_status"
        style="@style/MoscoText.Luxury.SubHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="110dp"
        android:text="Connecting..."
        android:textSize="14sp"
        android:textColor="@color/white_80"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🚀 KHU VỰC TẢI DỮ LIỆU (Chỉ hiện thanh progress khi cần) -->
    <LinearLayout
        android:id="@+id/layout_download_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Progress Bar Custom Style -->
        <ProgressBar
            android:id="@+id/pb_download"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progressDrawable="@drawable/mosco_progress_bar"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_download_count"
            style="@style/MoscoText.Luxury.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:text="0%"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ❌ KHU VỰC BÁO LỖI KẾT NỐI (Ẩn mặc định) -->
    <LinearLayout
        android:id="@+id/layout_retry_connection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/MoscoText.Luxury.SubHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="@string/splash_error_connection_title"
            android:textColor="@color/stat_atk"
            android:textSize="18sp" />

        <TextView
            style="@style/MoscoText.Luxury.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:alpha="0.8"
            android:gravity="center"
            android:text="@string/splash_error_connection_msg"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_connection"
            style="@style/MoscoText.Luxury.Button"
            android:layout_width="200dp"
            android:layout_height="54dp"
            android:text="@string/splash_btn_retry"
            app:backgroundTint="@color/mosco_surface"
            app:cornerRadius="27dp"
            app:elevation="8dp"
            app:strokeColor="@color/mosco_primary"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>