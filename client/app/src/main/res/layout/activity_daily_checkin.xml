<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/lg_background_deep">

    <!-- Dynamic Overlay Background (Driven by ViewPager Color Interpolation) -->
    <View
        android:id="@+id/view_bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/black" />

    <!-- Luxury Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header_daily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/home_showcase_margin_horizontal"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/home_header_pill_padding_v"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back_daily"
            android:layout_width="@dimen/spacing_40dp"
            android:layout_height="@dimen/spacing_40dp"
            android:src="@drawable/ic_back_arrow"
            android:padding="@dimen/spacing_xs"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/home_header_pill_padding_h"
            app:layout_constraintStart_toEndOf="@id/btn_back_daily"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily_header_title"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="@dimen/text_size_h3"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
            
            <View
                android:id="@+id/view_header_accent"
                android:layout_width="@dimen/spacing_xl"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:background="@color/daily_morning_accent" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ViewPager2 with Perfect Proportions -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_daily_cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_56dp"
        android:paddingBottom="@dimen/spacing_xxl"
        app:layout_constraintDimensionRatio="H,1:1.5"
        app:layout_constraintTop_toBottomOf="@id/layout_header_daily"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_indicator"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Indicator -->
    <LinearLayout
        android:id="@+id/layout_bottom_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/spacing_section"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <View
            android:id="@+id/dot_0"
            android:layout_width="@dimen/home_header_pill_divider_v"
            android:layout_height="@dimen/handle_height"
            android:background="@drawable/bg_indicator_active"
            android:layout_marginHorizontal="@dimen/spacing_xxs" />
        <View
            android:id="@+id/dot_1"
            android:layout_width="@dimen/home_header_pill_divider_v"
            android:layout_height="@dimen/handle_height"
            android:background="@drawable/bg_indicator_inactive"
            android:layout_marginHorizontal="@dimen/spacing_xxs" />
        <View
            android:id="@+id/dot_2"
            android:layout_width="@dimen/home_header_pill_divider_v"
            android:layout_height="@dimen/handle_height"
            android:background="@drawable/bg_indicator_inactive"
            android:layout_marginHorizontal="@dimen/spacing_xxs" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

