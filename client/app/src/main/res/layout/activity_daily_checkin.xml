<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_global_gradient">

    <!-- Dynamic Overlay Background -->
    <View
        android:id="@+id/view_bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/black" />

    <!-- Simplified Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header_daily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back_daily"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btn_back_daily"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily_header"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontWeight="900"
                android:letterSpacing="0.1" />
            
            <View
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:layout_marginTop="2dp"
                android:background="#8A2BE2" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ViewPager2 with Perfect 1:1.5 Proportions -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_daily_cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="56dp"
        android:paddingBottom="48dp"
        app:layout_constraintDimensionRatio="H,1:1.5"
        app:layout_constraintTop_toBottomOf="@id/layout_header_daily"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_indicator"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Indicator -->
    <LinearLayout
        android:id="@+id/layout_bottom_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <View
            android:id="@+id/dot_0"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:background="@drawable/bg_indicator_active"
            android:layout_marginHorizontal="4dp" />
        <View
            android:id="@+id/dot_1"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:background="@drawable/bg_indicator_inactive"
            android:layout_marginHorizontal="4dp" />
        <View
            android:id="@+id/dot_2"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:background="@drawable/bg_indicator_inactive"
            android:layout_marginHorizontal="4dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
