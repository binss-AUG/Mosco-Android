<?xml version="1.0" encoding="utf-8"?>
<!-- Daily Check-in — 3 stacked banner cards -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_global_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_back_daily"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_arrow"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:cardBackgroundColor="#1A1C29"
            app:cardCornerRadius="8dp"
            app:strokeColor="#8A2BE2"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY CHECK-IN"
                android:fontFamily="@font/saira"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.05" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Scrollable stack of 3 cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══ Slot 0: MORNING ═══ -->
            <LinearLayout
                android:id="@+id/card_slot_morning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_glass_v2"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false"
                android:clipChildren="false">

                <!-- Banner area -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp">

                    <ImageView
                        android:id="@+id/iv_banner_morning"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_global_gradient"
                        android:alpha="0.4" />

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mosco_logo_static"
                        android:alpha="0.6" />
                </FrameLayout>

                <!-- Info area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <!-- Left: Title + Time + Rewards -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Morning"
                            android:fontFamily="@font/saira"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_time_morning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="06:00 - 11:59"
                            android:fontFamily="@font/poppins"
                            android:textColor="#BDBDBD"
                            android:textSize="11sp" />

                        <!-- Rewards row: coin icon + amount + diamond icon + amount -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_item_coin" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="500"
                                android:fontFamily="@font/poppins"
                                android:textColor="#FFD700"
                                android:textSize="11sp"
                                android:layout_marginStart="4dp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_item_diamond"
                                android:layout_marginStart="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:fontFamily="@font/poppins"
                                android:textColor="@color/item_diamond"
                                android:textSize="11sp"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Right: Claim button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_claim_morning"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:text="CLAIM"
                        android:fontFamily="@font/saira"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_rainbow"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Slot 1: AFTERNOON ═══ -->
            <LinearLayout
                android:id="@+id/card_slot_noon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_glass_v2"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false"
                android:clipChildren="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp">

                    <ImageView
                        android:id="@+id/iv_banner_noon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_global_gradient"
                        android:alpha="0.4" />

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mosco_logo_static"
                        android:alpha="0.6" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Afternoon"
                            android:fontFamily="@font/saira"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_time_noon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12:00 - 17:59"
                            android:fontFamily="@font/poppins"
                            android:textColor="#BDBDBD"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_item_coin" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="800"
                                android:fontFamily="@font/poppins"
                                android:textColor="#FFD700"
                                android:textSize="11sp"
                                android:layout_marginStart="4dp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_item_diamond"
                                android:layout_marginStart="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2"
                                android:fontFamily="@font/poppins"
                                android:textColor="@color/item_diamond"
                                android:textSize="11sp"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_claim_noon"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:text="CLAIM"
                        android:fontFamily="@font/saira"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_rainbow"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Slot 2: EVENING ═══ -->
            <LinearLayout
                android:id="@+id/card_slot_evening"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_glass_v2"
                android:layout_marginBottom="16dp"
                android:clipToPadding="false"
                android:clipChildren="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp">

                    <ImageView
                        android:id="@+id/iv_banner_evening"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_global_gradient"
                        android:alpha="0.4" />

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mosco_logo_static"
                        android:alpha="0.6" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Evening"
                            android:fontFamily="@font/saira"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_time_evening"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18:00 - 23:59"
                            android:fontFamily="@font/poppins"
                            android:textColor="#BDBDBD"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_item_coin" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1,200"
                                android:fontFamily="@font/poppins"
                                android:textColor="#FFD700"
                                android:textSize="11sp"
                                android:layout_marginStart="4dp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_item_diamond"
                                android:layout_marginStart="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:fontFamily="@font/poppins"
                                android:textColor="@color/item_diamond"
                                android:textSize="11sp"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_claim_evening"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:text="CLAIM"
                        android:fontFamily="@font/saira"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_rainbow"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
