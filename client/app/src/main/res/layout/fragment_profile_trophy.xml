<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/lg_content_bottom_clearance"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Gacha Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_input"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_label_gacha_stats"
                style="@style/MoscoText.Luxury.Label"
                android:textColor="@color/white_40"
                android:layout_marginBottom="@dimen/spacing_md" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                
                <!-- Total Rolls -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    
                    <TextView
                        android:id="@+id/tv_total_rolls_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/MoscoText.Luxury.Header"
                        android:textSize="24sp"
                        tools:text="15,402" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_label_total_rolls"
                        style="@style/MoscoText.Luxury.Label"
                        android:textColor="@color/mosco_outline" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#33FFFFFF"
                    android:layout_marginHorizontal="@dimen/spacing_md" />

                <!-- Collection Progress -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    
                    <TextView
                        android:id="@+id/tv_collection_progress_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/MoscoText.Luxury.Header"
                        android:textSize="24sp"
                        tools:text="85%" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_label_collection"
                        style="@style/MoscoText.Luxury.Label"
                        android:textColor="@color/mosco_outline" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_input"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_label_honor_badges"
                style="@style/MoscoText.Luxury.Label"
                android:textColor="@color/white_40"
                android:layout_marginBottom="@dimen/spacing_md" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                
            <TextView
                android:id="@+id/tv_no_badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_msg_no_badges"
                android:gravity="center"
                style="@style/MoscoText.Luxury.Body"
                android:alpha="0.5"
                android:padding="@dimen/spacing_md" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
