<?xml version="1.0" encoding="utf-8"?>
<!-- Event — COMING SOON placeholder -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_global_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_back_mission"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_arrow"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:cardBackgroundColor="#1A1C29"
            app:cardCornerRadius="8dp"
            app:strokeColor="#8A2BE2"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mission_header_title"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="@dimen/text_size_body_lg"
                android:textStyle="bold"
                android:fontWeight="700"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.05" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- COMING SOON banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_mosco_logo_static"
            android:alpha="0.3"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mission_coming_soon"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontWeight="700"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mission_coming_soon_desc"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="#A2A2A7"
            android:textSize="@dimen/text_size_body_sm"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</LinearLayout>
