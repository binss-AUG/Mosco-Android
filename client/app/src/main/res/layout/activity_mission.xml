<?xml version="1.0" encoding="utf-8"?>
<!-- Event — COMING SOON placeholder -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/lg_background_deep">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_20dp"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/radius_lg">

        <ImageView
            android:id="@+id/btn_back_mission"
            android:layout_width="@dimen/spacing_36dp"
            android:layout_height="@dimen/spacing_36dp"
            android:src="@drawable/ic_back_arrow"
            android:padding="@dimen/spacing_6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/radius_lg"
            app:cardBackgroundColor="@color/lg_glass_surface_elevated"
            app:cardCornerRadius="@dimen/spacing_sm"
            app:strokeColor="@color/lg_glass_stroke"
            app:strokeWidth="@dimen/stroke_thin">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_mission_header"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="@dimen/text_size_body_lg"
                android:textStyle="bold"
                android:fontWeight="700"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_xs"
                android:letterSpacing="0.05" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- COMING SOON banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_40dp">

        <ImageView
            android:layout_width="@dimen/spacing_80dp"
            android:layout_height="@dimen/spacing_80dp"
            android:src="@drawable/ic_mosco_logo_static"
            android:alpha="0.3"
            android:layout_marginBottom="@dimen/spacing_20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_mission_coming_soon"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_h1"
            android:textStyle="bold"
            android:fontWeight="700"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_mission_coming_soon_desc"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_body_sm"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_sm" />

    </LinearLayout>

</LinearLayout>


