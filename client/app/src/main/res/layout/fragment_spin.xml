<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_spin_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Giao diện Spin chính -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_spin_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/spacing_20dp">

        <TextView
            android:id="@+id/tv_spin_ticket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_20dp"
            android:text="@string/spin_label_ticket"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_body_lg"
            android:textStyle="bold"
            android:fontWeight="700"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            style="@style/MoscoText.Luxury.Body"
            android:text="⏳ 23:39:14"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_body_sm"
            app:layout_constraintStart_toStartOf="@+id/tv_spin_ticket"
            app:layout_constraintTop_toBottomOf="@+id/tv_spin_ticket" />

        <!-- Các thẻ chạy nền -->
        <!-- Đã đổi từ ảnh máy bay sang nền skeleton tĩnh để đồng bộ Luxury -->
        <View
            android:id="@+id/iv_bg_card_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.2"
            android:background="@drawable/bg_skeleton_rect_rounded"
            android:visibility="invisible"
            app:layout_constraintDimensionRatio="H,1:1.54"
            app:layout_constraintWidth_percent="0.41"
            app:layout_constraintBottom_toBottomOf="@+id/card_center_slot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/card_center_slot" />

        <View
            android:id="@+id/iv_bg_card_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.2"
            android:background="@drawable/bg_skeleton_rect_rounded"
            android:visibility="invisible"
            app:layout_constraintDimensionRatio="H,1:1.54"
            app:layout_constraintWidth_percent="0.41"
            app:layout_constraintBottom_toBottomOf="@+id/card_center_slot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/card_center_slot" />

        <View
            android:id="@+id/iv_bg_card_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.2"
            android:background="@drawable/bg_skeleton_rect_rounded"
            android:visibility="invisible"
            app:layout_constraintDimensionRatio="H,1:1.54"
            app:layout_constraintWidth_percent="0.41"
            app:layout_constraintBottom_toBottomOf="@+id/card_center_slot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/card_center_slot" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_center_slot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="@color/mosco_card_bg"
            app:cardCornerRadius="@dimen/spacing_md"
            app:cardElevation="@dimen/spacing_10dp"
            app:layout_constraintDimensionRatio="H,1:1.54"
            app:layout_constraintWidth_percent="0.56"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_timer"
            app:layout_constraintBottom_toTopOf="@+id/btn_spin">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/btn_add_objet"
                    android:layout_width="@dimen/spacing_60dp"
                    android:layout_height="@dimen/spacing_60dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_dark">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_h1_xl" />
                </FrameLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_selected_front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">
                    <include layout="@layout/layout_core_card" />

                    <!-- Mặt sau thẻ hi sinh (Hiện khi Flip 3D, mặc định ẩn) -->
                    <ImageView
                        android:id="@+id/iv_sacrifice_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/objet_back_spin"
                        android:visibility="gone" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ⏳ Skeleton Loading thay cho Lottie -->
                <include
                    layout="@layout/layout_objekt_card_skeleton"
                    android:id="@+id/layout_spin_loading_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_spin"
            android:layout_width="0dp"
            android:layout_height="@dimen/spacing_56dp"
            android:layout_marginHorizontal="@dimen/spacing_20dp"
            android:layout_marginBottom="@dimen/spacing_20dp"
            android:background="@drawable/bg_btn_rainbow"
            android:backgroundTint="@color/mosco_btn_disabled"
            android:enabled="false"
            android:text="@string/spin_action_spin"
            style="@style/MoscoText.Luxury.Button"
            android:textAllCaps="false"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Giao diện Lưới bốc thẻ 4x4 (Chặng 4) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_reveal_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_grid_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spin_label_grid_title"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_body_lg"
            android:textStyle="bold"
            android:fontWeight="700"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/rv_secret_grid"
            app:layout_constraintVertical_chainStyle="spread" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_secret_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/radius_lg"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_grid_title"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm_select"
            tools:listitem="@layout/item_secret_card" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirm_select"
            android:layout_width="0dp"
            android:layout_height="@dimen/spacing_56dp"
            android:layout_marginHorizontal="@dimen/spacing_20dp"
            android:background="@drawable/bg_btn_rainbow"
            android:backgroundTint="@color/mosco_btn_disabled"
            android:enabled="false"
            android:text="@string/spin_action_confirm"
            style="@style/MoscoText.Luxury.Button"
            android:textAllCaps="false"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700"
            app:layout_constraintTop_toBottomOf="@+id/rv_secret_grid"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Giao diện Kết quả bốc thẻ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_result_reveal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="@dimen/spacing_10dp">

        <!-- Title: Spin was successful! -->
        <TextView
            android:id="@+id/tv_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_60dp"
            android:text="@string/spin_msg_success"
            style="@style/MoscoText.Luxury.Header"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold"
            android:fontWeight="700"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtitle: Received the ... Objekt. -->
        <TextView
            android:id="@+id/tv_result_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            style="@style/MoscoText.Luxury.Body"
            android:text="Received the Atom02 SoHyun 104Z Objekt."
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_body_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_result_title" />

        <!-- Frame Glow (Rendered before card to avoid elevation light artifacts) -->
        <ImageView
            android:id="@+id/iv_frame_result_spin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/frame_result_spin"
            android:alpha="0"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/card_result_final"
            app:layout_constraintBottom_toBottomOf="@id/card_result_final"
            app:layout_constraintStart_toStartOf="@id/card_result_final"
            app:layout_constraintEnd_toEndOf="@id/card_result_final" />

        <!-- Card giữ nguyên width 0.61 như bản gốc, constrained giữa parent để giữ kích thước -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_result_final"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="@color/mosco_card_bg"
            app:cardCornerRadius="@dimen/spacing_md"
            app:cardElevation="@dimen/spacing_15dp"
            app:layout_constraintDimensionRatio="H,1:1.54"
            app:layout_constraintWidth_percent="0.61"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Mặt sau objet (hiện trong animation xoay Y) -->
            <ImageView
                android:id="@+id/iv_result_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Mặt trước objet (ảnh kết quả) -->
            <ImageView
                android:id="@+id/iv_result_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <View
            android:id="@+id/view_neon_glow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_neon_glow"
            android:alpha="0.0"
            android:elevation="@dimen/spacing_20dp"
            app:layout_constraintTop_toTopOf="@id/card_result_final"
            app:layout_constraintBottom_toBottomOf="@id/card_result_final"
            app:layout_constraintStart_toStartOf="@id/card_result_final"
            app:layout_constraintEnd_toEndOf="@id/card_result_final" />

        <!-- Reveal unchosen Objekts > -->
        <TextView
            android:id="@+id/tv_reveal_unchosen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:text="@string/spin_action_reveal_unchosen"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_body_sm"
            android:alpha="0"
            android:visibility="invisible"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@id/btn_collect"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Nút Done -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_collect"
            android:layout_width="0dp"
            android:layout_height="@dimen/spacing_56dp"
            android:layout_marginHorizontal="@dimen/spacing_20dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_btn_rainbow"
            android:backgroundTint="@color/mosco_card_stroke"
            android:text="@string/spin_action_collect"
            style="@style/MoscoText.Luxury.Button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700"
            android:alpha="0"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Giao diện Reveal Grid kết quả — CÙNG layout với layout_reveal_grid -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_reveal_result_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="@dimen/spacing_15dp">

        <!-- Nút mũi tên quay lại (overlay, không ảnh hưởng chain) -->
        <ImageView
            android:id="@+id/iv_reveal_back"
            android:layout_width="@dimen/spacing_40dp"
            android:layout_height="@dimen/spacing_40dp"
            android:layout_marginStart="@dimen/radius_lg"
            android:layout_marginTop="@dimen/spacing_md"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_back_arrow"
            android:clickable="true"
            android:focusable="true"
            android:elevation="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <!-- Title: Spin Result — CÙNG vị trí với tv_grid_title -->
        <TextView
            android:id="@+id/tv_reveal_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spin_msg_result_grid"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_body_lg"
            android:textStyle="bold"
            android:fontWeight="700"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/rv_reveal_result_grid"
            app:layout_constraintVertical_chainStyle="spread" />

        <!-- Grid 4x4 — CÙNG kích thước/vị trí với rv_secret_grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_reveal_result_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/radius_lg"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reveal_result_title"
            app:layout_constraintBottom_toTopOf="@+id/btn_try_again" />

        <!-- Nút Try Again — CÙNG constraint với btn_confirm_select -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_try_again"
            android:layout_width="0dp"
            android:layout_height="@dimen/spacing_56dp"
            android:layout_marginHorizontal="@dimen/spacing_40dp"
            android:background="@drawable/bg_btn_rainbow"
            android:backgroundTint="@color/mosco_card_stroke"
            android:text="@string/spin_action_try_again"
            style="@style/MoscoText.Luxury.Button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700"
            app:layout_constraintTop_toBottomOf="@+id/rv_reveal_result_grid"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Container viền trắng bao quanh VideoView để xác định vị trí -->
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="@dimen/spacing_100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <VideoView
            android:id="@+id/video_spin_effect"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>



