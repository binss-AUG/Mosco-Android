<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/mosco_surface_container"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Item Image Placeholder -->
        <ImageView
            android:id="@+id/dialogItemImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/card_border"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/dialogItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Item Name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogItemDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="This is an item description that explains what it does."
            android:textColor="@color/mosco_on_surface_variant"
            android:textSize="14sp" />
            
        <TextView
            android:id="@+id/dialogItemQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Owned: 0"
            android:textColor="@color/mosco_primary_dim"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnUseItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/mosco_primary"
            android:text="Use Item"
            android:textColor="@color/white"
            app:cornerRadius="8dp" />
            
        <Button
            android:id="@+id/btnCloseDialog"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Close"
            android:textColor="@color/mosco_on_surface_variant" />
            
    </LinearLayout>
</androidx.cardview.widget.CardView>
