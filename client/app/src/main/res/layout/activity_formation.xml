<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mosco_bg_dark"
    tools:context=".FormationActivity">

    <!-- ── PART 1: HEADER (TOP) ──────────────────────────────────────── -->
    <!-- Standard Galactic Header (Abstracted) -->
    <include
        android:id="@+id/layout_header_formation_container"
        layout="@layout/layout_galactic_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Right Side Content (OVR Stats) -->
    <LinearLayout
        android:id="@+id/layout_header_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_header_formation_container"
        app:layout_constraintBottom_toBottomOf="@id/layout_header_formation_container">
        
        <TextView
            android:id="@+id/tv_total_ovr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.Header"
            android:text="OVR: 0"
            android:textColor="@color/mosco_tertiary"
            android:textSize="@dimen/text_size_h3"
            android:fontWeight="700" />
            
        <TextView
            android:id="@+id/btn_global_buffs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUFF ACTIVE"
            style="@style/MoscoText.Luxury.Label"
            android:textColor="@color/white_40"
            android:textSize="@dimen/text_size_mini"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ── PART 2: STAGE (BODY) ──────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/stage_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/formation_stage_margin_top"
        android:layout_marginBottom="@dimen/formation_bottom_sheet_peek"
        android:clipChildren="false">

        <!-- Custom Canvas for Neon Lines -->
        <com.vn.jet.mosco.view.NeonLineView
            android:id="@+id/neon_line_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Static 1-2-1-2 Grid Layout -->
        <LinearLayout
            android:id="@+id/ll_stage_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/formation_grid_margin"
            android:clipChildren="false"
            android:orientation="vertical"
            android:weightSum="4">

            <!-- Row 0: 1 Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:weightSum="2">
                <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5" />
                <include layout="@layout/item_formation_slot" android:id="@+id/slot0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5" />
            </LinearLayout>

            <!-- Row 1: 2 Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:weightSum="2">
                <include layout="@layout/item_formation_slot" android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <include layout="@layout/item_formation_slot" android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>

            <!-- Row 2: 1 Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:weightSum="2">
                <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5" />
                <include layout="@layout/item_formation_slot" android:id="@+id/slot3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5" />
            </LinearLayout>

            <!-- Row 3: 2 Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:weightSum="2">
                <include layout="@layout/item_formation_slot" android:id="@+id/slot4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <include layout="@layout/item_formation_slot" android:id="@+id/slot5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Dim overlay for highlighting -->
    <View
        android:id="@+id/dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/shadow_dark"
        android:visibility="gone" />

    <!-- ── PART 3: SYNERGY BOTTOMSHEET ────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/synergy_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_footer"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        app:behavior_peekHeight="@dimen/formation_bottom_sheet_peek"
        app:behavior_hideable="false"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.30"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Header: Drag Handle + Title + Toggle Button -->
        <LinearLayout
            android:id="@+id/synergy_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/formation_bottom_sheet_peek"
            android:background="@drawable/bg_synergy_header"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_md">

            <!-- Drag Handle -->
            <View
                android:layout_width="@dimen/formation_handle_width"
                android:layout_height="@dimen/formation_handle_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_bottomsheet_handle" />

            <!-- Title -->
            <TextView
                android:id="@+id/tv_synergy_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/MoscoText.Luxury.SubHeader"
                android:text="@string/formation_active_synergies_label"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body_sm"
                android:textStyle="bold"
                android:fontWeight="700" />

            <!-- Toggle Button (+/-) -->
            <ImageButton
                android:id="@+id/btn_synergy_toggle"
                android:layout_width="@dimen/profile_preview_badge_size"
                android:layout_height="@dimen/profile_preview_badge_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_up"
                android:contentDescription="Toggle synergy panel"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Synergy List (hiện khi mở) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_active_synergies"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_md"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_synergy_badge" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
