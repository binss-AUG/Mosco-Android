<?xml version="1.0" encoding="utf-8"?>
<!-- Item cho RecyclerView chọn bạn bè khi gửi tặng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_friend_select_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_header_glass_v2"
    android:paddingHorizontal="@dimen/spacing_14dp"
    android:paddingVertical="@dimen/radius_lg"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:cardCornerRadius="@dimen/spacing_100dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/mosco_card_bg_variant"
        app:strokeColor="@color/mosco_white_20"
        app:strokeWidth="0.8dp">

        <ImageView
            android:id="@+id/iv_friend_select_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Name + Level -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/radius_lg">

        <TextView
            android:id="@+id/tv_friend_select_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_friend_select_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_body_sm" />
    </LinearLayout>

</LinearLayout>


