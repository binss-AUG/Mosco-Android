<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20dp"
    android:paddingTop="@dimen/spacing_40dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/container_liquid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_solid"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/spacing_12dp"
        android:paddingHorizontal="@dimen/spacing_20dp"
        android:elevation="@dimen/spacing_10dp">

        <ImageView
            android:id="@+id/iv_noti_icon"
            android:layout_width="@dimen/spacing_24dp"
            android:layout_height="@dimen/spacing_24dp"
            android:src="@drawable/ic_info"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_noti_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_12dp"
            android:text="@string/common_notification_title"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard" />

    </LinearLayout>
</FrameLayout>
