<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/radius_lg"
    app:cardBackgroundColor="@color/lg_background"
    app:cardCornerRadius="@dimen/spacing_md">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/radius_lg">

        <!-- 1. Close Button (Top Right) -->
        <ImageView
            android:id="@+id/btn_close_detail"
            android:layout_width="@dimen/spacing_xl"
            android:layout_height="@dimen/spacing_xl"
            android:padding="@dimen/spacing_xs"
            android:src="@drawable/ic_close"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 4. Action Buttons Container (Pinned to Bottom) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_action_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Recycle Button -->
            <ImageView
                android:id="@+id/btn_recycle_detail"
                android:layout_width="@dimen/spacing_44dp"
                android:layout_height="@dimen/spacing_44dp"
                android:padding="@dimen/spacing_10dp"
                android:src="@drawable/ic_recycle"
                app:tint="@color/mosco_white_50"
                android:background="@drawable/bg_circle_dark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Level Up Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_level_up_detail"
                style="@style/LiquidGlass_Button_Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/spacing_44dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:text="Level up"
                android:textSize="@dimen/text_size_body_xs"
                app:backgroundTint="@color/mosco_success"
                app:icon="@drawable/ic_level_up"
                app:iconGravity="textStart"
                app:iconSize="30dp"
                app:iconTint="@color/stat_def"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@id/btn_recycle_detail"
                app:layout_constraintEnd_toStartOf="@id/btn_upgrade_detail"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- UPGRADE Glow (Behind Upgrade Button) -->
            <View
                android:id="@+id/view_upgrade_glow"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_button_glow"
                app:layout_constraintStart_toStartOf="@id/btn_upgrade_detail"
                app:layout_constraintEnd_toEndOf="@id/btn_upgrade_detail"
                app:layout_constraintTop_toTopOf="@id/btn_upgrade_detail"
                app:layout_constraintBottom_toBottomOf="@id/btn_upgrade_detail" />

            <!-- UPGRADE Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_upgrade_detail"
                style="@style/LiquidGlass_Button_Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Upgrade"
                android:textSize="@dimen/text_size_body_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintWidth_percent="0.4" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 5. Stats Card (Pinned just above Action Buttons) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_info_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/radius_lg"
            app:cardBackgroundColor="@color/mosco_surface_container_high_80"
            app:cardCornerRadius="@dimen/radius_lg"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toTopOf="@id/ll_action_buttons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="@dimen/spacing_20dp">

                <!-- HP -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="@dimen/spacing_28dp" android:layout_height="@dimen/spacing_28dp" android:src="@drawable/ic_hp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/stat_hp" android:textColor="@color/mosco_white_50" android:textSize="@dimen/text_size_body_sm" style="@style/MoscoText.Luxury.Body" />
                    <TextView android:id="@+id/tv_stat_hp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_6dp" android:text="999" android:textColor="@color/stat_hp" android:textSize="@dimen/text_size_body_md" style="@style/MoscoText.Luxury.SubHeader" android:textStyle="bold" android:fontWeight="700" />
                </LinearLayout>

                <!-- ATK -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="@dimen/spacing_28dp" android:layout_height="@dimen/spacing_28dp" android:src="@drawable/ic_atk" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/stat_atk" android:textColor="@color/mosco_white_50" android:textSize="@dimen/text_size_body_sm" style="@style/MoscoText.Luxury.Body" />
                    <TextView android:id="@+id/tv_stat_atk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_6dp" android:text="999" android:textColor="@color/stat_atk" android:textSize="@dimen/text_size_body_md" style="@style/MoscoText.Luxury.SubHeader" android:textStyle="bold" android:fontWeight="700" />
                </LinearLayout>

                <!-- DEF -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="@dimen/spacing_28dp" android:layout_height="@dimen/spacing_28dp" android:src="@drawable/ic_def" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/stat_def" android:textColor="@color/mosco_white_50" android:textSize="@dimen/text_size_body_sm" style="@style/MoscoText.Luxury.Body" />
                    <TextView android:id="@+id/tv_stat_def" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_6dp" android:text="999" android:textColor="@color/stat_def" android:textSize="@dimen/text_size_body_md" style="@style/MoscoText.Luxury.SubHeader" android:textStyle="bold" android:fontWeight="700" />
                </LinearLayout>

                <!-- Crit Rate -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="@dimen/spacing_28dp" android:layout_height="@dimen/spacing_28dp" android:src="@drawable/ic_crit_rate" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/stat_crit_rate" android:textColor="@color/mosco_white_50" android:textSize="@dimen/text_size_body_sm" style="@style/MoscoText.Luxury.Body" />
                    <TextView android:id="@+id/tv_stat_crit_rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_6dp" android:text="100%" android:textColor="@color/stat_crit_rate" android:textSize="@dimen/text_size_body_md" style="@style/MoscoText.Luxury.SubHeader" android:textStyle="bold" android:fontWeight="700" />
                </LinearLayout>

                <!-- SPEED -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="@dimen/spacing_28dp" android:layout_height="@dimen/spacing_28dp" android:src="@drawable/ic_speed"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/stat_spd" android:textColor="@color/mosco_white_50" android:textSize="@dimen/text_size_body_sm" style="@style/MoscoText.Luxury.Body" />
                    <TextView android:id="@+id/tv_stat_spd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_6dp" android:text="999" android:textColor="@color/white" android:textSize="@dimen/text_size_body_md" style="@style/MoscoText.Luxury.SubHeader" android:textStyle="bold" android:fontWeight="700" />
                </LinearLayout>

                <!-- Crit DMG -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="@dimen/spacing_28dp" android:layout_height="@dimen/spacing_28dp" android:src="@drawable/ic_crit_dame" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/stat_crit_dmg" android:textColor="@color/mosco_white_50" android:textSize="@dimen/text_size_body_sm" style="@style/MoscoText.Luxury.Body" />
                    <TextView android:id="@+id/tv_stat_crit_dmg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_6dp" android:text="200%" android:textColor="@color/lg_accent_primary" android:textSize="@dimen/text_size_body_md" style="@style/MoscoText.Luxury.SubHeader" android:textStyle="bold" android:fontWeight="700" />
                </LinearLayout>

            </GridLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. Level Progress (Pinned just above Stats Card) -->
        <LinearLayout
            android:id="@+id/cl_level_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/radius_lg"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="18dp"
            android:background="@color/transparent"
            app:layout_constraintBottom_toTopOf="@id/cv_info_box"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/tv_level_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Level 1" android:textColor="@color/white" android:textSize="@dimen/text_size_body_sm" style="@style/MoscoText.Luxury.SubHeader" android:textStyle="bold" android:fontWeight="700" />
                <TextView android:id="@+id/tv_level_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9 / 100" android:textColor="@color/mosco_white_50" android:textSize="@dimen/text_size_body_xs" style="@style/MoscoText.Luxury.Body" android:textStyle="bold" android:fontWeight="700" />
            </LinearLayout>

            <ProgressBar android:id="@+id/pb_level" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="@dimen/spacing_lg" android:layout_marginTop="@dimen/spacing_10dp" android:progress="9" android:max="100" android:progressDrawable="@drawable/bg_progress_glow" />
        </LinearLayout>

        <!-- 6.5. Dual Tone Chip -->
        <LinearLayout
            android:id="@+id/ll_dual_tone_chip"
            android:layout_width="280dp"
            android:layout_height="@dimen/spacing_36dp"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:layout_constraintTop_toBottomOf="@id/cv_objet_image_container"
            app:layout_constraintBottom_toTopOf="@id/cl_level_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- VÃ¹ng 30% -->
            <TextView
                android:id="@+id/tv_badge_class"
                android:layout_width="0dp"
                android:layout_weight="0.3"
                android:layout_height="match_parent"
                android:text="First"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_body_sm"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textStyle="bold"
                android:fontWeight="700" />

            <!-- VÃ¹ng 70% -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="0.7"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_objet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_empty"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_size_body_sm"
                    style="@style/MoscoText.Luxury.SubHeader"
                    android:textStyle="bold"
                    android:fontWeight="700" />
            </LinearLayout>
        </LinearLayout>

        <!-- 7. Image Container (Flexible space between Title and Level box) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_objet_image_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/radius_lg"
            android:layout_marginBottom="@dimen/radius_lg"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/transparent"
            app:layout_constraintDimensionRatio="1:1.54"
            app:layout_constraintWidth_percent="0.75"
            app:layout_constraintTop_toBottomOf="@id/btn_close_detail"
            app:layout_constraintBottom_toTopOf="@id/ll_dual_tone_chip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Metallic Background -->
                <View
                    android:id="@+id/view_card_metallic_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                    
                <!-- Transparent Image (Front Face) -->
                <ImageView
                    android:id="@+id/iv_objet_detail_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/item_shop_demo"
                    tools:src="@drawable/item_shop_demo" />

                <!-- Back Face -->
                <ImageView
                    android:id="@+id/iv_objet_detail_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/objet_back_spin"
                    android:visibility="gone" />

                <!-- Shimmer Overlay -->
                <View
                    android:id="@+id/view_card_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- OVR Text on card -->
                <com.vn.jet.mosco.utils.StrokedTextView
                    android:id="@+id/card_tv_ovr"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="start|top"
                    style="@style/MoscoText.Luxury.Card.Title"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:fontWeight="700"
                    android:includeFontPadding="false"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="2sp"
                    app:autoSizeMaxTextSize="40sp"
                    app:autoSizeStepGranularity="1sp"
                    app:layout_constraintWidth_percent="0.25"
                    app:layout_constraintHeight_percent="0.14"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintHorizontal_bias="0.04"
                    app:layout_constraintVertical_bias="0.02"
                    tools:text="102" />

                <!-- Level Badge on card -->
                <ImageView
                    android:id="@+id/card_iv_level"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    app:layout_constraintWidth_percent="0.30"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintVertical_bias="1" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>



