<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#1A1C29"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/dialog_logout_title"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_body_lg"
            android:textStyle="bold"
            android:fontWeight="700" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dialog_logout_msg"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="#A2A2A7"
            android:textSize="@dimen/text_size_body_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:text="@string/dialog_cancel"
                style="@style/MoscoText.Luxury.Button"
                android:paddingHorizontal="16dp"
                android:textAllCaps="false"
                android:textColor="#A2A2A7"
                android:textSize="@dimen/text_size_body_sm" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_logout"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="#8A2BE2"
                android:text="@string/dialog_logout_confirm"
                style="@style/MoscoText.Luxury.Button"
                android:paddingHorizontal="24dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body_sm"
                android:textStyle="bold"
                android:fontWeight="700" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
