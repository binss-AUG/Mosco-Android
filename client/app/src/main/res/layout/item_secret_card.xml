<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#1A1C29"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:strokeWidth="0dp"
    app:strokeColor="#8A2BE2">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Card Back (Default) -->
        <ImageView
            android:id="@+id/iv_card_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/objet_back_spin" />

        <!-- Card Front (Hidden initially) -->
        <ImageView
            android:id="@+id/iv_card_front"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="invisible" />

        <!-- Metallic Shine Streak -->
        <View
            android:id="@+id/view_metallic_shine"
            android:layout_width="60dp"
            android:layout_height="500dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_metallic_shine"
            android:rotation="-35"
            android:visibility="invisible" />

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
