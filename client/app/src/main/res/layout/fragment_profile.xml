<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    tools:context=".fragment.ProfileFragment">

    <LinearLayout
        android:id="@+id/layout_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="12dp"
            android:paddingBottom="@dimen/spacing_sm"
            android:gravity="center_horizontal">

            <!-- Skeleton Shimmer Loading (Hiển thị khi cache trống) -->
            <ViewStub
                android:id="@+id/stub_profile_shimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/layout_profile_shimmer"
                android:inflatedId="@+id/layout_profile_shimmer"
                android:visibility="gone" />

            <!-- 1. Header Area: Profile Area (Trái) & Exhibit Carousel (Phải) -->
            <LinearLayout
                android:id="@+id/layout_profile_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="210dp"
                android:orientation="horizontal"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="4dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Cột bên trái: Profile Info & Actions -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_xxs"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Avatar Frame -->
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/avatar_card"
                            android:layout_width="95dp"
                            android:layout_height="95dp"
                            app:cardCornerRadius="47.5dp"
                            app:cardElevation="@dimen/spacing_xs"
                            app:strokeColor="@color/lg_glass_stroke_strong"
                            app:strokeWidth="2dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/iv_avatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_user"
                                    android:background="@color/lg_background_mid" />

                                <!-- Lớp phủ mờ khi bật Edit Mode -->
                                <View
                                    android:id="@+id/view_avatar_dim"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/mosco_black_50"
                                    android:visibility="gone" />

                                <!-- Icon chỉnh sửa avatar, hiện khi Edit Mode bật -->
                                <ImageView
                                    android:id="@+id/iv_avatar_edit_icon"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_edit_pen"
                                    app:tint="@color/white"
                                    android:visibility="gone" />

                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Level Badge -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@id/avatar_card"
                            android:layout_alignStart="@id/avatar_card"
                            android:layout_marginTop="2dp"
                            android:layout_marginStart="2dp"
                            app:cardBackgroundColor="@color/lg_accent_primary"
                            app:cardCornerRadius="@dimen/radius_md"
                            app:cardElevation="@dimen/spacing_xs"
                            app:strokeColor="@color/white"
                            app:strokeWidth="@dimen/stroke_thin">
                            <TextView
                                android:id="@+id/tv_level"
                                style="@style/MoscoText.Luxury.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_10sp"
                                android:paddingHorizontal="@dimen/spacing_xs"
                                android:paddingVertical="1dp"
                                android:text="@string/placeholder_empty" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Nút cây viết góc phải dưới Avatar -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_edit_mode"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignBottom="@id/avatar_card"
                            android:layout_alignEnd="@id/avatar_card"
                            android:layout_marginBottom="2dp"
                            android:layout_marginEnd="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/lg_accent_primary"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="@dimen/radius_md"
                            app:strokeColor="@color/white"
                            app:strokeWidth="1.5dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_edit_pen"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>

                    </RelativeLayout>

                    <!-- Name (Under Avatar) -->
                    <TextView
                        android:id="@+id/tv_username"
                        style="@style/MoscoText.Luxury.Header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="@string/placeholder_commander"
                        android:textSize="@dimen/text_size_h4"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center" />

                    <!-- Stats: Likes & Friends -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="4dp"
                        android:alpha="0.7">

                        <TextView
                            android:id="@+id/tv_stat_likes"
                            style="@style/MoscoText.Luxury.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_11sp"
                            android:textColor="@color/mosco_white_80"
                            tools:text="1.2K Likes" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" | "
                            style="@style/MoscoText.Luxury.Label"
                            android:textColor="@color/white_20"
                            android:textSize="@dimen/text_11sp"
                            android:layout_marginHorizontal="@dimen/spacing_xxs" />

                        <TextView
                            android:id="@+id/tv_stat_friends"
                            style="@style/MoscoText.Luxury.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_11sp"
                            android:textColor="@color/mosco_white_80"
                            tools:text="450 Friends" />
                    </LinearLayout>

                    <!-- Guest Actions Stub -->
                    <ViewStub
                        android:id="@+id/stub_guest_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout="@layout/layout_guest_actions"
                        android:inflatedId="@+id/layout_guest_actions"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Cột bên phải: Exhibit Carousel -->
                <FrameLayout
                    android:id="@+id/layout_exhibit_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:layout_gravity="center_vertical"
                    android:clipChildren="true"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/spacing_xxs">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vp_showcase"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingHorizontal="24dp" />

                </FrameLayout>

            </LinearLayout>

            <!-- Hệ thống Tab Navigation (Pill style, nhỏ gọn hơn) -->
            <FrameLayout
                android:id="@+id/layout_tab_container"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_profile_tab_container"
                android:padding="@dimen/spacing_xxs">

                <!-- Thumb trượt (Nằm dưới TabLayout) -->
                <View
                    android:id="@+id/tab_sliding_thumb"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_profile_tab_indicator" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tabIndicatorHeight="0dp"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    app:tabRippleColor="@null"
                    app:tabPaddingStart="0dp"
                    app:tabPaddingEnd="0dp"
                    app:tabPaddingTop="0dp"
                    app:tabPaddingBottom="0dp"
                    app:tabMinWidth="0dp"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextColor="@color/white_50"
                    app:tabTextAppearance="@style/MoscoTabTextAppearance" />
            </FrameLayout>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>
    </LinearLayout>

    <!-- Nút Menu 3 gạch (Ghost Menu Entry) -->
    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_hamburger"
        app:tint="@color/white"
        android:padding="@dimen/spacing_xs" />

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="10dp"
        android:layout_marginStart="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back_arrow"
        app:tint="@color/white"
        android:padding="@dimen/spacing_xs" />

    <!-- [PHASE 5] Inline Confirmation UI -->
    <View
        android:id="@+id/view_blocking_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mosco_black_50"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Header Edit Mode / Confirm Avatar -->
    <LinearLayout
        android:id="@+id/layout_preview_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/spacing_xl"
        android:background="@drawable/bg_header_glass"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_sm"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="10dp">

        <ImageButton
            android:id="@+id/btn_preview_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_preview_header_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:text="@string/profile_preview_confirm_label"
            style="@style/MoscoText.Luxury.Header"
            android:textSize="@dimen/text_size_body"
            android:letterSpacing="0.2" />

        <ImageButton
            android:id="@+id/btn_preview_confirm"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check"
            app:tint="@color/mosco_tertiary" />

    </LinearLayout>

</FrameLayout>
