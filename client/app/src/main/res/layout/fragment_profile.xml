<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.ProfileFragment">


    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20dp"
            android:gravity="center_horizontal">

            <!-- 1. Avatar & Profile Header -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_40dp"
                android:layout_marginBottom="@dimen/spacing_lg">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/avatar_card"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    app:cardCornerRadius="70dp"
                    app:cardElevation="@dimen/spacing_10dp"
                    app:strokeColor="@color/mosco_outline"
                    app:strokeWidth="3dp">

                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_user"
                        android:padding="@dimen/spacing_md"
                        android:background="@color/mosco_surface_container" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_edit_avatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignBottom="@id/avatar_card"
                    android:layout_alignEnd="@id/avatar_card"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/mosco_primary"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="@dimen/radius_lg"
                    app:strokeColor="@color/white"
                    app:strokeWidth="@dimen/spacing_2dp">
                    <ImageView
                        android:layout_width="@dimen/spacing_20dp"
                        android:layout_height="@dimen/spacing_20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit_pen"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/avatar_card"
                    android:layout_alignStart="@id/avatar_card"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:layout_marginStart="@dimen/spacing_xs"
                    app:cardBackgroundColor="@color/mosco_primary"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/spacing_10dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="@dimen/stroke_thin">
                    <TextView
                        android:id="@+id/tv_level"
                        style="@style/MoscoText.Luxury.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_2dp"
                        android:text="@string/placeholder_empty" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_username"
                style="@style/MoscoText.Luxury.Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_commander" />

            <TextView
                android:id="@+id/tv_email"
                style="@style/MoscoText.Luxury.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:text="@string/auth_prompt_email" />


        </LinearLayout>
    </ScrollView>

    <!-- Nút Menu 3 gạch (Ghost Menu Entry) -->
    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/spacing_20dp"
        android:layout_marginEnd="@dimen/spacing_20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_hamburger"
        app:tint="@color/white"
        android:padding="@dimen/spacing_xs" />

    <!-- [PHASE 5] Inline Confirmation UI -->
    <View
        android:id="@+id/view_blocking_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/layout_preview_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/spacing_xl"
        android:background="@drawable/bg_header_glass"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_sm"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="10dp">

        <ImageButton
            android:id="@+id/btn_preview_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:text="@string/profile_preview_confirm_label"
            style="@style/MoscoText.Luxury.Header"
            android:textSize="@dimen/text_size_body"
            android:letterSpacing="0.2" />

        <ImageButton
            android:id="@+id/btn_preview_confirm"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check"
            app:tint="@color/mosco_tertiary" />

    </LinearLayout>

</FrameLayout>
