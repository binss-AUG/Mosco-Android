<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    tools:context=".fragment.ProfileFragment">


    <LinearLayout
        android:id="@+id/layout_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20dp"
            android:gravity="center_horizontal">

            <!-- Skeleton Shimmer Loading (Hiển thị khi cache trống) -->
            <ViewStub
                android:id="@+id/stub_profile_shimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/layout_profile_shimmer"
                android:inflatedId="@+id/layout_profile_shimmer"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_profile_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- 1. Avatar & Profile Header -->
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_40dp"
                    android:layout_marginBottom="@dimen/spacing_lg">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/avatar_card"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    app:cardCornerRadius="70dp"
                    app:cardElevation="@dimen/spacing_10dp"
                    app:strokeColor="@color/lg_glass_stroke_strong"
                    app:strokeWidth="2dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/iv_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_user"
                            android:background="@color/lg_background_mid" />

                        <!-- Lớp phủ mờ khi bật Edit Mode -->
                        <View
                            android:id="@+id/view_avatar_dim"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/mosco_black_50"
                            android:visibility="gone" />

                        <!-- Icon chỉnh sửa avatar, hiện khi Edit Mode bật -->
                        <ImageView
                            android:id="@+id/iv_avatar_edit_icon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_edit_pen"
                            app:tint="@color/white"
                            android:visibility="gone" />

                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Level Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/avatar_card"
                    android:layout_alignStart="@id/avatar_card"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:layout_marginStart="@dimen/spacing_xs"
                    app:cardBackgroundColor="@color/lg_accent_primary"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/spacing_10dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="@dimen/stroke_thin">
                    <TextView
                        android:id="@+id/tv_level"
                        style="@style/MoscoText.Luxury.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_2dp"
                        android:text="@string/placeholder_empty" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Nút cây viết góc phải dưới Avatar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_edit_mode"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignBottom="@id/avatar_card"
                    android:layout_alignEnd="@id/avatar_card"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/lg_accent_primary"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="@dimen/radius_lg"
                    app:strokeColor="@color/white"
                    app:strokeWidth="@dimen/spacing_2dp">
                    <ImageView
                        android:layout_width="@dimen/spacing_20dp"
                        android:layout_height="@dimen/spacing_20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit_pen"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <TextView
                    android:id="@+id/tv_username"
                    style="@style/MoscoText.Luxury.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_commander"
                    android:textSize="@dimen/text_size_h3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white_40"
                    android:textSize="@dimen/text_size_h3"
                    android:layout_marginHorizontal="@dimen/spacing_xxs" />

                <TextView
                    android:id="@+id/tv_current_title"
                    style="@style/MoscoText.Luxury.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mosco_white_70"
                    android:textSize="@dimen/text_size_h4"
                    android:textStyle="normal"
                    android:alpha="0.5"
                    tools:text="Tân Binh" />
            </LinearLayout>

            <!-- Profile Stats: Likes & Friends -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_md"
                android:alpha="0.7">

                <TextView
                    android:id="@+id/tv_stat_likes"
                    style="@style/MoscoText.Luxury.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mosco_white_80"
                    tools:text="1.2K Likes" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" | "
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white_20"
                    android:layout_marginHorizontal="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/tv_stat_friends"
                    style="@style/MoscoText.Luxury.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mosco_white_80"
                    tools:text="450 Friends" />
            </LinearLayout>

            <!-- Module Chức năng Khách (Kết bạn, Theo dõi, Nhắn tin) -->
            <ViewStub
                android:id="@+id/stub_guest_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/layout_guest_actions"
                android:inflatedId="@+id/layout_guest_actions"
                android:visibility="gone" />

            </LinearLayout>

            <!-- Hệ thống Tab Navigation (Pill style, bọc trong FrameLayout để tránh Crash khi addView) -->
            <FrameLayout
                android:id="@+id/layout_tab_container"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_xs"
                android:background="@drawable/bg_profile_tab_container"
                android:padding="@dimen/spacing_xxs">

                <!-- Thumb trượt (Nằm dưới TabLayout) -->
                <View
                    android:id="@+id/tab_sliding_thumb"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_profile_tab_indicator" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tabIndicatorHeight="0dp"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    app:tabRippleColor="@null"
                    app:tabPaddingStart="0dp"
                    app:tabPaddingEnd="0dp"
                    app:tabPaddingTop="0dp"
                    app:tabPaddingBottom="0dp"
                    app:tabMinWidth="0dp"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextColor="@color/white_50"
                    app:tabTextAppearance="@style/MoscoTabTextAppearance" />
            </FrameLayout>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>
    </LinearLayout>
    <!-- Nút Menu 3 gạch (Ghost Menu Entry) -->
    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/spacing_20dp"
        android:layout_marginEnd="@dimen/spacing_20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_hamburger"
        app:tint="@color/white"
        android:padding="@dimen/spacing_xs" />

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="@dimen/spacing_20dp"
        android:layout_marginStart="@dimen/spacing_20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back_arrow"
        app:tint="@color/white"
        android:padding="@dimen/spacing_xs" />

    <!-- [PHASE 5] Inline Confirmation UI -->
    <View
        android:id="@+id/view_blocking_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mosco_black_50"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Header Edit Mode / Confirm Avatar -->
    <LinearLayout
        android:id="@+id/layout_preview_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/spacing_xl"
        android:background="@drawable/bg_header_glass"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_sm"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="10dp">

        <ImageButton
            android:id="@+id/btn_preview_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_preview_header_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:text="@string/profile_preview_confirm_label"
            style="@style/MoscoText.Luxury.Header"
            android:textSize="@dimen/text_size_body"
            android:letterSpacing="0.2" />

        <ImageButton
            android:id="@+id/btn_preview_confirm"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check"
            app:tint="@color/mosco_tertiary" />

    </LinearLayout>



</FrameLayout>
