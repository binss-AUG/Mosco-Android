<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_button"
    android:backgroundTint="#2E303D"
    android:paddingTop="12dp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/v_drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="#818293"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Category Tabs (Artist / Season / Class) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_filter_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#2E303D"
        app:tabIndicatorColor="#8A2BE2"
        app:tabSelectedTextColor="@color/white"
        app:tabTextColor="#A2A2A7"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:layout_constraintTop_toBottomOf="@id/v_drag_handle" />

    <!-- Dynamic content area: filled programmatically -->
    <FrameLayout
        android:id="@+id/fl_filter_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tab_filter_categories"
        app:layout_constraintBottom_toTopOf="@id/layout_filter_actions" />

    <!-- Bottom actions -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_filter_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E303D"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Selected chips row -->
        <HorizontalScrollView
            android:id="@+id/hsv_selected_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:layout_marginBottom="12dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/btn_row"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/ll_selected_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <!-- Clear / Apply buttons -->
        <LinearLayout
            android:id="@+id/btn_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_filter_clear"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.8"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="#41455E"
                android:text="Clear"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_filter_apply"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_button"
                android:backgroundTint="#8A2BE2"
                android:text="Apply"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
