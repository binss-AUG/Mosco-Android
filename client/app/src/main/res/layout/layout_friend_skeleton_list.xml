<?xml version="1.0" encoding="utf-8"?>
<!-- Danh sách Skeleton Shimmer dùng chung cho các Tab Bạn bè, Lời mời và Khám phá -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_friend_skeleton"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1200"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm">

        <include layout="@layout/item_friend_skeleton_row" />
        <include layout="@layout/item_friend_skeleton_row" />
        <include layout="@layout/item_friend_skeleton_row" />
        <include layout="@layout/item_friend_skeleton_row" />
        <include layout="@layout/item_friend_skeleton_row" />
        <include layout="@layout/item_friend_skeleton_row" />
        <include layout="@layout/item_friend_skeleton_row" />
        <include layout="@layout/item_friend_skeleton_row" />
    </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
