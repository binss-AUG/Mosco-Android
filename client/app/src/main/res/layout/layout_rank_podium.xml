<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="54dp"
    android:paddingBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- SILVER PILLAR (TOP 2) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_podium_silver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-4dp"
        android:clipChildren="false"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layout_podium_gold"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/fl_avatar_silver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            app:layout_constraintBottom_toTopOf="@+id/tv_name_silver"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/galactic_deep_blue"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp"
                app:strokeColor="@color/podium_unified_stroke"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/iv_avatar_silver"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>


            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_pill_accent"
                android:backgroundTint="@color/rank_silver"
                android:elevation="16dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/rank_num_2"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:translationY="4dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_name_silver"
            style="@style/MoscoText.Luxury.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            tools:text="Unknown"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/block_silver"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/block_silver"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:elevation="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="@drawable/ic_trapezoid_silver" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_podium_silver" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:elevation="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="@+id/block_silver"
            app:layout_constraintStart_toStartOf="@+id/block_silver"
            app:layout_constraintTop_toTopOf="@+id/block_silver">

            <ImageView
                android:id="@+id/iv_type_silver"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_value_silver"
                style="@style/MoscoText.Luxury.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:shadowDy="2" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BRONZE PILLAR (TOP 3) -->
    <!-- Đưa Bronze lên trước Gold để Gold đè lên Bronze -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_podium_bronze"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="-4dp"
        android:clipChildren="false"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layout_podium_gold">

        <FrameLayout
            android:id="@+id/fl_avatar_bronze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            app:layout_constraintBottom_toTopOf="@+id/tv_name_bronze"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/galactic_deep_blue"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp"
                app:strokeColor="@color/podium_unified_stroke"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/iv_avatar_bronze"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>


            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_pill_accent"
                android:backgroundTint="@color/rank_bronze"
                android:elevation="16dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/rank_num_3"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:translationY="4dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_name_bronze"
            style="@style/MoscoText.Luxury.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            tools:text="Unknown"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/block_bronze"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/block_bronze"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:elevation="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="@drawable/ic_trapezoid_bronze" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_podium_bronze" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:elevation="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="@+id/block_bronze"
            app:layout_constraintStart_toStartOf="@+id/block_bronze"
            app:layout_constraintTop_toTopOf="@+id/block_bronze">

            <ImageView
                android:id="@+id/iv_type_bronze"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_value_bronze"
                style="@style/MoscoText.Luxury.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:shadowDy="2" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- GOLD PILLAR (TOP 1) -->
    <!-- Gold đặt cuối để vẽ đè lên bóng của Silver và Bronze -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_podium_gold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layout_podium_bronze"
        app:layout_constraintStart_toEndOf="@+id/layout_podium_silver">

        <FrameLayout
            android:id="@+id/fl_avatar_gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            app:layout_constraintBottom_toTopOf="@+id/tv_name_gold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_margin="10dp"
                app:cardBackgroundColor="@color/galactic_deep_blue"
                app:cardCornerRadius="42dp"
                app:cardElevation="16dp"
                app:strokeColor="@color/podium_unified_stroke"
                app:strokeWidth="3dp">

                <ImageView
                    android:id="@+id/iv_avatar_gold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="4dp"
                android:rotation="25"
                android:elevation="20dp"
                android:src="@drawable/ic_crown"
                app:tint="@color/mosco_gold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_pill_accent"
                android:backgroundTint="@color/mosco_gold"
                android:elevation="20dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/rank_num_1"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:translationY="6dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_name_gold"
            style="@style/MoscoText.Luxury.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            tools:text="Unknown"
            android:textColor="@color/mosco_gold"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/block_gold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/block_gold"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:elevation="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="@drawable/ic_trapezoid_gold" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_podium_gold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:elevation="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="@+id/block_gold"
            app:layout_constraintStart_toStartOf="@+id/block_gold"
            app:layout_constraintTop_toTopOf="@+id/block_gold">

            <ImageView
                android:id="@+id/iv_type_gold"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_value_gold"
                style="@style/MoscoText.Luxury.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="@color/shadow_dark"
                android:shadowRadius="4"
                android:shadowDy="2" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
