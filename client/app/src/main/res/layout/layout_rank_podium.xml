<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="54dp"
    android:paddingBottom="@dimen/spacing_md"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginHorizontal="16dp"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- SILVER PILLAR (TOP 2) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_podium_silver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-4dp"
        android:clipChildren="false"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layout_podium_gold"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/fl_avatar_silver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/radius_lg"
            android:clipChildren="false"
            app:layout_constraintBottom_toTopOf="@+id/tv_name_silver"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_partner_avatar_silver"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="32dp"
                app:cardBackgroundColor="@color/galactic_deep_blue"
                app:cardCornerRadius="32dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/podium_unified_stroke"
                app:strokeWidth="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_partner_avatar_silver"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="@dimen/spacing_sm"
                app:cardBackgroundColor="@color/galactic_deep_blue"
                app:cardCornerRadius="@dimen/spacing_xl"
                app:cardElevation="8dp"
                app:strokeColor="@color/podium_unified_stroke"
                app:strokeWidth="@dimen/spacing_2dp">

                <ImageView
                    android:id="@+id/iv_avatar_silver"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>


            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_pill_accent"
                android:backgroundTint="@color/rank_silver"
                android:elevation="@dimen/spacing_md"
                android:paddingHorizontal="@dimen/spacing_6dp"
                android:paddingVertical="@dimen/spacing_2dp"
                android:text="@string/rank_num_2"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:translationY="@dimen/spacing_xs" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_name_silver"
            style="@style/MoscoText.Luxury.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/radius_lg"
            android:paddingHorizontal="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            tools:text="Unknown"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/block_silver"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:id="@+id/block_silver"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:elevation="@dimen/spacing_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_lg"
                    android:background="@drawable/ic_trapezoid_silver" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_podium_silver">
                    <TextView
                        android:id="@+id/tv_value_silver"
                        style="@style/MoscoText.Luxury.Price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        tools:text="0"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="18sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowRadius="4"
                        android:shadowDx="0"
                        android:shadowDy="0" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BRONZE PILLAR (TOP 3) -->
    <!-- Đưa Bronze lên trước Gold để Gold đè lên Bronze -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_podium_bronze"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="-4dp"
        android:clipChildren="false"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layout_podium_gold">

        <FrameLayout
            android:id="@+id/fl_avatar_bronze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/radius_lg"
            android:clipChildren="false"
            app:layout_constraintBottom_toTopOf="@+id/tv_name_bronze"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_partner_avatar_bronze"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="32dp"
                app:cardBackgroundColor="@color/galactic_deep_blue"
                app:cardCornerRadius="32dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/podium_unified_stroke"
                app:strokeWidth="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_partner_avatar_bronze"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="@dimen/spacing_sm"
                app:cardBackgroundColor="@color/galactic_deep_blue"
                app:cardCornerRadius="@dimen/spacing_xl"
                app:cardElevation="8dp"
                app:strokeColor="@color/podium_unified_stroke"
                app:strokeWidth="@dimen/spacing_2dp">

                <ImageView
                    android:id="@+id/iv_avatar_bronze"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>


            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_pill_accent"
                android:backgroundTint="@color/rank_bronze"
                android:elevation="@dimen/spacing_md"
                android:paddingHorizontal="@dimen/spacing_6dp"
                android:paddingVertical="@dimen/spacing_2dp"
                android:text="@string/rank_num_3"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:translationY="@dimen/spacing_xs" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_name_bronze"
            style="@style/MoscoText.Luxury.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/radius_lg"
            android:paddingHorizontal="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            tools:text="Unknown"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/block_bronze"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:id="@+id/block_bronze"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:elevation="@dimen/spacing_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_lg"
                    android:background="@drawable/ic_trapezoid_bronze" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_podium_bronze">
                    <TextView
                        android:id="@+id/tv_value_bronze"
                        style="@style/MoscoText.Luxury.Price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        tools:text="0"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="10sp"
                        app:autoSizeMaxTextSize="16sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowRadius="4"
                        android:shadowDx="0"
                        android:shadowDy="0" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- GOLD PILLAR (TOP 1) -->
    <!-- Gold đặt cuối để vẽ đè lên bóng của Silver và Bronze -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_podium_gold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layout_podium_bronze"
        app:layout_constraintStart_toEndOf="@+id/layout_podium_silver">

        <FrameLayout
            android:id="@+id/fl_avatar_gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/radius_lg"
            android:clipChildren="false"
            app:layout_constraintBottom_toTopOf="@+id/tv_name_gold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_partner_avatar_gold"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="42dp"
                app:cardBackgroundColor="@color/galactic_deep_blue"
                app:cardCornerRadius="42dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/podium_unified_stroke"
                app:strokeWidth="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_partner_avatar_gold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_avatar_gold"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="@dimen/spacing_10dp"
                app:cardBackgroundColor="@color/galactic_deep_blue"
                app:cardCornerRadius="42dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/podium_unified_stroke"
                app:strokeWidth="3dp">

                <ImageView
                    android:id="@+id/iv_avatar_gold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-4dp"
                android:rotation="30"
                android:elevation="24dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/crown_3d" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_pill_accent"
                android:backgroundTint="@color/mosco_gold"
                android:elevation="@dimen/spacing_20dp"
                android:paddingHorizontal="@dimen/spacing_10dp"
                android:paddingVertical="@dimen/spacing_xs"
                android:text="@string/rank_num_1"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_body_lg"
                android:textStyle="bold"
                android:translationY="@dimen/spacing_6dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_name_gold"
            style="@style/MoscoText.Luxury.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:paddingHorizontal="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            tools:text="Unknown"
            android:textColor="@color/mosco_gold"
            android:textSize="@dimen/text_size_body_lg"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/block_gold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:id="@+id/block_gold"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:elevation="@dimen/radius_lg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_lg"
                    android:background="@drawable/ic_trapezoid_gold" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_podium_gold">
                    <TextView
                        android:id="@+id/tv_value_gold"
                        style="@style/MoscoText.Luxury.Price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        tools:text="0"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="24sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowRadius="4"
                        android:shadowDx="0"
                        android:shadowDy="0" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


