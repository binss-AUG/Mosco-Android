<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Sort Button -->
    <TextView
        android:id="@+id/btn_sort_select"
        style="@style/FilterChipStyle"
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:text="Newest"
        android:gravity="center"
        android:paddingHorizontal="@dimen/inventory_filter_chip_padding_horizontal"
        app:drawableEndCompat="@drawable/ic_arrow_down"
        android:drawablePadding="4dp"
        app:drawableTint="@color/selector_filter_chip_text" />

    <!-- Sort Direction Toggle -->
    <FrameLayout
        android:id="@+id/btn_sort_direction_container"
        style="@style/FilterChipStyle"
        android:layout_width="@dimen/inventory_filter_bar_height"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/inventory_filter_spacing"
        android:padding="0dp">
        <ImageView
            android:id="@+id/iv_sort_direction"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/selector_filter_chip_text" />
    </FrameLayout>

    <!-- Filter Button -->
    <TextView
        android:id="@+id/btn_filter_select"
        style="@style/FilterChipStyle"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/inventory_filter_spacing"
        android:text="Filter"
        android:gravity="center"
        android:paddingHorizontal="@dimen/inventory_filter_chip_padding_horizontal"
        app:drawableStartCompat="@drawable/ic_filter"
        android:drawablePadding="4dp"
        app:drawableTint="@color/selector_filter_chip_text" />

</merge>
