<?xml version="1.0" encoding="utf-8"?>
<!-- 
    fragment_home.xml — Galactic Home Dashboard V2
    Refined showcase proportions, enhanced hologram, and fixed overlays for 2026 Galactic UI.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".fragment.HomeFragment">


    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  HEADER — Premium Glassmorphism User HUD                  -->
    <!--  Row 1: Avatar + Name + Currencies (compact)              -->
    <!--  Row 2: Level badge + OVR badge (clear visual hierarchy)  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  HEADER — Optimized 3x3 Grid User HUD (2026 Edition)      -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_16dp"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:background="@drawable/bg_header_glass_v2"
        android:padding="@dimen/spacing_8dp"
        android:elevation="@dimen/spacing_8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Column 1: Avatar (Spans rows) -->
        <FrameLayout
            android:id="@+id/fl_avatar_group"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintWidth_percent="0.20"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:id="@+id/view_avatar_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:background="@drawable/bg_avatar_glow" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                app:cardCornerRadius="100dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/transparent"
                app:strokeColor="#30FFFFFF"
                app:strokeWidth="0.8dp">

                <ImageView
                    android:id="@+id/iv_home_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Column 2: User Info (Center 60%) -->
        <TextView
            android:id="@+id/tv_home_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8dp"
            android:fontFamily="@font/saira"
            android:textColor="@color/white"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:letterSpacing="0.05"
            app:layout_constraintWidth_percent="0.55"
            app:layout_constraintStart_toEndOf="@id/fl_avatar_group"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/layout_user_id"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Commander Long Name" />

        <LinearLayout
            android:id="@+id/layout_user_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_header_token"
            android:paddingHorizontal="@dimen/home_token_padding_horizontal"
            android:paddingVertical="@dimen/home_token_padding_vertical"
            app:layout_constraintStart_toStartOf="@id/tv_home_username"
            app:layout_constraintTop_toBottomOf="@id/tv_home_username"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:id="@+id/tv_home_user_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@tools:sample/full_names"
                android:fontFamily="@font/saira"
                android:textColor="#BDBDBD"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_copy"
                app:tint="#80BDBDBD"/>
        </LinearLayout>

        <!-- Column 3: Currencies (Right) -->
        <!-- Coin (Row 1/2) -->
        <LinearLayout
            android:id="@+id/ll_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:background="@drawable/bg_header_token"
            android:paddingHorizontal="@dimen/home_token_padding_horizontal"
            android:paddingVertical="@dimen/home_token_padding_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ll_diamonds"
            app:layout_constraintVertical_chainStyle="packed">
            <ImageView
                android:layout_width="@dimen/home_currency_icon_size"
                android:layout_height="@dimen/home_currency_icon_size"
                android:src="@drawable/ic_item_coin" />
            <TextView
                android:id="@+id/tv_home_coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_4dp"
                android:fontFamily="@font/saira"
                android:textColor="@color/white"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                tools:text="1.2M" />
        </LinearLayout>

        <!-- Diamond (Row 2/2) -->
        <LinearLayout
            android:id="@+id/ll_diamonds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4dp"
            android:gravity="center_vertical|end"
            android:background="@drawable/bg_header_token"
            android:paddingHorizontal="@dimen/home_token_padding_horizontal"
            android:paddingVertical="@dimen/home_token_padding_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_coins"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:layout_width="@dimen/home_currency_icon_size"
                android:layout_height="@dimen/home_currency_icon_size"
                android:src="@drawable/ic_item_diamond" />
            <TextView
                android:id="@+id/tv_home_diamonds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_4dp"
                android:fontFamily="@font/saira"
                android:textColor="@color/white"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                tools:text="850" />
        </LinearLayout>

        <!-- Hidden legacy views to avoid NullPointerException in Java logic if needed -->
        <TextView android:id="@+id/tv_home_level" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
        <TextView android:id="@+id/tv_home_ovr" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Event Banner (Moved Up) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_banner_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/home_banner_height"
        android:layout_marginHorizontal="@dimen/home_banner_margin_horizontal"
        android:layout_marginTop="@dimen/home_banner_margin_top"
        app:cardCornerRadius="@dimen/home_banner_corner"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintTop_toBottomOf="@id/cl_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_banner_glass">
            <androidx.viewpager2.widget.ViewPager2 android:id="@+id/vp_banners" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/ll_banner_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cv_banner_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  QUICK TOOL HUD — Horizontal Scroll System (V3)            -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:id="@+id/hsv_quick_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:layout_marginHorizontal="@dimen/spacing_16dp"
        android:background="@drawable/bg_header_glass_v2"
        android:scrollbars="none"
        android:clipToPadding="true"
        android:paddingHorizontal="@dimen/spacing_12dp"
        android:paddingVertical="@dimen/spacing_4dp"
        app:layout_constraintTop_toBottomOf="@id/ll_banner_dots">

        <LinearLayout
            android:id="@+id/ll_quick_tools_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Tool: Daily -->
            <LinearLayout
                android:id="@+id/btn_quick_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_daily_calendar"
                        app:tint="@color/quick_tool_daily" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_daily"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Event -->
            <LinearLayout
                android:id="@+id/btn_quick_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_8dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_hud_mini_fab_size"
                    android:layout_height="@dimen/home_hud_mini_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_event_confetti"
                        app:tint="@color/quick_tool_event" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_event"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Upgrade -->
            <LinearLayout
                android:id="@+id/btn_quick_upgrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_8dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_level_up"
                        app:tint="@color/quick_tool_upgrade" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_upgrade"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Rank -->
            <LinearLayout
                android:id="@+id/btn_quick_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_8dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_rank_leaderboard"
                        app:tint="@color/quick_tool_rank" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_rank"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Shop -->
            <LinearLayout
                android:id="@+id/btn_quick_shop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_8dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_hud_mini_fab_size"
                    android:layout_height="@dimen/home_hud_mini_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shop_bag"
                        app:tint="@color/quick_tool_shop" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_shop"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Friends -->
            <LinearLayout
                android:id="@+id/btn_quick_friends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_8dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_hud_mini_fab_size"
                    android:layout_height="@dimen/home_hud_mini_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_friends"
                        app:tint="@color/quick_tool_friends" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_friends"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Formation -->
            <LinearLayout
                android:id="@+id/btn_quick_formation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_8dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_hud_mini_fab_size"
                    android:layout_height="@dimen/home_hud_mini_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stage"
                        app:tint="@color/mosco_neon_blue" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_formation"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Gift -->
            <LinearLayout
                android:id="@+id/btn_quick_gift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_8dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_gift"
                        app:tint="@color/quick_tool_gift" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_gift"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Guideline to limit card height (fixing "Ảnh to") -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_showcase_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.98" />


    <!-- Luồng sáng máy chiếu -->
    <View
        android:id="@+id/view_projector_beam"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.0"
        app:layout_constraintWidth_percent="0.75"
        app:layout_constraintTop_toTopOf="@id/fl_showcase_container"
        app:layout_constraintBottom_toBottomOf="@id/fl_showcase_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Showcase Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_showcase_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:paddingBottom="@dimen/spacing_16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/hsv_quick_tools"
        app:layout_constraintBottom_toTopOf="@id/guideline_showcase_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- The Showcase Card (Ratio 1:1.54 - Same as Upgrade) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_showcase_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeWidth="0dp"
            app:layout_constraintDimensionRatio="1:1.54"
            app:layout_constraintHeight_percent="0.90"
            app:layout_constrainedWidth="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Unified Card Content (Same proportions as Upgrade Fragment) -->
                <include layout="@layout/layout_core_card" />

                <!-- Back Face (Using objet_back_spin asset) -->
                <ImageView
                    android:id="@+id/iv_showcase_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/objet_back_spin"
                    android:visibility="gone" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/ll_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_showcase_empty_title" android:fontFamily="@font/poppins_bold" android:textColor="@color/mosco_on_surface_variant" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_showcase_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:lottie_rawRes="@raw/loading"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/tv_showcase_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8dp"
                android:text="@string/home_showcase_loading_msg"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                android:textSize="@dimen/text_10sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
