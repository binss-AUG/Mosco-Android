<?xml version="1.0" encoding="utf-8"?>
<!-- 
    fragment_home.xml — Galactic Home Dashboard V3.4
    Now with SwipeRefreshLayout for real-time data sync.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".fragment.HomeFragment">

    <!-- PULL TO REFRESH CONTAINER (SmartRefreshLayout xịn sò) -->
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/swipe_refresh_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_home_chat">

        <!-- Lottie Custom Header -->
        <com.vn.jet.mosco.utils.LottieHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- REAL CONTENT (Hidden while loading) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_real_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

            <!-- NOTIFICATION TICKER — Floating Holographic Flow -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_notification_ticker"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_notification_height"
                android:layout_marginTop="@dimen/home_notification_margin_top"
                android:background="@color/transparent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_16dp">

                    <TextView
                        android:id="@+id/tv_home_notification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/MoscoText.Luxury.Label"
                        android:textSize="@dimen/home_notification_text_size"
                        android:textColor="@color/white_70"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:text="@string/home_notification_default" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Event Banner -->
            <!-- TODO: Add click listener to open web link or event page here in the future -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_banner_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,3.2:1"
                android:layout_marginHorizontal="@dimen/home_banner_margin_horizontal"
                android:layout_marginTop="@dimen/spacing_12dp"
                app:cardCornerRadius="@dimen/home_banner_corner"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/transparent"
                app:layout_constraintTop_toBottomOf="@id/cl_notification_ticker"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_banner_glass">
                    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/vp_banners" android:layout_width="match_parent" android:layout_height="match_parent" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:id="@+id/ll_banner_dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_4dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/cv_banner_container" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

            <!-- COMMAND DASHBOARD GRID -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_home_dashboard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:layout_marginHorizontal="@dimen/home_banner_margin_horizontal"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:minHeight="280dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/ll_banner_dots"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/flow_left_column"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        app:layout_constraintWidth_percent="0.33"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:flow_verticalStyle="spread_inside"
                        app:flow_wrapMode="none"
                        app:constraint_referenced_ids="cv_module_streak,cv_module_daily,cv_module_upgrade" />

                    <!-- DAILY CHECK-IN STREAK CARD (Premium Square Centered Layout) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_module_streak"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="1:1"
                        app:cardCornerRadius="@dimen/lg_radius_card"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_streak_module_glass">

                            <!-- Tiêu đề nhỏ dạng luxury ở GÓC TRÊN TRÁI -->
                            <TextView
                                android:id="@+id/tv_streak_title_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_streak_title"
                                android:textColor="@color/white_40"
                                android:textSize="9sp"
                                android:fontFamily="@font/pretendard"
                                android:letterSpacing="0.15"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp"
                                android:layout_marginTop="12dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/lottie_module_streak"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintWidth_percent="0.45"
                                app:layout_constraintHeight_percent="0.45"
                                app:lottie_rawRes="@raw/streak_animation"
                                app:lottie_loop="true"
                                app:lottie_autoPlay="true"
                                app:layout_constraintTop_toBottomOf="@id/tv_streak_title_header"
                                app:layout_constraintBottom_toTopOf="@id/tv_module_streak_val"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintVertical_chainStyle="packed" />

                            <TextView
                                android:id="@+id/tv_module_streak_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0 DAYS"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:fontFamily="@font/pretendard"
                                android:textStyle="bold"
                                app:layout_constraintTop_toBottomOf="@id/lottie_module_streak"
                                app:layout_constraintBottom_toTopOf="@id/tv_module_streak_hint"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <TextView
                                android:id="@+id/tv_module_streak_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="8dp"
                                android:text="@string/home_streak_action_hint"
                                android:textColor="@color/brand_secondary"
                                android:textSize="8sp"
                                android:fontFamily="@font/pretendard"
                                android:letterSpacing="0.08"
                                android:textStyle="bold"
                                app:layout_constraintTop_toBottomOf="@id/tv_module_streak_val"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                <!-- DAILY CHECK-IN CARD (Square 1:1) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_module_daily"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:cardCornerRadius="@dimen/lg_radius_card"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_streak_module_glass">

                        <TextView
                            android:id="@+id/tv_daily_title_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_daily_header_title"
                            android:textColor="@color/white_40"
                            android:textSize="9sp"
                            android:fontFamily="@font/pretendard"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/iv_module_daily"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintWidth_percent="0.45"
                            app:layout_constraintHeight_percent="0.45"
                            android:src="@drawable/ic_daily_calendar"
                            app:layout_constraintTop_toBottomOf="@id/tv_daily_title_header"
                            app:layout_constraintBottom_toTopOf="@id/tv_module_daily_val"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/tv_module_daily_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_hud_daily"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:fontFamily="@font/pretendard"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/iv_module_daily"
                            app:layout_constraintBottom_toTopOf="@id/tv_module_daily_hint"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/tv_module_daily_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/home_hud_daily_action"
                            android:textColor="@color/brand_secondary"
                            android:textSize="8sp"
                            android:fontFamily="@font/pretendard"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            app:layout_constraintTop_toBottomOf="@id/tv_module_daily_val"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- UPGRADE CARD (Square 1:1) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_module_upgrade"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:cardCornerRadius="@dimen/lg_radius_card"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_streak_module_glass">

                        <TextView
                            android:id="@+id/tv_upgrade_title_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_upgrade_header_title"
                            android:textColor="@color/white_40"
                            android:textSize="9sp"
                            android:fontFamily="@font/pretendard"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/iv_module_upgrade"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintWidth_percent="0.45"
                            app:layout_constraintHeight_percent="0.45"
                            android:src="@drawable/ic_level_up"
                            app:layout_constraintTop_toBottomOf="@id/tv_upgrade_title_header"
                            app:layout_constraintBottom_toTopOf="@id/tv_module_upgrade_val"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/tv_module_upgrade_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_hud_upgrade"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:fontFamily="@font/pretendard"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/iv_module_upgrade"
                            app:layout_constraintBottom_toTopOf="@id/tv_module_upgrade_hint"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/tv_module_upgrade_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/home_hud_upgrade_action"
                            android:textColor="@color/brand_secondary"
                            android:textSize="8sp"
                            android:fontFamily="@font/pretendard"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            app:layout_constraintTop_toBottomOf="@id/tv_module_upgrade_val"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_module_ranking"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/lg_radius_card"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toTopOf="@id/cv_module_streak"
                    app:layout_constraintBottom_toBottomOf="@id/cv_module_upgrade"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flow_left_column">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_streak_module_glass"><androidx.viewpager2.widget.ViewPager2 android:id="@+id/vp_mini_ranking" android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/btn_home_full_rank" /><LinearLayout android:id="@+id/btn_home_full_rank" android:layout_width="match_parent" android:layout_height="@dimen/spacing_40dp" android:background="@color/white_05" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="@dimen/spacing_md" app:layout_constraintBottom_toBottomOf="parent"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/home_action_open_ranking" android:textColor="@color/white_25" android:textSize="@dimen/text_size_caption" android:fontFamily="@font/pretendard" android:textStyle="bold" android:letterSpacing="0.1" /><ImageView android:layout_width="@dimen/spacing_md" android:layout_height="@dimen/spacing_md" android:src="@drawable/ic_back_arrow" android:rotation="180" app:tint="@color/white_25" /></LinearLayout></androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SKELETON LOADING (Visible by default) -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1200"
            app:shimmer_base_alpha="0.3"
            app:shimmer_highlight_alpha="0.8">
            <include layout="@layout/skeleton_home" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    <!--  WORLD CHAT LOG — Floating HUD Area  -->
    <!-- CHAT EXPANDED OVERLAY (Partial overlay with solid background) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_world_chat_expanded"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/mosco_surface_container"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mosco_white_10"
        app:layout_constraintHeight_percent="0.65"
        app:layout_constraintBottom_toTopOf="@id/layout_home_chat">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include 
                android:id="@+id/layout_chat_expanded_header"
                layout="@layout/layout_common_header"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Close Button (X) placed in Right Slot or overlaid -->
            <ImageView
                android:id="@+id/btn_close_chat_x"
                android:layout_width="@dimen/spacing_40dp"
                android:layout_height="@dimen/spacing_40dp"
                android:src="@drawable/ic_close"
                android:padding="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white_40"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_world_chat_expanded"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingVertical="@dimen/spacing_sm"
                app:layout_constraintTop_toBottomOf="@id/layout_chat_expanded_header"
                app:layout_constraintBottom_toBottomOf="parent" />
                
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_home_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_12dp"
        android:layout_marginBottom="@dimen/lg_content_bottom_clearance"
        android:background="@drawable/bg_glass_input"
        android:paddingHorizontal="@dimen/spacing_12dp"
        android:paddingVertical="@dimen/spacing_8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_chat_avatar"
            android:layout_width="@dimen/home_chat_avatar_size"
            android:layout_height="@dimen/home_chat_avatar_size"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            android:src="@drawable/ic_user"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <EditText
            android:id="@+id/et_home_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:background="@android:color/transparent"
            android:hint="@string/chat_hint_input"
            android:textColor="@color/white"
            android:textColorHint="@color/white_25"
            android:textSize="@dimen/text_size_body_md"
            android:inputType="textShortMessage|textNoSuggestions"
            android:maxLines="3"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_home_send"
            app:layout_constraintStart_toEndOf="@id/iv_chat_avatar"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TICKER TEXT (Visible when idle) -->
        <TextView
            android:id="@+id/tv_chat_ticker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:textColor="@color/white_70"
            android:textSize="@dimen/text_size_body_sm"
            android:hint="@string/chat_hint_input"
            android:textColorHint="@color/white_25"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_home_send"
            app:layout_constraintStart_toEndOf="@id/iv_chat_avatar"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_home_send"
            android:layout_width="@dimen/home_chat_send_icon_size"
            android:layout_height="@dimen/home_chat_send_icon_size"
            android:src="@drawable/ic_send"
            app:tint="@color/lg_accent_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

