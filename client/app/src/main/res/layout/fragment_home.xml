<?xml version="1.0" encoding="utf-8"?>
<!-- 
    fragment_home.xml — Galactic Home Dashboard V2
    Refined showcase proportions, enhanced hologram, and fixed overlays for 2026 Galactic UI.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".fragment.HomeFragment">


    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  HEADER — Premium Glassmorphism User HUD                  -->
    <!--  Row 1: Avatar + Name + Currencies (compact)              -->
    <!--  Row 2: Level badge + OVR badge (clear visual hierarchy)  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="@dimen/home_header_padding_top"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Premium Glass HUD V2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_glass_v2"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:elevation="8dp">

            <!-- ROW 1: Avatar + Name + Currencies -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Avatar Section: Clicking navigates to Profile -->
                <FrameLayout
                    android:id="@+id/fl_avatar_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Neon Pulse Ring: Bo tròn tuyệt đối và mờ ảo (Glow) -->
                    <View
                        android:id="@+id/view_avatar_glow"
                        android:layout_width="@dimen/home_avatar_glow_prominent"
                        android:layout_height="@dimen/home_avatar_glow_prominent"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_avatar_glow" />

                    <!-- Avatar Container: Cắt sát cạnh (Pure Circle) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_avatar"
                        android:layout_width="@dimen/home_avatar_size_prominent"
                        android:layout_height="@dimen/home_avatar_size_prominent"
                        android:layout_gravity="center"
                        app:cardCornerRadius="100dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardPreventCornerOverlap="false"
                        app:cardUseCompatPadding="false"
                        app:strokeColor="#30FFFFFF"
                        app:strokeWidth="0.8dp">

                        <ImageView
                            android:id="@+id/iv_home_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:src="@drawable/ic_user"
                            android:contentDescription="Avatar" />
                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

                <!-- User Info Profile: Căn giữa dọc tuyệt đối với Avatar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_home_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/saira"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:letterSpacing="0.05"
                        tools:text="Commander Extreme Long Name" />

                    <!-- Level Badge: Xếp dưới tên -->
                    <LinearLayout
                        android:id="@+id/badge_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_header_token"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp">
                        <TextView
                            android:id="@+id/tv_home_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/saira"
                            android:textColor="#BDBDBD"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03"
                            tools:text="LV. 5" />
                    </LinearLayout>

                    <!-- OVR Badge: Xếp dưới level -->
                    <LinearLayout
                        android:id="@+id/badge_ovr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_header_token"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp">
                        <TextView
                            android:id="@+id/tv_home_ovr_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OVR"
                            android:fontFamily="@font/saira"
                            android:textColor="#8000E5FF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03" />
                        <TextView
                            android:id="@+id/tv_home_ovr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/saira"
                            android:textColor="@color/item_diamond"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="111" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Currency Cluster (Stacked pills) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- Coins -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_header_token"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp">
                        <ImageView
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:src="@drawable/ic_item_coin" />
                        <TextView
                            android:id="@+id/tv_home_coins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/saira"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02"
                            tools:text="1,260,000" />
                    </LinearLayout>

                    <!-- Diamonds: Hiển thị số dư kim cương -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_header_token"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp">
                        <ImageView
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:src="@drawable/ic_item_diamond" />
                        <TextView
                            android:id="@+id/tv_home_diamonds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/saira"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02"
                            tools:text="850" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider — subtle neon line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="#15FFFFFF" />

            <!-- ROW 2: Optimized utilities section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- USER ID Section -->
                <LinearLayout
                    android:id="@+id/layout_user_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_header_token"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tv_home_user_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: 10000000"
                        android:fontFamily="@font/saira"
                        android:textColor="#BDBDBD"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_copy"
                        android:contentDescription="Copy ID"
                        app:tint="#9E9E9E" />
                </LinearLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Card Count Badge (Folder style) -->
                <LinearLayout
                    android:id="@+id/btn_home_inventory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_header_token"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">
                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:src="@drawable/ic_objets"
                            app:tint="#9E9E9E" />
                        <TextView
                            android:id="@+id/tv_home_card_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="#BDBDBD"
                            android:textSize="9sp"
                            tools:text="12" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Event Banner -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_banner_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/home_banner_height"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintTop_toBottomOf="@id/ll_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_banner_glass">
            <androidx.viewpager2.widget.ViewPager2 android:id="@+id/vp_banners" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/ll_banner_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cv_banner_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guideline to limit card height (fixing "Ảnh to") -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_showcase_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.94" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  MOVABLE FAB HUD — Expandable Quick Tool System           -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <FrameLayout
        android:id="@+id/fl_hud_menu_container"
        android:layout_width="260dp"
        android:layout_height="280dp"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@drawable/bg_hud_menu_glass"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="@id/fl_hud_main_fab"
        app:layout_constraintEnd_toEndOf="@id/fl_hud_main_fab"
        app:layout_constraintStart_toStartOf="@id/fl_hud_main_fab"
        app:layout_constraintTop_toTopOf="@id/fl_hud_main_fab">

        <!-- Solid Constraint Layout replacing buggy Grid for precise tool alignment -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Tool: Daily -->
            <LinearLayout
                android:id="@+id/btn_quick_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_quick_event"
                app:layout_constraintBottom_toTopOf="@id/btn_quick_rank"
                app:layout_constraintHorizontal_chainStyle="spread">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_daily_calendar"
                        app:tint="@color/quick_tool_daily" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_daily"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Tool: Event -->
            <LinearLayout
                android:id="@+id/btn_quick_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="@id/btn_quick_daily"
                app:layout_constraintStart_toEndOf="@id/btn_quick_daily"
                app:layout_constraintEnd_toStartOf="@id/btn_quick_upgrade">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_event_confetti"
                        app:tint="@color/quick_tool_event" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_event"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Tool: Upgrade -->
            <LinearLayout
                android:id="@+id/btn_quick_upgrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="@id/btn_quick_daily"
                app:layout_constraintStart_toEndOf="@id/btn_quick_event"
                app:layout_constraintEnd_toEndOf="parent">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_level_up"
                        app:tint="@color/quick_tool_upgrade" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_upgrade"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Tool: Rank -->
            <LinearLayout
                android:id="@+id/btn_quick_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/btn_quick_daily"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_quick_shop"
                app:layout_constraintBottom_toTopOf="@id/btn_quick_formation">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_rank_leaderboard"
                        app:tint="@color/quick_tool_rank" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_rank"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Tool: Shop -->
            <LinearLayout
                android:id="@+id/btn_quick_shop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="@id/btn_quick_rank"
                app:layout_constraintStart_toEndOf="@id/btn_quick_rank"
                app:layout_constraintEnd_toStartOf="@id/btn_quick_friends">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shop_bag"
                        app:tint="@color/quick_tool_shop" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_shop"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Tool: Friends -->
            <LinearLayout
                android:id="@+id/btn_quick_friends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="@id/btn_quick_rank"
                app:layout_constraintStart_toEndOf="@id/btn_quick_shop"
                app:layout_constraintEnd_toEndOf="parent">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_friends"
                        app:tint="@color/quick_tool_friends" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_friends"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Tool: Formation (Team) -->
            <LinearLayout
                android:id="@+id/btn_quick_formation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/btn_quick_rank"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_quick_gift"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stage"
                        app:tint="@color/mosco_neon_blue" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_formation"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Tool: Gift -->
            <LinearLayout
                android:id="@+id/btn_quick_gift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="@id/btn_quick_formation"
                app:layout_constraintStart_toEndOf="@id/btn_quick_formation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_gift"
                        app:tint="@color/quick_tool_gift" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_gift"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Main Movable FAB with Red Dot -->
    <FrameLayout
        android:id="@+id/fl_hud_main_fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer Glow Ring (Pulse) -->
        <View
            android:id="@+id/view_hud_fab_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hud_fab"
            android:alpha="0.4" />

        <!-- FAB Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/mosco_surface_container"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/mosco_outline_variant">
            <ImageView
                android:id="@+id/iv_hud_main_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_quick_action"
                app:tint="@color/item_diamond" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Red Notification Dot -->
        <View
            android:id="@+id/view_hud_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_circle_dark"
            android:backgroundTint="@color/stat_atk"
            android:elevation="10dp" />
    </FrameLayout>

    <!-- Luồng sáng máy chiếu -->
    <View
        android:id="@+id/view_projector_beam"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.0"
        app:layout_constraintWidth_percent="0.75"
        app:layout_constraintTop_toTopOf="@id/fl_showcase_container"
        app:layout_constraintBottom_toBottomOf="@id/fl_showcase_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Showcase Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_showcase_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/ll_banner_dots"
        app:layout_constraintBottom_toTopOf="@id/guideline_showcase_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- The Showcase Card (Ratio 1:1.54 - Same as Upgrade) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_showcase_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeWidth="0dp"
            app:layout_constraintDimensionRatio="1:1.54"
            app:layout_constraintWidth_percent="0.60"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Unified Card Content (Same proportions as Upgrade Fragment) -->
                <include layout="@layout/layout_core_card" />

                <!-- Back Face (Using objet_back_spin asset) -->
                <ImageView
                    android:id="@+id/iv_showcase_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/objet_back_spin"
                    android:visibility="gone" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/ll_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No Objets Yet" android:fontFamily="@font/poppins_bold" android:textColor="@color/mosco_on_surface_variant" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_showcase_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:lottie_rawRes="@raw/loading"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/tv_showcase_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Đang tải Showcase..."
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
