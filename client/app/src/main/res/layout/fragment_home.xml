<?xml version="1.0" encoding="utf-8"?>
<!-- 
    fragment_home.xml — Galactic Home Dashboard V3.4
    Now with SwipeRefreshLayout for real-time data sync.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_space"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".fragment.HomeFragment">

    <!-- PULL TO REFRESH CONTAINER (SmartRefreshLayout xịn sò) -->
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/swipe_refresh_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_home_chat">

        <!-- Lottie Custom Header -->
        <com.vn.jet.mosco.utils.LottieHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- HEADER — Premium HUD Pill (Fused Asymmetric Design) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_header"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_header_pill_height"
                android:layout_marginHorizontal="@dimen/spacing_12dp"
                android:layout_marginTop="@dimen/spacing_12dp"
                android:background="@drawable/bg_header_asymmetric_glass"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Avatar Head (Positioned at the circular left end) -->
                <FrameLayout
                    android:id="@+id/fl_avatar_group"
                    android:layout_width="@dimen/home_header_pill_height"
                    android:layout_height="@dimen/home_header_pill_height"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_home_avatar"
                        android:layout_width="@dimen/home_header_avatar_size_hud"
                        android:layout_height="@dimen/home_header_avatar_size_hud"
                        android:layout_gravity="center"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="@color/white_25"
                        app:strokeWidth="@dimen/home_avatar_stroke_hud"
                        android:src="@drawable/ic_user" />
                </FrameLayout>

                <!-- Right Side HUD Content (Seamlessly integrated) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_md"
                    app:layout_constraintStart_toEndOf="@id/fl_avatar_group"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- Top Row: Name & Level -->
                    <TextView
                        android:id="@+id/tv_home_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_default_username"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_14sp"
                        android:fontFamily="@font/pretendard"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_home_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_default_level"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_12sp"
                        android:fontFamily="@font/pretendard"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Middle Row: XP Bar -->
                    <ProgressBar
                        android:id="@+id/pb_home_xp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_xp_bar_height"
                        android:layout_marginTop="@dimen/spacing_4dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_xp_progress"
                        app:layout_constraintTop_toBottomOf="@id/tv_home_username" />

                    <!-- Bottom Row: XP text & Currencies -->
                    <TextView
                        android:id="@+id/tv_home_xp_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4dp"
                        android:text="@string/home_default_xp"
                        android:textColor="@color/white_60"
                        android:textSize="@dimen/text_10sp"
                        android:fontFamily="@font/pretendard"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/pb_home_xp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_home_xp_val"
                        app:layout_constraintBottom_toBottomOf="@id/tv_home_xp_val">
                        <ImageView android:layout_width="@dimen/home_currency_icon_size_hud" android:layout_height="@dimen/home_currency_icon_size_hud" android:src="@drawable/ic_item_diamond" />
                        <TextView android:id="@+id/tv_home_diamonds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_4dp" android:text="@string/home_default_currency" android:textColor="@color/white" android:textSize="@dimen/text_11sp" android:fontFamily="@font/pretendard" android:textStyle="bold" />
                        <ImageView android:layout_width="@dimen/home_currency_icon_size_hud" android:layout_height="@dimen/home_currency_icon_size_hud" android:layout_marginStart="@dimen/spacing_12dp" android:src="@drawable/ic_item_coin" />
                        <TextView android:id="@+id/tv_home_coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_4dp" android:text="@string/home_default_currency" android:textColor="@color/white" android:textSize="@dimen/text_11sp" android:fontFamily="@font/pretendard" android:textStyle="bold" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView android:id="@+id/tv_home_user_id" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- NOTIFICATION TICKER — Floating Holographic Flow -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_notification_ticker"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_notification_height"
                android:layout_marginTop="@dimen/home_notification_margin_top"
                android:background="@color/transparent"
                app:layout_constraintTop_toBottomOf="@id/cl_header">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_16dp">

                    <TextView
                        android:id="@+id/tv_home_notification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/MoscoText.Luxury.Label"
                        android:textSize="@dimen/home_notification_text_size"
                        android:textColor="@color/white_70"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:text="@string/home_notification_ticker" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Event Banner -->
            <!-- TODO: Add click listener to open web link or event page here in the future -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_banner_container"
                android:layout_width="0dp"
                android:layout_height="@dimen/home_banner_height"
                android:layout_marginHorizontal="@dimen/home_banner_margin_horizontal"
                android:layout_marginTop="@dimen/spacing_12dp"
                app:cardCornerRadius="@dimen/home_banner_corner"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/transparent"
                app:layout_constraintTop_toBottomOf="@id/cl_notification_ticker"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_banner_glass">
                    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/vp_banners" android:layout_width="match_parent" android:layout_height="match_parent" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:id="@+id/ll_banner_dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_4dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/cv_banner_container" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

            <!-- QUICK TOOL HUD -->
            <HorizontalScrollView
                android:id="@+id/hsv_quick_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8dp"
                android:layout_marginHorizontal="@dimen/spacing_16dp"
                android:scrollbars="none"
                android:paddingHorizontal="@dimen/spacing_12dp"
                android:paddingVertical="@dimen/spacing_4dp"
                app:layout_constraintTop_toBottomOf="@id/ll_banner_dots">
                <LinearLayout android:id="@+id/ll_quick_tools_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:id="@+id/btn_quick_daily" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/home_quick_tool_spacing" android:clickable="true" android:focusable="true"><FrameLayout android:layout_width="@dimen/home_quick_tool_fab_size" android:layout_height="@dimen/home_quick_tool_fab_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_base" /><View android:id="@+id/v_bubble_daily" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_iridescent" /><ImageView android:id="@+id/iv_quick_daily" android:layout_width="@dimen/home_quick_tool_icon_size" android:layout_height="@dimen/home_quick_tool_icon_size" android:layout_gravity="center" android:src="@drawable/ic_daily_calendar" /></FrameLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_hud_daily" style="@style/MoscoText.Luxury.Label" android:textColor="@color/white" android:textSize="@dimen/home_quick_tool_text_size" android:fontWeight="700" android:layout_marginTop="@dimen/spacing_4dp"/></LinearLayout>
                    <LinearLayout android:id="@+id/btn_quick_event" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/home_quick_tool_spacing" android:clickable="true" android:focusable="true"><FrameLayout android:layout_width="@dimen/home_quick_tool_fab_size" android:layout_height="@dimen/home_quick_tool_fab_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_base" /><View android:id="@+id/v_bubble_event" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_iridescent" /><ImageView android:id="@+id/iv_quick_event" android:layout_width="@dimen/home_quick_tool_icon_size" android:layout_height="@dimen/home_quick_tool_icon_size" android:layout_gravity="center" android:src="@drawable/ic_event_confetti" /></FrameLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_hud_event" style="@style/MoscoText.Luxury.Label" android:textColor="@color/white" android:textSize="@dimen/home_quick_tool_text_size" android:fontWeight="700" android:layout_marginTop="@dimen/spacing_4dp"/></LinearLayout>
                    <LinearLayout android:id="@+id/btn_quick_upgrade" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/home_quick_tool_spacing" android:clickable="true" android:focusable="true"><FrameLayout android:layout_width="@dimen/home_quick_tool_fab_size" android:layout_height="@dimen/home_quick_tool_fab_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_base" /><View android:id="@+id/v_bubble_upgrade" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_iridescent" /><ImageView android:id="@+id/iv_quick_upgrade" android:layout_width="@dimen/home_quick_tool_icon_size" android:layout_height="@dimen/home_quick_tool_icon_size" android:layout_gravity="center" android:src="@drawable/ic_level_up" /></FrameLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_hud_upgrade" style="@style/MoscoText.Luxury.Label" android:textColor="@color/white" android:textSize="@dimen/home_quick_tool_text_size" android:fontWeight="700" android:layout_marginTop="@dimen/spacing_4dp"/></LinearLayout>
                    <LinearLayout android:id="@+id/btn_quick_rank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/home_quick_tool_spacing" android:clickable="true" android:focusable="true"><FrameLayout android:layout_width="@dimen/home_quick_tool_fab_size" android:layout_height="@dimen/home_quick_tool_fab_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_base" /><View android:id="@+id/v_bubble_rank" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_iridescent" /><ImageView android:id="@+id/iv_quick_rank" android:layout_width="@dimen/home_quick_tool_icon_size" android:layout_height="@dimen/home_quick_tool_icon_size" android:layout_gravity="center" android:src="@drawable/ic_rank_leaderboard" /></FrameLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_hud_rank" style="@style/MoscoText.Luxury.Label" android:textColor="@color/white" android:textSize="@dimen/home_quick_tool_text_size" android:fontWeight="700" android:layout_marginTop="@dimen/spacing_4dp"/></LinearLayout>
                    <LinearLayout android:id="@+id/btn_quick_shop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/home_quick_tool_spacing" android:clickable="true" android:focusable="true"><FrameLayout android:layout_width="@dimen/home_quick_tool_fab_size" android:layout_height="@dimen/home_quick_tool_fab_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_base" /><View android:id="@+id/v_bubble_shop" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_iridescent" /><ImageView android:id="@+id/iv_quick_shop" android:layout_width="@dimen/home_quick_tool_icon_size" android:layout_height="@dimen/home_quick_tool_icon_size" android:layout_gravity="center" android:src="@drawable/ic_shop_bag" /></FrameLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_hud_shop" style="@style/MoscoText.Luxury.Label" android:textColor="@color/white" android:textSize="@dimen/home_quick_tool_text_size" android:fontWeight="700" android:layout_marginTop="@dimen/spacing_4dp"/></LinearLayout>
                    <LinearLayout android:id="@+id/btn_quick_friends" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/home_quick_tool_spacing" android:clickable="true" android:focusable="true"><FrameLayout android:layout_width="@dimen/home_quick_tool_fab_size" android:layout_height="@dimen/home_quick_tool_fab_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_base" /><View android:id="@+id/v_bubble_friends" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_iridescent" /><ImageView android:id="@+id/iv_quick_friends" android:layout_width="@dimen/home_quick_tool_icon_size" android:layout_height="@dimen/home_quick_tool_icon_size" android:layout_gravity="center" android:src="@drawable/ic_friends" /></FrameLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_hud_friends" style="@style/MoscoText.Luxury.Label" android:textColor="@color/white" android:textSize="@dimen/home_quick_tool_text_size" android:fontWeight="700" android:layout_marginTop="@dimen/spacing_4dp"/></LinearLayout>
                    <LinearLayout android:id="@+id/btn_quick_formation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/home_quick_tool_spacing" android:clickable="true" android:focusable="true"><FrameLayout android:layout_width="@dimen/home_quick_tool_fab_size" android:layout_height="@dimen/home_quick_tool_fab_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_base" /><View android:id="@+id/v_bubble_formation" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_iridescent" /><ImageView android:id="@+id/iv_quick_formation" android:layout_width="@dimen/home_quick_tool_icon_size" android:layout_height="@dimen/home_quick_tool_icon_size" android:layout_gravity="center" android:src="@drawable/ic_stage" /></FrameLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_hud_formation" style="@style/MoscoText.Luxury.Label" android:textColor="@color/white" android:textSize="@dimen/home_quick_tool_text_size" android:fontWeight="700" android:layout_marginTop="@dimen/spacing_4dp"/></LinearLayout>
                    <LinearLayout android:id="@+id/btn_quick_gift" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/home_quick_tool_spacing" android:clickable="true" android:focusable="true"><FrameLayout android:layout_width="@dimen/home_quick_tool_fab_size" android:layout_height="@dimen/home_quick_tool_fab_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_base" /><View android:id="@+id/v_bubble_gift" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quick_tool_bubble_iridescent" /><ImageView android:id="@+id/iv_quick_gift" android:layout_width="@dimen/home_quick_tool_icon_size" android:layout_height="@dimen/home_quick_tool_icon_size" android:layout_gravity="center" android:src="@drawable/ic_gift" /></FrameLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_hud_gift" style="@style/MoscoText.Luxury.Label" android:textColor="@color/white" android:textSize="@dimen/home_quick_tool_text_size" android:fontWeight="700" android:layout_marginTop="@dimen/spacing_4dp"/></LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- COMMAND DASHBOARD GRID -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_home_dashboard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginHorizontal="@dimen/home_banner_margin_horizontal"
                    android:layout_marginBottom="24dp"
                    android:minHeight="280dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/hsv_quick_tools"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/flow_left_column"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        app:flow_verticalGap="@dimen/spacing_md"
                        app:layout_constraintWidth_percent="0.38"
                        app:layout_constraintStart_toStartOf="parent"
                        app:flow_wrapMode="none"
                        app:constraint_referenced_ids="cv_module_streak,cv_module_empty" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_module_streak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/radius_m"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:background="@drawable/bg_streak_module_glass">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:clipChildren="false"
                                android:padding="@dimen/spacing_sm">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_module_streaks"
                                    android:textColor="@color/white_20"
                                    android:textSize="10sp"
                                    android:fontFamily="@font/pretendard"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.2"
                                    android:layout_marginBottom="@dimen/spacing_sm" />
                                <FrameLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clipChildren="false"
                                    android:clipToPadding="false">
                                    <com.airbnb.lottie.LottieAnimationView
                                        android:id="@+id/lottie_module_streak_glow"
                                        android:layout_width="100dp"
                                        android:layout_height="100dp"
                                        android:layout_gravity="center"
                                        android:alpha="0.12"
                                        android:scaleX="1.4"
                                        android:scaleY="1.4"
                                        android:translationY="0dp"
                                        app:lottie_rawRes="@raw/streak_animation"
                                        app:lottie_autoPlay="true"
                                        app:lottie_loop="true" />
                                    <com.airbnb.lottie.LottieAnimationView
                                        android:id="@+id/lottie_module_streak"
                                        android:layout_width="80dp"
                                        android:layout_height="80dp"
                                        android:layout_gravity="center"
                                        app:lottie_rawRes="@raw/streak_animation"
                                        app:lottie_autoPlay="true"
                                        app:lottie_loop="true" />
                                </FrameLayout>
                                <TextView
                                    android:id="@+id/tv_module_streak_val"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_default_streak"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/home_streak_value_text_size"
                                    android:fontFamily="@font/pretendard"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cv_module_empty" android:layout_width="0dp" android:layout_height="0dp" app:cardCornerRadius="@dimen/radius_m" app:cardElevation="0dp" app:cardBackgroundColor="@color/white_05" app:strokeWidth="1dp" app:strokeColor="@color/white_10"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/home_module_station_pending" android:gravity="center" android:textColor="@color/white_20" android:textSize="10sp" android:fontFamily="@font/pretendard" /></com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_module_ranking"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/radius_m"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white_05"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/white_10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/flow_left_column"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent"><androidx.viewpager2.widget.ViewPager2 android:id="@+id/vp_mini_ranking" android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/btn_home_full_rank" /><LinearLayout android:id="@+id/btn_home_full_rank" android:layout_width="match_parent" android:layout_height="40dp" android:background="@color/white_05" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="@dimen/spacing_md" app:layout_constraintBottom_toBottomOf="parent"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/home_module_open_ranking" android:textColor="@color/white_25" android:textSize="10sp" android:fontFamily="@font/pretendard" android:textStyle="bold" android:letterSpacing="0.1" /><ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_back_arrow" android:rotation="180" app:tint="@color/white_25" /></LinearLayout></androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    <!--  STICKY CHAT BAR — Floating Glass Input  -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_home_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_12dp"
        android:layout_marginBottom="@dimen/spacing_12dp"
        android:background="@drawable/bg_banner_glass"
        android:paddingHorizontal="@dimen/spacing_12dp"
        android:paddingVertical="@dimen/spacing_8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_chat_avatar"
            android:layout_width="@dimen/home_chat_avatar_size"
            android:layout_height="@dimen/home_chat_avatar_size"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            android:src="@drawable/ic_user"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <EditText
            android:id="@+id/et_home_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8dp"
            android:layout_marginEnd="@dimen/spacing_8dp"
            android:background="@android:color/transparent"
            android:hint="@string/home_chat_input_hint"
            android:textColor="@color/white"
            android:textColorHint="@color/white_25"
            android:textSize="@dimen/home_chat_text_size"
            android:maxLines="1"
            android:imeOptions="actionSend"
            android:inputType="textShortMessage"
            app:layout_constraintStart_toEndOf="@id/iv_chat_avatar"
            app:layout_constraintEnd_toStartOf="@+id/btn_home_send"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/btn_home_send"
            android:layout_width="@dimen/home_chat_send_icon_size"
            android:layout_height="@dimen/home_chat_send_icon_size"
            android:src="@drawable/ic_send"
            app:tint="@color/galactic_accent_cyan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
