<?xml version="1.0" encoding="utf-8"?>
<!-- 
    fragment_home.xml — Galactic Home Dashboard V2
    Refined showcase proportions, enhanced hologram, and fixed overlays for 2026 Galactic UI.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_space"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".fragment.HomeFragment">

    <!-- Container cho hiệu ứng hạt Space Dust (Hành trình xuyên không) -->
    <FrameLayout
        android:id="@+id/fl_particle_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Hành tinh khổng lồ (Góc trên phải) -->
    <ImageView
        android:id="@+id/iv_home_planet"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-250dp"
        android:alpha="0.5"
        android:src="@drawable/ic_planet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Thiên thạch trôi nổi 1 (Gần, rõ) -->
    <ImageView
        android:id="@+id/iv_home_asteroid_1"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:alpha="0.4"
        android:src="@drawable/ic_asteroid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="300dp"
        android:layout_marginStart="-200dp" />

    <!-- Thiên thạch trôi nổi 2 (Xa, mờ) -->
    <ImageView
        android:id="@+id/iv_home_asteroid_2"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:alpha="0.2"
        android:src="@drawable/ic_asteroid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="150dp"
        android:layout_marginStart="-120dp" />


    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  HEADER — Premium Glassmorphism User HUD                  -->
    <!--  Row 1: Avatar + Name + Currencies (compact)              -->
    <!--  Row 2: Level badge + OVR badge (clear visual hierarchy)  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  HEADER — Optimized 3x3 Grid User HUD (2026 Edition)      -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_12dp"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:background="@color/transparent"
        android:paddingHorizontal="@dimen/spacing_12dp"
        android:paddingVertical="@dimen/spacing_8dp"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Column 1: Avatar -->
        <FrameLayout
            android:id="@+id/fl_avatar_group"
            android:layout_width="@dimen/home_header_avatar_outer"
            android:layout_height="@dimen/home_header_avatar_outer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:id="@+id/view_avatar_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_glow"
                android:visibility="gone" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_home_avatar"
                android:layout_width="@dimen/home_header_avatar_inner"
                android:layout_height="@dimen/home_header_avatar_inner"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/white_25"
                app:strokeWidth="1.5dp"
                android:src="@drawable/ic_user" />
        </FrameLayout>

        <!-- Column 2: User Info Group -->
        <LinearLayout
            android:id="@+id/ll_user_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:orientation="vertical"
            android:gravity="start"
            app:layout_constraintStart_toEndOf="@id/fl_avatar_group"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ll_currencies_pill">

            <TextView
                android:id="@+id/tv_home_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/MoscoText.Luxury.Nav"
                android:textSize="@dimen/home_header_username_text"
                android:textStyle="bold"
                android:fontWeight="800"
                android:textColor="@color/white"
                tools:text="COMMANDER" />

            <!-- ID Badge -->
            <TextView
                android:id="@+id/tv_home_user_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:background="@drawable/bg_badge_dark"
                android:paddingHorizontal="@dimen/spacing_xs"
                android:paddingVertical="@dimen/spacing_xxs"
                style="@style/MoscoText.Luxury.Label"
                android:textSize="@dimen/home_header_id_text"
                android:fontWeight="700"
                android:textColor="@color/white_70"
                tools:text="ID: 10000006" />
        </LinearLayout>

        <!-- Column 3: Currencies Pill (Cosmo Style) -->
        <LinearLayout
            android:id="@+id/ll_currencies_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_header_token"
            android:paddingHorizontal="@dimen/home_header_pill_padding_h"
            android:paddingVertical="@dimen/home_header_pill_padding_v"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Coins -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/spacing_16dp"
                    android:layout_height="@dimen/spacing_16dp"
                    android:src="@drawable/ic_item_coin" />
                <TextView
                    android:id="@+id/tv_home_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xxs"
                    style="@style/MoscoText.Luxury.Price"
                    android:textSize="@dimen/home_header_currency_text"
                    android:fontWeight="800"
                    android:textColor="@color/white"
                    tools:text="1.2M" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="@dimen/home_header_pill_divider_h"
                android:layout_height="@dimen/home_header_pill_divider_v"
                android:layout_marginHorizontal="@dimen/spacing_xs"
                android:background="@color/white_15" />

            <!-- Diamonds -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/spacing_16dp"
                    android:layout_height="@dimen/spacing_16dp"
                    android:src="@drawable/ic_item_diamond" />
                <TextView
                    android:id="@+id/tv_home_diamonds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xxs"
                    style="@style/MoscoText.Luxury.Price"
                    android:textSize="@dimen/home_header_currency_text"
                    android:fontWeight="800"
                    android:textColor="@color/white"
                    tools:text="850" />
            </LinearLayout>
        </LinearLayout>

        <!-- Legacy views (hidden) -->
        <TextView android:id="@+id/tv_home_level" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
        <TextView android:id="@+id/tv_home_ovr" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout android:id="@+id/layout_user_id" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Event Banner (Moved Up) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_banner_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/home_banner_height"
        android:layout_marginHorizontal="@dimen/home_banner_margin_horizontal"
        android:layout_marginTop="@dimen/home_banner_margin_top"
        app:cardCornerRadius="@dimen/home_banner_corner"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintTop_toBottomOf="@id/cl_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_banner_glass">
            <androidx.viewpager2.widget.ViewPager2 android:id="@+id/vp_banners" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/ll_banner_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cv_banner_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  QUICK TOOL HUD — Horizontal Scroll System (V3)            -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:id="@+id/hsv_quick_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:layout_marginHorizontal="@dimen/spacing_16dp"
        android:background="@color/transparent"
        android:scrollbars="none"
        android:clipToPadding="true"
        android:paddingHorizontal="@dimen/spacing_12dp"
        android:paddingVertical="@dimen/spacing_4dp"
        app:layout_constraintTop_toBottomOf="@id/ll_banner_dots">

        <LinearLayout
            android:id="@+id/ll_quick_tools_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Tool: Daily -->
            <LinearLayout
                android:id="@+id/btn_quick_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/home_quick_tool_spacing"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_quick_tool_fab_size"
                    android:layout_height="@dimen/home_quick_tool_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="@dimen/home_quick_tool_icon_size"
                        android:layout_height="@dimen/home_quick_tool_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_daily_calendar"
                        app:tint="@color/quick_tool_daily" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_daily"
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white"
                    android:textSize="@dimen/home_quick_tool_text_size"
                    android:fontWeight="700"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Event -->
            <LinearLayout
                android:id="@+id/btn_quick_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/home_quick_tool_spacing"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_quick_tool_fab_size"
                    android:layout_height="@dimen/home_quick_tool_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="@dimen/home_quick_tool_icon_size"
                        android:layout_height="@dimen/home_quick_tool_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_event_confetti"
                        app:tint="@color/quick_tool_event" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_event"
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white"
                    android:textSize="@dimen/home_quick_tool_text_size"
                    android:fontWeight="700"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Upgrade -->
            <LinearLayout
                android:id="@+id/btn_quick_upgrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/home_quick_tool_spacing"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_quick_tool_fab_size"
                    android:layout_height="@dimen/home_quick_tool_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="@dimen/home_quick_tool_icon_size"
                        android:layout_height="@dimen/home_quick_tool_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_level_up"
                        app:tint="@color/quick_tool_upgrade" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_upgrade"
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white"
                    android:textSize="@dimen/home_quick_tool_text_size"
                    android:fontWeight="700"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Rank -->
            <LinearLayout
                android:id="@+id/btn_quick_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/home_quick_tool_spacing"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_quick_tool_fab_size"
                    android:layout_height="@dimen/home_quick_tool_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="@dimen/home_quick_tool_icon_size"
                        android:layout_height="@dimen/home_quick_tool_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_rank_leaderboard"
                        app:tint="@color/quick_tool_rank" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_rank"
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white"
                    android:textSize="@dimen/home_quick_tool_text_size"
                    android:fontWeight="700"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Shop -->
            <LinearLayout
                android:id="@+id/btn_quick_shop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/home_quick_tool_spacing"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_quick_tool_fab_size"
                    android:layout_height="@dimen/home_quick_tool_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="@dimen/home_quick_tool_icon_size"
                        android:layout_height="@dimen/home_quick_tool_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shop_bag"
                        app:tint="@color/quick_tool_shop" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_shop"
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white"
                    android:textSize="@dimen/home_quick_tool_text_size"
                    android:fontWeight="700"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Friends -->
            <LinearLayout
                android:id="@+id/btn_quick_friends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/home_quick_tool_spacing"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_quick_tool_fab_size"
                    android:layout_height="@dimen/home_quick_tool_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="@dimen/home_quick_tool_icon_size"
                        android:layout_height="@dimen/home_quick_tool_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_friends"
                        app:tint="@color/quick_tool_friends" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_friends"
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white"
                    android:textSize="@dimen/home_quick_tool_text_size"
                    android:fontWeight="700"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Formation -->
            <LinearLayout
                android:id="@+id/btn_quick_formation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/home_quick_tool_spacing"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_quick_tool_fab_size"
                    android:layout_height="@dimen/home_quick_tool_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="@dimen/home_quick_tool_icon_size"
                        android:layout_height="@dimen/home_quick_tool_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stage"
                        app:tint="@color/mosco_neon_blue" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_formation"
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white"
                    android:textSize="@dimen/home_quick_tool_text_size"
                    android:fontWeight="700"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>

            <!-- Tool: Gift -->
            <LinearLayout
                android:id="@+id/btn_quick_gift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/home_quick_tool_spacing"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="@dimen/home_quick_tool_fab_size"
                    android:layout_height="@dimen/home_quick_tool_fab_size"
                    android:background="@drawable/bg_hud_mini_fab">
                    <ImageView
                        android:layout_width="@dimen/home_quick_tool_icon_size"
                        android:layout_height="@dimen/home_quick_tool_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_gift"
                        app:tint="@color/quick_tool_gift" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_hud_gift"
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white"
                    android:textSize="@dimen/home_quick_tool_text_size"
                    android:fontWeight="700"
                    android:layout_marginTop="@dimen/spacing_4dp"/>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Guideline to limit card height (fixing "Ảnh to") -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_showcase_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.98" />


    <!-- Luồng sáng máy chiếu -->
    <View
        android:id="@+id/view_projector_beam"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.0"
        app:layout_constraintWidth_percent="0.75"
        app:layout_constraintTop_toTopOf="@id/fl_showcase_container"
        app:layout_constraintBottom_toBottomOf="@id/fl_showcase_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Showcase Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_showcase_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:paddingBottom="@dimen/spacing_16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/hsv_quick_tools"
        app:layout_constraintBottom_toTopOf="@id/guideline_showcase_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- The Showcase Card (Ratio 1:1.54 - Same as Upgrade) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_showcase_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeWidth="1dp"
            app:strokeColor="#1AFFFFFF"
            app:layout_constraintDimensionRatio="1:1.54"
            app:layout_constraintHeight_percent="0.90"
            app:layout_constrainedWidth="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Background Placeholder (Hiện khi trống) -->
                <View
                    android:id="@+id/view_empty_card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#1A1A1A"
                    android:visibility="gone" />

                <!-- Empty State Content (Nằm trong Card) -->
                <LinearLayout
                    android:id="@+id/ll_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">
                    
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_sad"
                        android:alpha="0.4"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/home_showcase_empty_title"
                        style="@style/MoscoText.Luxury.Label"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:fontWeight="600" />
                </LinearLayout>

                <!-- Unified Card Content (Same proportions as Upgrade Fragment) -->
                <include layout="@layout/layout_core_card" />

                <!-- Back Face (Using objet_back_spin asset) -->
                <ImageView
                    android:id="@+id/iv_showcase_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/objet_back_spin"
                    android:visibility="gone" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layout_showcase_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:lottie_rawRes="@raw/loading"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

                <TextView
                    android:id="@+id/tv_showcase_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8dp"
                    android:text="@string/home_showcase_loading_msg"
                    style="@style/MoscoText.Luxury.Label"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_badge"
                    android:fontWeight="700" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
