<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:clipChildren="false">

    <!-- Badge Container with fixed size -->
    <FrameLayout
        android:id="@+id/fl_badge_container"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipChildren="false">

        <!-- Backlight Shimmer Sweep (Behind the frame) -->
        <View
            android:id="@+id/v_shimmer_sweep"
            android:layout_width="140dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_shimmer_sweep"
            android:rotation="-45"
            android:visibility="invisible" />

        <!-- Hexagon Frame Background -->
        <ImageView
            android:id="@+id/iv_badge_frame"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_hex_gold" />

        <!-- Center Icon -->
        <ImageView
            android:id="@+id/iv_badge_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:elevation="4dp" />
            
    </FrameLayout>

    <!-- Badge Title -->
    <TextView
        android:id="@+id/tv_badge_name"
        style="@style/MoscoText.Luxury.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintTop_toBottomOf="@id/fl_badge_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
