<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mosco_surface">

    <!-- AppBarLayout is a DIRECT child of CoordinatorLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_mailbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mosco_surface"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_20dp"
                android:paddingBottom="@dimen/spacing_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_currency_bar"
                    android:gravity="bottom"
                    android:paddingVertical="@dimen/spacing_6dp"
                    android:paddingStart="@dimen/spacing_6dp"
                    android:paddingEnd="@dimen/radius_lg"
                    android:layout_marginTop="@dimen/spacing_2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_idle_mailbox"
                        style="@style/MoscoButton.IconGlass"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="9dp"
                        app:icon="@drawable/ic_mailbox"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="@dimen/spacing_lg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/collection_tab_mailbox"
                        android:layout_marginStart="@dimen/spacing_10dp"
                        style="@style/MoscoText.Luxury.SubHeader"
                        android:textColor="@color/mosco_on_surface"
                        android:textSize="@dimen/text_size_body_md"
                        android:textStyle="bold"
                        android:fontWeight="700"/>

                </LinearLayout>
            </LinearLayout>

            <!-- Sort + Filter row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/radius_lg"
                android:paddingTop="@dimen/radius_lg"
                android:paddingBottom="@dimen/spacing_sm">

                <!-- Sort Button -->
                <TextView
                    android:id="@+id/btn_sort_mailbox"
                    style="@style/FilterChipStyle"
                    android:layout_width="110dp"
                    android:layout_alignParentStart="true"
                    android:text="@string/inventory_label_sort_newest"
                    android:ellipsize="end"
                    android:maxLines="1"
                    app:drawableEndCompat="@drawable/ic_arrow_down"
                    android:drawablePadding="@dimen/spacing_xs"
                    app:drawableTint="@color/selector_filter_chip_text" />

                <!-- Filter Button -->
                <TextView
                    android:id="@+id/btn_filter_mailbox"
                    style="@style/FilterChipStyle"
                    android:layout_toEndOf="@id/btn_sort_mailbox"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/inventory_label_filter"
                    app:drawableStartCompat="@drawable/ic_filter"
                    android:drawablePadding="@dimen/spacing_6dp"
                    app:drawableTint="@color/selector_filter_chip_text" />

                <!-- Item Count -->
                <TextView
                    android:id="@+id/tv_mailbox_count_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginHorizontal="@dimen/spacing_6dp"
                    android:text="@string/placeholder_empty"
                    style="@style/MoscoText.Luxury.Body"
                    android:textColor="@color/mosco_on_surface_variant"
                    android:textSize="@dimen/text_size_body_xs" />

            </RelativeLayout>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- RecyclerView respects AppBarLayout scrolling -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mailbox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_mailbox" />

    <!-- FAB Receive All pinned at bottom -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_receive_all"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/spacing_20dp"
        android:layout_marginBottom="@dimen/spacing_20dp"
        android:background="@drawable/bg_btn_rainbow"
        style="@style/MoscoText.Luxury.Button"
        android:text="@string/collection_action_receive_all"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_body_md"
        android:textStyle="bold"
        android:fontWeight="700" />

    <!-- Sort Dropdown overlay (elevation keeps it on top) -->
    <LinearLayout
        android:id="@+id/dropdown_sort_mailbox"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_sort_dropdown"
        android:paddingVertical="@dimen/spacing_sm"
        android:visibility="gone"
        android:elevation="@dimen/spacing_md" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

