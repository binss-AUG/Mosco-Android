<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background">

    <!-- AppBarLayout is a DIRECT child of CoordinatorLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_mailbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Common Subpage Header Component -->
            <include
                android:id="@+id/layout_header_mailbox"
                layout="@layout/layout_common_header" />

            <!-- TabLayout - Liquid Glass Dark Mode styling -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout_mailbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/lg_accent_secondary"
                app:tabIndicatorHeight="@dimen/spacing_xs"
                app:tabIndicatorFullWidth="true"
                app:tabSelectedTextColor="@color/lg_accent_secondary"
                app:tabTextColor="@color/mosco_white_30"
                app:tabRippleColor="@null"
                app:tabMaxWidth="0dp"
                app:tabMode="fixed"
                app:tabGravity="fill" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ViewPager2 respects AppBarLayout scrolling behavior -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_mailbox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
