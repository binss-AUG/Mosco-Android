<?xml version="1.0" encoding="utf-8"?>
<!-- Item cho RecyclerView lịch sử gift (tab Gửi / Nhận) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_header_glass_v2"
    android:paddingHorizontal="@dimen/spacing_14dp"
    android:paddingVertical="@dimen/spacing_10dp"
    android:layout_marginBottom="@dimen/spacing_sm">

    <!-- Card Thumbnail -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/spacing_xxl"
        android:layout_height="74dp"
        app:cardCornerRadius="@dimen/spacing_6dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/mosco_card_bg_variant">

        <ImageView
            android:id="@+id/iv_gift_card_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Gift Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/radius_lg">

        <!-- Tên người gửi/nhận -->
        <TextView
            android:id="@+id/tv_gift_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body_sm"
            android:textStyle="bold"
            android:fontWeight="700"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Label direction (Gửi cho / Nhận từ) -->
        <TextView
            android:id="@+id/tv_gift_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_mini" />

        <!-- Thời gian -->
        <TextView
            android:id="@+id/tv_gift_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="@color/palette_gray_800"
            android:textSize="@dimen/text_size_mini"
            android:layout_marginTop="@dimen/spacing_2dp" />
    </LinearLayout>

    <!-- Badge "NEW" cho quà chưa đọc -->
    <TextView
        android:id="@+id/tv_gift_badge_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW"
        style="@style/MoscoText.Luxury.Badge"
        android:textColor="@color/quick_tool_gift"
        android:textSize="@dimen/text_size_mini"
        android:textStyle="bold"
        android:fontWeight="700"
        android:visibility="gone"
        android:background="@drawable/bg_header_token"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_2dp" />
</LinearLayout>



