<?xml version="1.0" encoding="utf-8"?>
<!-- Fragment Explore — Tìm bạn mới — NO HARDCODE — PURE SKELETON UI -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/friend_explore_padding"
    android:background="@android:color/transparent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/social_tab_explore"
        style="@style/MoscoText.Luxury.Nav"
        android:textSize="@dimen/text_size_caption"
        android:textColor="@color/white_70"
        android:letterSpacing="0.1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/spacing_20dp">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_explore"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Skeleton Loading List (Dùng chung cho mọi trạng thái tải) -->
        <include layout="@layout/layout_friend_skeleton_list" />

        <!-- Trạng thái gợi ý rỗng căn giữa tuyệt đối -->
        <LinearLayout
            android:id="@+id/layout_search_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/social_explore_hint"
                style="@style/MoscoText.Luxury.Label"
                android:textColor="@color/white_25"
                android:letterSpacing="0.1" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
