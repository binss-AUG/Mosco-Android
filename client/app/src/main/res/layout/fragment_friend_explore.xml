<?xml version="1.0" encoding="utf-8"?>
<!-- Fragment Explore — Tìm bạn mới — NO HARDCODE — BASIC UI -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/friend_explore_padding"
    android:background="@android:color/transparent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/friend_explore_title"
        style="@style/MoscoText.Luxury.Nav"
        android:textSize="11sp"
        android:textColor="@color/white_70"
        android:letterSpacing="0.1" />



    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/layout_search_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/friend_explore_hint"
                style="@style/MoscoText.Luxury.Label"
                android:textColor="@color/white_25"
                android:letterSpacing="0.1" />
        </LinearLayout>
        
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_search_loading"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            app:lottie_rawRes="@raw/loading"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>
