<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mosco_screen_bg">

    <!-- 1. Bối cảnh vũ trụ trôi nổi đồng bộ -->
    <include layout="@layout/layout_auth_background" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Back Button - Đồng bộ Style Sign Up -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start"
                android:background="@drawable/bg_circle_dark"
                android:padding="12dp"
                android:src="@drawable/ic_back_arrow"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins"
                android:text="Khôi phục"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Glass Card Container -->
            <LinearLayout
                android:id="@+id/glass_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Email Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/label_email"
                    android:textColor="@color/mosco_text_disabled"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_email"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_glass_input"
                        android:drawableStart="@drawable/ic_user"
                        android:drawablePadding="15dp"
                        android:fontFamily="@font/poppins"
                        android:hint="@string/prompt_email"
                        android:inputType="textEmailAddress"
                        android:paddingStart="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textCursorDrawable="@null"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Send Code Button - Được tẩm Style đặc biệt -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_send_code"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_shop_buy_btn"
                    android:fontFamily="@font/poppins"
                    android:text="@string/action_send_code"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textAllCaps="false" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="24dp"
                    android:background="#1AFFFFFF" />

                <!-- Verification Code Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/prompt_verification_code"
                    android:textColor="@color/mosco_text_disabled"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_verification_code"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_glass_input"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="15dp"
                        android:fontFamily="@font/poppins"
                        android:hint="000000"
                        android:inputType="number"
                        android:maxLength="6"
                        android:paddingStart="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textCursorDrawable="@null"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- New Password Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins"
                    android:text="Mật khẩu mới"
                    android:textColor="@color/mosco_text_disabled"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundMode="none"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/mosco_text_disabled"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_password"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_glass_input"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="15dp"
                        android:fontFamily="@font/poppins"
                        android:hint="Mật khẩu ít nhất 6 ký tự"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textCursorDrawable="@null"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Reset Button -->
                <Button
                    android:id="@+id/btn_reset_password"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/poppins"
                    android:text="Đặt lại mật khẩu"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="15dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Lottie Animation Loading nằm ngoài ScrollView để luôn ở chính tâm màn hình -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loading_progress"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loading"
        android:visibility="gone" />

</FrameLayout>
