<?xml version="1.0" encoding="utf-8"?>
<!-- Item for friend list: Avatar | Name + Level — CLEAN VERSION -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_header_glass_v2"
    android:paddingHorizontal="@dimen/spacing_14dp"
    android:paddingVertical="@dimen/radius_lg"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Avatar with Online Status Glow -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/spacing_52dp"
        android:layout_height="@dimen/spacing_52dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_friend_avatar"
            android:layout_width="@dimen/spacing_44dp"
            android:layout_height="@dimen/spacing_44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/lg_glass_surface_high"
            app:strokeColor="@color/mosco_white_20"
            app:strokeWidth="@dimen/stroke_thin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iv_friend_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Dot Glow -->
        <View
            android:id="@+id/view_online_status"
            android:layout_width="@dimen/radius_lg"
            android:layout_height="@dimen/radius_lg"
            android:background="@drawable/bg_status_online"
            android:elevation="@dimen/spacing_2dp"
            app:layout_constraintBottom_toBottomOf="@id/card_friend_avatar"
            app:layout_constraintEnd_toEndOf="@id/card_friend_avatar" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Name + Level -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_14dp">

        <TextView
            android:id="@+id/tv_friend_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.Body"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_friend_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_caption"
            android:layout_marginTop="@dimen/spacing_2dp" />
    </LinearLayout>

</LinearLayout>


