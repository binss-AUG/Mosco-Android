<?xml version="1.0" encoding="utf-8"?>
<!-- item_mini_card.xml — Giao diện mini card hiển thị trong thanh cuộn ngang lịch sử mở pack -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/mini_card_width"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingVertical="@dimen/spacing_6dp"
    android:layout_marginEnd="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_mini_card"
        android:layout_width="@dimen/mini_card_width"
        android:layout_height="@dimen/mini_card_height"
        app:cardCornerRadius="@dimen/radius_m"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        android:layout_gravity="center">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/layout_core_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
