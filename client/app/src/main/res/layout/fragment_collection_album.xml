<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mosco_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_album"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mosco_surface"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Section + Progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_currency_bar"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_idle_album"
                        style="@style/MoscoButton.IconGlass"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="9dp"
                        app:icon="@drawable/ic_collect"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Album"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <!-- Tiến trình thu thập -->
                    <TextView
                        android:id="@+id/tv_album_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="#FFD700"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="24/350" />

                </LinearLayout>

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_album"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/mosco_progress_bar" />

                <!-- Milestone Rewards -->
                <LinearLayout
                    android:id="@+id/ll_milestones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:weightSum="3">

                    <!-- Milestone 1 (30%) -->
                    <LinearLayout
                        android:id="@+id/ms_1_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:id="@+id/iv_ms_1_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_gift"
                            app:tint="#CD7F32" />
                        <TextView
                            android:id="@+id/tv_ms_1_req"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30%"
                            android:textSize="10sp"
                            android:textColor="#A2A2A7"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <!-- Milestone 2 (60%) -->
                    <LinearLayout
                        android:id="@+id/ms_2_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:id="@+id/iv_ms_2_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_gift"
                            app:tint="#C0C0C0" />
                        <TextView
                            android:id="@+id/tv_ms_2_req"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60%"
                            android:textSize="10sp"
                            android:textColor="#A2A2A7"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <!-- Milestone 3 (100%) -->
                    <LinearLayout
                        android:id="@+id/ms_3_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:id="@+id/iv_ms_3_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_gift"
                            app:tint="#FFD700" />
                        <TextView
                            android:id="@+id/tv_ms_3_req"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textSize="10sp"
                            android:textColor="#A2A2A7"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Sort + Filter row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <!-- Sort Button -->
                <TextView
                    android:id="@+id/btn_sort_album"
                    style="@style/FilterChipStyle"
                    android:layout_width="110dp"
                    android:layout_alignParentStart="true"
                    android:text="All"
                    android:ellipsize="end"
                    android:maxLines="1"
                    app:drawableEndCompat="@drawable/ic_arrow_down"
                    android:drawablePadding="4dp"
                    app:drawableTint="@color/selector_filter_chip_text" />

                <!-- Filter Button -->
                <TextView
                    android:id="@+id/btn_filter_album"
                    style="@style/FilterChipStyle"
                    android:layout_toEndOf="@id/btn_sort_album"
                    android:layout_marginStart="8dp"
                    android:text="Filter"
                    app:drawableStartCompat="@drawable/ic_filter"
                    android:drawablePadding="6dp"
                    app:drawableTint="@color/selector_filter_chip_text" />

                <!-- Item Count -->
                <TextView
                    android:id="@+id/tv_album_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginHorizontal="6dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="#A2A2A7"
                    android:textSize="13sp"
                    tools:text="350 Cards" />

            </RelativeLayout>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_album"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="6dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_collection_book_card" />

    <!-- Sort Dropdown Popup (hidden by default) -->
    <LinearLayout
        android:id="@+id/dropdown_sort_album"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_sort_dropdown"
        android:paddingVertical="8dp"
        android:visibility="gone"
        android:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
