<?xml version="1.0" encoding="utf-8"?>
<!-- Quản lý bạn bè — Search bar + TabLayout + ViewPager2 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lg_background_deep">

    <!-- Standard Common Header -->
    <include
        android:id="@+id/layout_header_friend_container"
        layout="@layout/layout_common_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Friend Specific Header Content (QR Button) -->
    <ImageView
        android:id="@+id/btn_friend_qr"
        android:layout_width="@dimen/spacing_40dp"
        android:layout_height="@dimen/spacing_40dp"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:src="@drawable/ic_qr_code"
        android:padding="@dimen/spacing_xs"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_header_friend_container"
        app:layout_constraintBottom_toBottomOf="@id/layout_header_friend_container"
        app:tint="@color/white" />

    <!-- Modern Search Bar (Glassmorphism + Neon) -->
    <com.vn.jet.mosco.view.MoscoSearchBar
        android:id="@+id/search_bar_friend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_20dp"
        android:layout_marginTop="@dimen/spacing_sm"
        app:layout_constraintTop_toBottomOf="@id/layout_header_friend_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TabLayout — 2 tab: FRIENDS, REQUESTS -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_friend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_bar_friend"
        app:tabIndicatorColor="@color/lg_accent_secondary"
        app:tabIndicatorHeight="@dimen/spacing_xs"
        app:tabIndicatorFullWidth="true"
        app:tabSelectedTextColor="@color/lg_accent_secondary"
        app:tabTextColor="@color/mosco_white_30"
        app:tabRippleColor="@null"
        app:tabMaxWidth="0dp"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_friend"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_layout_friend" />

    <!-- Fragment Container for Profile Navigation (Overlay) -->
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp" />

</androidx.constraintlayout.widget.ConstraintLayout>



