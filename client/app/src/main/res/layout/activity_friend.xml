<?xml version="1.0" encoding="utf-8"?>
<!-- Quản lý bạn bè — Search bar + TabLayout + ViewPager2 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_global_gradient">

    <!-- Standard Galactic Header (Abstracted) -->
    <include
        android:id="@+id/layout_header_friend_container"
        layout="@layout/layout_galactic_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Friend Specific Header Content (QR Button) -->
    <ImageView
        android:id="@+id/btn_friend_qr"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/ic_qr_code"
        android:padding="@dimen/spacing_xs"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_header_friend_container"
        app:layout_constraintBottom_toBottomOf="@id/layout_header_friend_container"
        app:tint="@color/white" />

    <!-- Modern Search Bar (Glassmorphism + Neon) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_search_friend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#CC1A1C29"
        app:strokeColor="@color/galactic_accent_purple"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header_friend_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/galactic_accent_purple" />

            <EditText
                android:id="@+id/et_search_friend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="@string/friend_search_hint"
                android:textColorHint="#99A2A2A7"
                android:textColor="@color/white"
                style="@style/MoscoText.Luxury.Body"
                android:textSize="@dimen/text_size_body_md"
                android:background="@null"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- TabLayout — 2 tab: FRIENDS, REQUESTS -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_friend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_search_friend"
        app:tabIndicatorColor="@color/galactic_accent_purple"
        app:tabIndicatorHeight="4dp"
        app:tabIndicatorFullWidth="true"
        app:tabSelectedTextColor="@color/galactic_accent_purple"
        app:tabTextColor="#A2A2A7"
        app:tabRippleColor="@null"
        app:tabMaxWidth="0dp"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_friend"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_layout_friend" />

</androidx.constraintlayout.widget.ConstraintLayout>
