<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_solid"
    android:padding="@dimen/spacing_24dp">

    <!-- Header: Title & Close -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/couple_streak_title"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:fontFamily="@font/pretendard_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_close" />

    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/cd_close"
        app:tint="@color/mosco_white_60"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Content Area: Illustration or Cards -->
    <FrameLayout
        android:id="@+id/layout_content_container"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="@dimen/spacing_24dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">

        <!-- Illustration State (Invite/Wait) -->
        <ImageView
            android:id="@+id/iv_illustration"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/img_couple_streak_invite"
            android:visibility="gone" />

        <!-- Active State (Cards & Fire) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_active_streak"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Names Overlay -->
            <TextView
                android:id="@+id/tv_name_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User A"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="100dp"
                app:layout_constraintBottom_toTopOf="@+id/card_a"
                app:layout_constraintStart_toStartOf="@+id/card_a"
                app:layout_constraintEnd_toEndOf="@+id/card_a"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_name_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User B"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="100dp"
                app:layout_constraintBottom_toTopOf="@+id/card_b"
                app:layout_constraintStart_toStartOf="@+id/card_b"
                app:layout_constraintEnd_toEndOf="@+id/card_b"
                android:layout_marginBottom="8dp" />

            <!-- Card Slots -->
            <FrameLayout
                android:id="@+id/card_a"
                android:layout_width="110dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_card_placeholder"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_fire_streak"
                app:layout_constraintHorizontal_chainStyle="packed">
                
                <ImageView
                    android:id="@+id/iv_card_a_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/card_b"
                android:layout_width="110dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_card_placeholder"
                android:layout_marginStart="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/card_a"
                app:layout_constraintEnd_toEndOf="parent">
                
                <ImageView
                    android:id="@+id/iv_card_b_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <!-- Fire Streak Middle -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_fire_streak"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/streak_animation"
                app:layout_constraintTop_toTopOf="@+id/card_a"
                app:layout_constraintBottom_toBottomOf="@+id/card_a"
                app:layout_constraintStart_toEndOf="@+id/card_a"
                app:layout_constraintEnd_toStartOf="@+id/card_b" />

            <TextView
                android:id="@+id/tv_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_bold"
                app:layout_constraintTop_toBottomOf="@+id/iv_fire_streak"
                app:layout_constraintStart_toStartOf="@+id/iv_fire_streak"
                app:layout_constraintEnd_toEndOf="@+id/iv_fire_streak" />

            <!-- Change Button Overlay (under card A as per drawing) -->
            <com.vn.jet.mosco.widget.MoscoButton
                android:id="@+id/btn_change_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:moscoSize="small"
                app:moscoStyle="ghost"
                android:text="@string/couple_streak_action_change"
                app:layout_constraintTop_toBottomOf="@+id/card_a"
                app:layout_constraintStart_toStartOf="@+id/card_a"
                app:layout_constraintEnd_toStartOf="@+id/card_b"
                app:layout_constraintHorizontal_bias="0.2"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Message Description -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/couple_streak_invite_msg"
        android:textColor="@color/mosco_white_80"
        android:textSize="14sp"
        android:gravity="center"
        android:fontFamily="@font/pretendard"
        app:layout_constraintTop_toBottomOf="@+id/layout_content_container" />

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_description"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_action_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:moscoStyle="ghost"
            android:text="@string/couple_streak_action_cancel"
            android:visibility="gone" />

        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_action_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="12dp"
            app:moscoStyle="primary"
            android:text="@string/couple_streak_action_request" />
            
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
