<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình Settings được tái cấu trúc hoàn chỉnh sang dạng Flat List đồng bộ -->
<!-- Tại sao (WHY): Đáp ứng 100% triết lý thiết kế luxury của Mosco, loại bỏ sự lộn xộn giữa Card/Flat -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Header phong cách dải thiên hà (Galaxy Style Header) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/spacing_40dp"
            android:layout_height="@dimen/spacing_40dp"
            android:src="@drawable/ic_back_arrow"
            android:padding="@dimen/spacing_xs"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/white"
            android:contentDescription="Back Button" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_md"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_menu_central_hub"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="@dimen/text_size_h3"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
            
            <View
                android:layout_width="@dimen/spacing_xl"
                android:layout_height="2dp"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:background="@color/lg_accent_primary" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- ================= SECTION: SYSTEM & SOUND ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_label_system"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="@dimen/text_size_h3"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Dark Mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_dark_mode"
                    app:tint="@color/white"
                    android:contentDescription="Dark Mode Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_label_dark_mode"
                    style="@style/MoscoText.Luxury.Body"
                    android:textSize="@dimen/text_size_body_md" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/mosco_surface_variant" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Music -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/white"
                    android:contentDescription="Music Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_label_music"
                    style="@style/MoscoText.Luxury.Body"
                    android:textSize="@dimen/text_size_body_md" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_music"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/mosco_surface_variant" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Sound Effects (SFX) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/white"
                    android:contentDescription="SFX Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_label_sfx"
                    style="@style/MoscoText.Luxury.Body"
                    android:textSize="@dimen/text_size_body_md" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_sfx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/mosco_surface_variant" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Language Section (Tái cấu trúc sang phẳng) -->
            <include
                android:id="@+id/menu_change_language"
                layout="@layout/item_flat_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <!-- ================= SECTION: NOTIFICATIONS ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_label_notifications"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="@dimen/text_size_h3"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Private Messages -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_bell_neon"
                    app:tint="@color/white"
                    android:contentDescription="Notification Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_label_noti_chat"
                    style="@style/MoscoText.Luxury.Body"
                    android:textSize="@dimen/text_size_body_md" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_noti_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/mosco_surface_variant" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Streak Updates -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_streak"
                    app:tint="@color/white"
                    android:contentDescription="Streak Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_label_noti_streak"
                    style="@style/MoscoText.Luxury.Body"
                    android:textSize="@dimen/text_size_body_md" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_noti_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/mosco_surface_variant" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <!-- ================= SECTION: DATA MANAGEMENT ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_label_data"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="@dimen/text_size_h3"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Storage Section (Cấu trúc lại phẳng) -->
            <LinearLayout
                android:id="@+id/btn_storage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_80dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_items"
                    app:tint="@color/white"
                    android:contentDescription="Storage Icon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_label_storage"
                        style="@style/MoscoText.Luxury.Body"
                        android:textSize="@dimen/text_size_body_md"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_cache_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_msg_loading"
                        style="@style/MoscoText.Luxury.Body"
                        android:textColor="@color/mosco_on_surface_variant"
                        android:textSize="@dimen/text_size_mini" />
                </LinearLayout>
                <com.vn.jet.mosco.widget.MoscoButton
                    android:id="@+id/btn_clear_cache"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:moscoStyle="ghost"
                    app:moscoSize="small"
                    android:text="@string/settings_action_clear_cache" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Auto Backup Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/spacing_80dp"
                android:paddingTop="@dimen/radius_lg"
                android:paddingBottom="@dimen/radius_lg"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_sync_galactic"
                    app:tint="@color/white"
                    android:contentDescription="Auto Backup Icon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_label_auto_backup"
                        style="@style/MoscoText.Luxury.Body"
                        android:textSize="@dimen/text_size_body_md"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_desc_auto_backup"
                        style="@style/MoscoText.Luxury.Body"
                        android:textColor="@color/mosco_on_surface_variant"
                        android:textSize="@dimen/text_size_mini" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_auto_backup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/mosco_surface_variant" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Backup Interval Row (Cấu trúc phẳng dùng item_flat_menu) -->
            <include
                android:id="@+id/menu_backup_interval"
                layout="@layout/item_flat_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <View
                android:id="@+id/divider_backup_interval"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10"
                android:visibility="gone" />

            <!-- Backup Local Data -->
            <include
                android:id="@+id/menu_backup_data"
                layout="@layout/item_flat_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Restore Local Data -->
            <include
                android:id="@+id/menu_restore_data"
                layout="@layout/item_flat_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Cloud Sync -->
            <include
                android:id="@+id/menu_cloud_sync"
                layout="@layout/item_flat_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Report a Bug -->
            <include
                android:id="@+id/menu_report_bug"
                layout="@layout/item_flat_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <!-- ================= SECTION: ACCOUNT ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_label_account"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="@dimen/text_size_h3"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Change Password -->
            <LinearLayout
                android:id="@+id/btn_change_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/white"
                    android:contentDescription="Password Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_action_change_password"
                    style="@style/MoscoText.Luxury.Body"
                    android:textSize="@dimen/text_size_body_md" />
                <ImageView
                    android:layout_width="@dimen/spacing_md"
                    android:layout_height="@dimen/spacing_md"
                    android:src="@drawable/ic_forward_arrow"
                    app:tint="@color/mosco_on_surface_variant"
                    android:contentDescription="Arrow" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Switch Account (Cấu trúc phẳng dùng item_flat_menu) -->
            <include
                android:id="@+id/menu_switch_account"
                layout="@layout/item_flat_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Privacy Policy -->
            <LinearLayout
                android:id="@+id/btn_privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/white"
                    android:contentDescription="Privacy Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_action_privacy"
                    style="@style/MoscoText.Luxury.Body"
                    android:textSize="@dimen/text_size_body_md" />
                <ImageView
                    android:layout_width="@dimen/spacing_md"
                    android:layout_height="@dimen/spacing_md"
                    android:src="@drawable/ic_forward_arrow"
                    app:tint="@color/mosco_on_surface_variant"
                    android:contentDescription="Arrow" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Terms of Service -->
            <LinearLayout
                android:id="@+id/btn_terms_of_service"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/white"
                    android:contentDescription="Terms Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_action_terms"
                    style="@style/MoscoText.Luxury.Body"
                    android:textSize="@dimen/text_size_body_md" />
                <ImageView
                    android:layout_width="@dimen/spacing_md"
                    android:layout_height="@dimen/spacing_md"
                    android:src="@drawable/ic_forward_arrow"
                    app:tint="@color/mosco_on_surface_variant"
                    android:contentDescription="Arrow" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Open Source Licenses -->
            <LinearLayout
                android:id="@+id/btn_open_source"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_info"
                    app:tint="@color/white"
                    android:contentDescription="Licenses Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_action_licenses"
                    style="@style/MoscoText.Luxury.Body"
                    android:textSize="@dimen/text_size_body_md" />
                <ImageView
                    android:layout_width="@dimen/spacing_md"
                    android:layout_height="@dimen/spacing_md"
                    android:src="@drawable/ic_forward_arrow"
                    app:tint="@color/mosco_on_surface_variant"
                    android:contentDescription="Arrow" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Logout Section (Đồng bộ mũi tên chỉ sang phải) -->
            <LinearLayout
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/stat_atk"
                    android:contentDescription="Logout Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_action_logout"
                    style="@style/MoscoText.Luxury.Body"
                    android:textColor="@color/stat_atk"
                    android:textSize="@dimen/text_size_body_md" />
                <ImageView
                    android:layout_width="@dimen/spacing_md"
                    android:layout_height="@dimen/spacing_md"
                    android:src="@drawable/ic_forward_arrow"
                    app:tint="@color/stat_atk"
                    android:contentDescription="Arrow" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Delete Account Section (Đồng bộ mũi tên chỉ sang phải) -->
            <LinearLayout
                android:id="@+id/btn_delete_account"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_sad"
                    app:tint="@color/stat_atk"
                    android:contentDescription="Delete Account Icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/settings_action_delete_account"
                    style="@style/MoscoText.Luxury.Body"
                    android:textColor="@color/stat_atk"
                    android:textSize="@dimen/text_size_body_md" />
                <ImageView
                    android:layout_width="@dimen/spacing_md"
                    android:layout_height="@dimen/spacing_md"
                    android:src="@drawable/ic_forward_arrow"
                    app:tint="@color/stat_atk"
                    android:contentDescription="Arrow" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:background="@color/mosco_white_10" />

            <!-- Version Info (Căn chỉnh gọn gàng, bind động text) -->
            <TextView
                android:id="@+id/tv_version_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:gravity="center"
                android:text="@string/common_galactic_edition"
                style="@style/MoscoText.Luxury.Body"
                android:textColor="@color/mosco_outline_variant"
                android:textSize="@dimen/text_size_mini"
                android:alpha="0.5" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
