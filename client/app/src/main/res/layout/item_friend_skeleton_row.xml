<?xml version="1.0" encoding="utf-8"?>
<!-- Hàng mẫu Skeleton Loading cho danh sách bạn bè / gợi ý / lời mời -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_header_glass_v2"
    android:paddingHorizontal="@dimen/spacing_14dp"
    android:paddingVertical="@dimen/radius_lg"
    android:layout_marginBottom="@dimen/spacing_sm">

    <!-- Skeleton Avatar Tròn -->
    <View
        android:layout_width="@dimen/spacing_44dp"
        android:layout_height="@dimen/spacing_44dp"
        android:background="@drawable/bg_skeleton_circle" />

    <!-- Skeleton Tên + Chức danh (Chữ nhật dài) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_14dp"
        android:gravity="center_vertical">

        <View
            android:layout_width="140dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton_rect_rounded"
            android:layout_marginBottom="6dp" />

        <View
            android:layout_width="80dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_skeleton_rect_rounded" />
    </LinearLayout>

    <!-- Skeleton Nút thao tác phụ bên phải -->
    <View
        android:layout_width="56dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_skeleton_rect_rounded" />
</LinearLayout>
