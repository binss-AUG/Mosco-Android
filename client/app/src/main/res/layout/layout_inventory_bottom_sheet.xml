<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_modal_surface"
    android:paddingStart="@dimen/inventory_padding"
    android:paddingEnd="@dimen/inventory_padding"
    android:paddingTop="@dimen/inventory_padding"
    android:paddingBottom="0dp">

    <!-- Header -->
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/spacing_lg"
        android:layout_height="@dimen/spacing_lg"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintBottom_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inventory_title_margin_top"
        style="@style/MoscoText.Luxury.SubHeader"
        android:text="@string/inventory_title"
        android:textSize="@dimen/text_size_body_lg"
        android:textStyle="bold"
        android:fontWeight="700"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Filter & Sort Bar (Custom Component) -->
    <com.vn.jet.mosco.view.InventoryFilterBar
        android:id="@+id/filter_bar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/inventory_filter_bar_height"
        android:layout_marginTop="@dimen/inventory_filter_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <LinearLayout
        android:id="@+id/ll_select_count_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/filter_bar"
        app:layout_constraintTop_toTopOf="@id/filter_bar">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_objets"
            app:tint="@color/lg_text_secondary" />

        <TextView
            android:id="@+id/tv_select_types_count"
            style="@style/MoscoText.Luxury.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/placeholder_empty"
            android:textColor="@color/lg_text_secondary"
            android:textSize="@dimen/text_size_body_sm"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sort Dropdown Popup (Managed by Custom Component) -->
    <LinearLayout
        android:id="@+id/dropdown_sort_select"
        android:layout_width="@dimen/inventory_dropdown_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_sort_dropdown"
        android:paddingVertical="@dimen/spacing_xs"
        android:visibility="gone"
        android:elevation="@dimen/elevation_m"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_bar">

        <ImageView
            android:layout_width="@dimen/inventory_empty_image_width"
            android:layout_height="@dimen/inventory_empty_image_height"
            android:src="@drawable/objet_back_spin"
            android:alpha="0.4"
            android:layout_marginBottom="@dimen/inventory_empty_image_margin_bottom"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.SubHeader"
            android:text="@string/inventory_empty_title"
            android:textColor="@color/white_50"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="normal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            style="@style/MoscoText.Luxury.Body"
            android:text="@string/inventory_empty_desc"
            android:textColor="@color/white_20"
            android:textSize="@dimen/text_size_body_sm" />
    </LinearLayout>

    <!-- Lottie Loading State -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loader_lottie"
        android:layout_width="@dimen/inventory_loader_size"
        android:layout_height="@dimen/inventory_loader_size"
        android:layout_marginTop="@dimen/spacing_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_bar"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loading"
        android:visibility="gone" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_inventory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_16dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_lg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_bar"
        tools:listitem="@layout/item_inventory_card" />

    <!-- Removed Duplicate Dropdown -->

    <!-- Action Buttons Row (With Fog Background) -->
    <LinearLayout
        android:id="@+id/layout_action_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_gradient_transparent_black"
        android:paddingTop="@dimen/spacing_16dp"
        android:paddingBottom="@dimen/spacing_24dp"
        android:paddingHorizontal="@dimen/inventory_action_padding_horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Quick Pick Button (Squad only) -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_quick_pick_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/inventory_action_btn_spacing"
            android:text="@string/inventory_action_quick"
            android:singleLine="true"
            app:moscoStyle="secondary"
            app:moscoSize="large" />

        <!-- Confirm Button -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_confirm"
            app:moscoStyle="primary"
            app:moscoSize="large" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

