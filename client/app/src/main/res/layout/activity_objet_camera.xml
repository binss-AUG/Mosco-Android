<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Wrapper cho phép crop khung hình theo Aspect Ratio -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_camera_wrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Camera Preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/view_finder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Container cho AR Objet (Vuốt, Zoom, Xoay) -->
        <FrameLayout
            android:id="@+id/fl_ar_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Container bọc card và glow giúp tương tác đồng bộ -->
            <FrameLayout
                android:id="@+id/fl_objet_transform_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:rotation="-30">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_objet_wrapper"
                    android:layout_width="140dp"
                    android:layout_height="215dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/lg_radius_card"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include layout="@layout/layout_core_card" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                        
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </FrameLayout>
        
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hướng dẫn cử chỉ -->
    <TextView
        android:id="@+id/tv_ar_instruction"
        style="@style/MoscoText.Luxury"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_pill_dark"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="1 ngón: Di chuyển\n2 ngón: Xoay &amp; Thu phóng"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_camera_top_bar" />

    <!-- Top Bar Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_camera_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_camera_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_glass_circle"
            android:clickable="true"
            android:focusable="true"
            app:tint="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Nút tỉ lệ khung hình (Text base) -->
        <TextView
            android:id="@+id/btn_camera_aspect_ratio"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="1:1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/lg_btn_pill_glass_ghost"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Controls -->
    <ImageView
        android:id="@+id/btn_camera_capture"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/bg_camera_shutter_glass"
        android:padding="4dp"
        android:background="?selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btn_camera_flip"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="32dp"
        android:padding="12dp"
        android:src="@drawable/ic_swap_camera_loop"
        android:background="@drawable/bg_glass_circle"
        android:clickable="true"
        android:focusable="true"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@id/btn_camera_capture"
        app:layout_constraintTop_toTopOf="@id/btn_camera_capture"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Màn che Loading -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
