<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_daily_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/white_05"
    app:cardCornerRadius="@dimen/daily_card_corner"
    app:cardElevation="0dp"
    app:strokeWidth="@dimen/stroke_thin"
    app:strokeColor="@color/white_20">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Artwork Background (Stage Style) -->
        <ImageView
            android:id="@+id/iv_banner_artwork"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:alpha="0.75"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/lg_background_deep" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_stage_card_gradient_overlay" />

        <!-- Lưới Vi mạch mờ (Grid Overlay) để tạo cảm giác Sci-fi -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.05"
            android:background="@drawable/bg_stage_card_gradient_overlay" />

        <!-- Barcode Decor dọc -->
        <TextView
            android:id="@+id/tv_barcode_decor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_barcode_pattern"
            android:rotation="90"
            android:fontFamily="sans-serif-monospace"
            android:textSize="@dimen/daily_barcode_text_size"
            android:textColor="@color/white_20"
            android:letterSpacing="-0.2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.4"
            android:layout_marginEnd="-16dp" />

        <!-- Serial Number Decor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_serial_number"
            android:fontFamily="sans-serif-monospace"
            android:textSize="@dimen/daily_serial_text_size"
            android:textColor="@color/white_40"
            android:letterSpacing="0.2"
            android:layout_margin="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Time Chip (Floating Glass) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_time_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/daily_chip_corner"
            app:cardBackgroundColor="@color/daily_chip_bg"
            app:strokeColor="@color/white_20"
            app:strokeWidth="@dimen/stroke_thin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            
            <TextView
                android:id="@+id/tv_time_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/daily_time_chip_padding_h"
                android:paddingVertical="@dimen/daily_time_chip_padding_v"
                style="@style/MoscoText.Luxury.Badge"
                android:fontFamily="sans-serif-monospace"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:text="06:00 - 11:59" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Claimed Stamp (Text View) -->
        <TextView
            android:id="@+id/tv_stamp_claimed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_status_verified"
            android:textSize="@dimen/daily_stamp_text_size"
            android:textStyle="bold"
            android:fontFamily="sans-serif-monospace"
            android:textColor="@color/daily_stamp_verified"
            android:rotation="-15"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone"
            android:letterSpacing="0.2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Info Area (Bottom Aligned like Stage Map) -->
        <LinearLayout
            android:id="@+id/layout_card_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/daily_info_padding_h"
            app:layout_constraintTop_toBottomOf="@id/cv_time_chip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constrainedHeight="true"
            app:layout_constraintVertical_bias="1.0">

            <TextView
                android:id="@+id/tv_session_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/MoscoText.Luxury.Header"
                android:fontFamily="sans-serif-monospace"
                android:textSize="@dimen/daily_header_text_size"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                tools:text="MORNING" />

            <TextView
                android:id="@+id/tv_session_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                style="@style/MoscoText.Luxury.Body"
                android:textColor="@color/white_70"
                android:textSize="@dimen/text_size_body_sm"
                tools:text="Start your day with an energy boost from Mosco." />

            <View
                android:id="@+id/view_accent_line"
                android:layout_width="@dimen/spacing_xl"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@color/lg_accent_secondary" />

            <!-- Rewards Panel (Compact Glass) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_glass_card"
                android:padding="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/daily_reward_icon_size"
                        android:layout_height="@dimen/daily_reward_icon_size"
                        android:src="@drawable/ic_item_coin" />
                    <TextView
                        android:id="@+id/tv_reward_coin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        style="@style/MoscoText.Luxury.Price"
                        android:textColor="@color/item_coin"
                        android:textSize="@dimen/text_size_body_md"
                        tools:text="500" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/stroke_thin"
                    android:layout_height="@dimen/spacing_md"
                    android:background="@color/white_10" />

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/daily_reward_icon_size"
                        android:layout_height="@dimen/daily_reward_icon_size"
                        android:src="@drawable/ic_item_diamond" />
                    <TextView
                        android:id="@+id/tv_reward_diamond"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        style="@style/MoscoText.Luxury.Price"
                        android:textColor="@color/item_diamond"
                        android:textSize="@dimen/text_size_body_md"
                        tools:text="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Claim Button (Stage Button Style) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_claim_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/daily_button_corner"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/lg_accent_secondary"
                app:strokeWidth="@dimen/stroke_thin"
                app:strokeColor="@android:color/transparent">
                
                <TextView
                    android:id="@+id/tv_claim_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/spacing_md"
                    android:text="@string/daily_action_authenticate"
                    style="@style/MoscoText.Luxury.Button"
                    android:fontFamily="sans-serif-monospace"
                    android:textAlignment="center"
                    android:textSize="@dimen/text_size_body_md"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
