<?xml version="1.0" encoding="utf-8"?>
<!-- Bảng xếp hạng — Cấu trúc Tab giống CollectionFragment -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_global_gradient">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layout_rank_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back_rank"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_arrow"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:cardBackgroundColor="#1A1C29"
            app:cardCornerRadius="8dp"
            app:strokeColor="#8A2BE2"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rank_header_title"
                style="@style/MoscoText.Luxury.SubHeader"
                android:textSize="@dimen/text_size_body_lg"
                android:textStyle="bold"
                android:fontWeight="700"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.05" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- TabLayout — Giống hệt Collection -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_rank"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_rank_header"
        app:tabIndicatorColor="#8A2BE2"
        app:tabIndicatorHeight="4dp"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="#8A2BE2"
        app:tabTextColor="#A2A2A7"
        app:tabRippleColor="@null"
        app:tabMaxWidth="0dp"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- ViewPager2 — Giống hệt Collection -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_rank"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_layout_rank" />

</androidx.constraintlayout.widget.ConstraintLayout>
