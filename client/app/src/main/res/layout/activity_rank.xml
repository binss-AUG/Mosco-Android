<?xml version="1.0" encoding="utf-8"?>
<!-- Bảng xếp hạng — Cấu trúc Tab giống CollectionFragment -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lg_background_deep">

    <include
        android:id="@+id/layout_header_rank"
        layout="@layout/layout_common_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TabLayout — Giống hệt Collection -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_rank"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header_rank"
        app:tabIndicatorColor="@color/lg_glass_stroke"
        app:tabIndicatorHeight="@dimen/spacing_xs"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="@color/lg_glass_stroke"
        app:tabTextColor="@color/mosco_white_30"
        app:tabRippleColor="@null"
        app:tabMaxWidth="0dp"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- PULL TO REFRESH CONTAINER -->
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/swipe_refresh_rank"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_sm"
        app:layout_constraintBottom_toTopOf="@id/card_my_rank"
        app:layout_constraintTop_toBottomOf="@id/tab_layout_rank">

        <!-- Lottie Custom Header (Consistent with Home) -->
        <com.vn.jet.mosco.utils.LottieHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ViewPager2 — Danh sách xếp hạng -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager_rank"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    <!-- My Rank Floating Footer (Quiet Luxury Style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_my_rank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="@dimen/radius_lg"
        app:cardBackgroundColor="@color/lg_glass_surface_elevated"
        app:strokeColor="@color/lg_accent_secondary"
        app:strokeWidth="1.2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="@dimen/spacing_sm">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rank_label_your_ranking"
                style="@style/MoscoText.Luxury.Nav"
                android:textSize="@dimen/text_size_caption"
                android:alpha="0.7"
                android:letterSpacing="0.1"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_2dp"
                android:textColor="@color/white" />

            <!-- Chúng ta sẽ xử lý background transparent trong code RankActivity -->
            <include
                android:id="@+id/layout_my_rank_item"
                layout="@layout/item_rank_entry" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>



