<?xml version="1.0" encoding="utf-8"?>
<!-- Mỗi hàng buff trong bảng Synergy BottomSheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_10dp"
    android:background="?attr/selectableItemBackground">

    <!-- Cột 1: Tên Buff -->
    <TextView
        android:id="@+id/tv_synergy_badge_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/MoscoText.Luxury.SubHeader"
        tools:text="EVOLution"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_body_sm"
        android:textStyle="bold"
        android:fontWeight="700"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Cột 2: Chỉ số buff (VD: +15% OVR) -->
    <TextView
        android:id="@+id/tv_synergy_buff_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/MoscoText.Luxury.Price"
        tools:text="+15%"
        android:textColor="@color/mosco_tertiary"
        android:textSize="@dimen/text_size_body_sm"
        android:textStyle="bold"
        android:fontWeight="700"
        android:layout_marginEnd="@dimen/radius_lg" />

    <!-- Cột 3: Container sao đánh giá -->
    <LinearLayout
        android:id="@+id/ll_star_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <!-- Sao được tạo động từ Adapter -->
    </LinearLayout>

</LinearLayout>

