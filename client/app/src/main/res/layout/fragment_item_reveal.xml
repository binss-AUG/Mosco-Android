<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_item_reveal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background">

    <!-- Back Arrow (top left) -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/spacing_36dp"
        android:layout_height="@dimen/spacing_36dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:src="@drawable/ic_back_arrow"
        app:tint="@color/white"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ====== HEADER: Name aligned with back arrow ====== -->
    <TextView
        android:id="@+id/tv_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/MoscoText.Luxury.Header"
        android:textSize="@dimen/text_size_h1"
        android:textStyle="bold"
        android:fontWeight="700"
        android:letterSpacing="-0.02"
        android:shadowColor="@color/black"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        tools:text="Metal Pack"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====== CENTER ZONE: Image card centered on screen ====== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintDimensionRatio="1:1.54"
        app:layout_constraintWidth_percent="0.525"
        app:layout_constraintTop_toBottomOf="@id/tv_item_name"
        app:layout_constraintBottom_toTopOf="@id/tv_item_qty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- 1. Metallic Background -->
        <View
            android:id="@+id/view_card_metallic_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 2. Item Image -->
        <ImageView
            android:id="@+id/iv_item_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/item_shop_demo" />

        <!-- Video Player for Motion cards (ExoPlayer) -->
        <TextureView
            android:id="@+id/vv_item_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />


        <!-- 3. Shimmer Overlay -->
        <View
            android:id="@+id/view_card_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 4. Glow/Flash Overlay -->
        <View
            android:id="@+id/view_pack_flash_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:alpha="0" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ====== QUANTITY: Glass Effect ====== -->
    <TextView
        android:id="@+id/tv_item_qty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20dp"
        style="@style/MoscoText.Luxury.Price"
        android:textSize="21sp"
        android:textStyle="bold"
        android:fontWeight="700"
        android:letterSpacing="0.05"
        android:background="@drawable/bg_glass_qty"
        android:paddingHorizontal="@dimen/spacing_36dp"
        android:paddingVertical="3dp"
        tools:text="x7"
        app:layout_constraintTop_toBottomOf="@id/card_item"
        app:layout_constraintBottom_toTopOf="@id/tv_item_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====== DETAIL: Info below quantity ====== -->
    <TextView
        android:id="@+id/tv_item_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        style="@style/MoscoText.Luxury.Body"
        android:textColor="@color/mosco_white_50"
        android:textSize="@dimen/text_size_body_sm"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_40dp"
        tools:text="Rates: 80% First, Welcome, 15% Double"
        app:layout_constraintTop_toBottomOf="@id/tv_item_qty"
        app:layout_constraintBottom_toTopOf="@id/ll_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====== BUTTONS: Pinned to bottom ====== -->
    <LinearLayout
        android:id="@+id/ll_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_xl"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Open x1 -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_open_one"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            app:moscoStyle="primary"
            app:moscoSize="large"
            android:text="@string/reveal_action_open_x1" />

        <!-- Open All (only visible when qty > 1) -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_open_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            app:moscoStyle="secondary"
            app:moscoSize="large"
            android:text="@string/reveal_action_open_all"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Done Button (visible when qty == 0) -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:moscoStyle="primary"
            app:moscoSize="large"
            android:text="@string/action_confirm"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ====== CARD HISTORY CAROUSEL ====== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_card_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/card_item"
        app:layout_constraintBottom_toTopOf="@id/ll_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.8" />

    <FrameLayout
        android:id="@+id/vip_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="2000dp">

        <TextView
            android:id="@+id/tv_overlay_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            style="@style/MoscoText.Luxury.Header"
            android:textSize="48sp"
            android:textStyle="bold"
            android:fontWeight="700"
            android:letterSpacing="0.2"
            android:alpha="0"
            android:shadowColor="@color/lg_accent_primary"
            android:shadowRadius="30"
            tools:text="2005" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

