<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_item_reveal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0: Background views for smooth transition -->
    <View
        android:id="@+id/view_reveal_bg_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/lg_background_deep" />

    <View
        android:id="@+id/view_reveal_bg_fade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone" />

    <!-- Close Button (top right) -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/spacing_40dp"
        android:layout_height="@dimen/spacing_40dp"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:src="@drawable/ic_close"
        android:padding="@dimen/spacing_xs"
        app:tint="@color/white"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====== HEADER: Name aligned with back arrow ====== -->
    <TextView
        android:id="@+id/tv_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="56dp"
        style="@style/MoscoText.Luxury.Header"
        android:textSize="@dimen/text_size_h1"
        android:textStyle="bold"
        android:fontWeight="700"
        android:letterSpacing="-0.02"
        android:shadowColor="@color/black"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollHorizontally="true"
        android:freezesText="true"
        tools:text="Metal Pack"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dedicated Collection ID display above the card -->
    <TextView
        android:id="@+id/tv_reveal_collection_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/MoscoText.Luxury.Header"
        android:textSize="@dimen/text_size_h1"
        android:textStyle="bold"
        android:fontWeight="700"
        android:letterSpacing="-0.02"
        android:shadowColor="@color/black"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:gravity="center"
        android:visibility="invisible"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/card_item"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====== CENTER ZONE: Image card centered on screen ====== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintDimensionRatio="1:1.54"
        app:layout_constraintWidth_percent="0.65"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.18">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/layout_core_card" />

            <!-- 4. Glow/Flash Overlay (Giữ lại để làm hiệu ứng lật thẻ) -->
            <View
                android:id="@+id/view_pack_flash_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white"
                android:alpha="0" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ====== QUANTITY: Glass Effect ====== -->
    <TextView
        android:id="@+id/tv_item_qty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20dp"
        style="@style/MoscoText.Luxury.Price"
        android:textSize="21sp"
        android:textStyle="bold"
        android:fontWeight="700"
        android:letterSpacing="0.05"
        android:background="@drawable/bg_glass_qty"
        android:paddingHorizontal="@dimen/spacing_36dp"
        android:paddingVertical="3dp"
        tools:text="x7"
        app:layout_constraintTop_toBottomOf="@id/card_item"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====== DETAIL: Info below quantity ====== -->
    <TextView
        android:id="@+id/tv_item_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        style="@style/MoscoText.Luxury.Body"
        android:textColor="@color/mosco_white_50"
        android:textSize="@dimen/text_size_body_sm"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_40dp"
        tools:text="Rates: 80% First, Welcome, 15% Double"
        app:layout_constraintTop_toBottomOf="@id/tv_item_qty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ====== CARD HISTORY: Horizontal List ====== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_card_history"
        android:layout_width="match_parent"
        android:layout_height="@dimen/reveal_history_height"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_md"
        android:clipChildren="false"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/card_item"
        app:layout_constraintBottom_toTopOf="@id/ll_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.75" />

    <!-- ====== BUTTONS: Pinned to bottom ====== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_xl"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Open x1 -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_open_one"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            app:layout_goneMarginEnd="0dp"
            app:moscoStyle="primary"
            app:moscoSize="large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_open_all"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/reveal_action_open_x1" />

        <!-- Open All (only visible when qty > 1) -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_open_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            app:layout_goneMarginStart="0dp"
            app:moscoStyle="secondary"
            app:moscoSize="large"
            app:layout_constraintStart_toEndOf="@id/btn_open_one"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/reveal_action_open_all"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Done Button (visible when qty == 0) -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:moscoStyle="primary"
            app:moscoSize="large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/action_confirm"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/vip_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="2000dp">

        <TextView
            android:id="@+id/tv_overlay_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            style="@style/MoscoText.Luxury.Header"
            android:textSize="48sp"
            android:textStyle="bold"
            android:fontWeight="700"
            android:letterSpacing="0.2"
            android:alpha="0"
            android:shadowColor="@color/lg_accent_primary"
            android:shadowRadius="30"
            tools:text="2005" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

