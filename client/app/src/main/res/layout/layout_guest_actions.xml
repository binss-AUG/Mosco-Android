<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_sm"
    android:gravity="start">

    <!-- Row 1: Interaction & Communication (Like & Message ở trên) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:layout_marginBottom="@dimen/spacing_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_like"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_xxs"
            android:text="@string/profile_btn_like"
            android:textSize="@dimen/text_12sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/lg_btn_pill"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:icon="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_direct_message"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="@string/profile_btn_message"
            android:textSize="@dimen/text_12sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/lg_btn_pill"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:icon="@drawable/ic_mailbox"
            app:iconSize="14dp"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>

    <!-- Row 2: Relationship Management (Nút Add Friend nổi bật ở dưới) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:layout_marginEnd="@dimen/spacing_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_friend"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="@string/profile_btn_add_friend"
            android:textSize="@dimen/text_12sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/lg_btn_pill"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:icon="@null" />

        <!-- Nút Decline nhỏ (Dấu X) xuất hiện khi đang là người nhận lời mời (friendshipStatus = 3) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_decline_request"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="@dimen/spacing_xxs"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/lg_btn_pill"
            app:icon="@drawable/ic_close"
            app:iconSize="14dp"
            app:iconPadding="0dp"
            app:iconTint="@color/palette_red_accent"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
