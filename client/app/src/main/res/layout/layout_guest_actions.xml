<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_sm"
    android:gravity="center_horizontal">

    <com.vn.jet.mosco.widget.MoscoButton
        android:id="@+id/btn_like"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        app:moscoStyle="primary"
        app:moscoSize="medium"
        android:text="@string/profile_btn_like"
        android:textStyle="bold" />

    <com.vn.jet.mosco.widget.MoscoButton
        android:id="@+id/btn_direct_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        app:moscoStyle="ghost"
        app:moscoSize="medium"
        android:text="@string/profile_btn_message"
        android:textStyle="bold" />

    <com.vn.jet.mosco.widget.MoscoButton
        android:id="@+id/btn_add_friend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:moscoStyle="primary"
        app:moscoSize="medium"
        android:text="@string/profile_btn_add_friend"
        android:textStyle="bold" />

    <!-- Nút Decline nhỏ (Dấu X) xuất hiện khi đang là người nhận lời mời (friendshipStatus = 3) -->
    <com.vn.jet.mosco.widget.MoscoButton
        android:id="@+id/btn_decline_request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        app:moscoStyle="ghost"
        app:moscoSize="medium"
        android:text="@string/social_action_decline"
        android:textColor="@color/palette_red_accent"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
