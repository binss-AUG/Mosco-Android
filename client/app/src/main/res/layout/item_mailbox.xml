<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/mosco_surface_container"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/mosco_outline_variant"
    app:strokeWidth="1dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_mail_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/mosco_surface_container_high"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_mail_item"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingVertical="10dp"
                android:paddingHorizontal="1dp"
                tools:src="@drawable/item_shop_demo" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_mail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins"
            tools:text="Rewards Box 1"
            android:textColor="@color/mosco_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_mail_qty"
            app:layout_constraintStart_toEndOf="@id/cv_mail_image"
            app:layout_constraintTop_toTopOf="@id/cv_mail_image" />

        <TextView
            android:id="@+id/tv_mail_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins"
            tools:text="Season Event Compensation"
            android:textColor="@color/mosco_on_surface_variant"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cv_mail_image"
            app:layout_constraintTop_toBottomOf="@id/tv_mail_title" />

        <LinearLayout
            android:id="@+id/ll_mail_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toEndOf="@id/cv_mail_image"
            app:layout_constraintTop_toBottomOf="@id/tv_mail_desc">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                app:tint="@color/mosco_on_surface_variant"
                android:src="@drawable/ic_time_clock" />
            
            <TextView
                android:id="@+id/tv_mail_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/poppins"
                tools:text="2H AGO"
                android:textColor="@color/mosco_on_surface_variant"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_mail_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_qty"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:fontFamily="@font/poppins"
            tools:text="x2"
            android:textColor="@color/mosco_primary_dim"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_mail_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_mail_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
