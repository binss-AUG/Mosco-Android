<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/white_05"
    app:cardCornerRadius="@dimen/lg_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/lg_outline"
    app:strokeWidth="@dimen/stroke_thin"
    app:cardPreventCornerOverlap="false"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Item Image -->
        <ImageView
            android:id="@+id/iv_shop_item_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingVertical="@dimen/spacing_10dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="@color/transparent"
            android:contentDescription="Shop item image"
            app:layout_constraintDimensionRatio="1:1.2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Rarity / Category Badge (top-right overlay) -->
        <TextView
            android:id="@+id/tv_shop_item_rarity"
            style="@style/MoscoText.Luxury.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_6dp"
            android:background="@drawable/bg_price_tag"
            android:paddingHorizontal="@dimen/spacing_6dp"
            android:paddingVertical="@dimen/spacing_2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="RARE" />

        <!-- Item Name -->
        <TextView
            android:id="@+id/tv_shop_item_name"
            style="@style/MoscoText.Luxury.Card.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_shop_item_image"
            tools:text="Cosmic Cape" />

        <!-- Item Description -->
        <TextView
            android:id="@+id/tv_shop_item_desc"
            style="@style/MoscoText.Luxury.Card.Desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:minLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shop_item_name"
            tools:text="Enhance your item collection." />

        <!-- Timer FOMO -->
        <TextView
            android:id="@+id/tv_shop_item_timer"
            style="@style/MoscoText.Luxury.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:minLines="1"
            android:textColor="@color/shop_timer_warning"
            android:textSize="@dimen/text_size_badge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shop_item_desc"
            tools:text="⏳ Ends in 6 days" />

        <!-- Divider: Ghost Border effect -->
        <View
            android:id="@+id/divider_shop_item"
            android:layout_width="0dp"
            android:layout_height="@dimen/stroke_thin"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@color/lg_outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shop_item_timer" />

        <!-- Price Row: currency icon + price + buy button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_price_row"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_shop_item">

            <!-- Currency Icon -->
            <ImageView
                android:id="@+id/iv_price_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_item_coin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="Currency" />

            <!-- Price Text -->
            <TextView
                android:id="@+id/tv_shop_item_price"
                style="@style/MoscoText.Luxury.Card.Price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="15sp"
                app:layout_constraintStart_toEndOf="@id/iv_price_icon"
                app:layout_constraintEnd_toStartOf="@id/btn_buy"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="250" />

            <!-- Buy Button -->
            <com.vn.jet.mosco.widget.MoscoButton
                android:id="@+id/btn_buy"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                app:moscoStyle="primary"
                app:moscoSize="small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="@string/shop_action_buy" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>


