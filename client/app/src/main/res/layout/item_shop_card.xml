<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/mosco_surface_container"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/mosco_outline_variant"
    app:strokeWidth="1dp"
    app:cardPreventCornerOverlap="false"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Item Image -->
        <ImageView
            android:id="@+id/iv_shop_item_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingVertical="10dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="@color/mosco_surface_container_high"
            android:contentDescription="Shop item image"
            app:layout_constraintDimensionRatio="1:1.2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Rarity / Category Badge (top-right overlay) -->
        <TextView
            android:id="@+id/tv_shop_item_rarity"
            style="@style/MoscoText.Luxury.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/bg_price_tag"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="RARE" />

        <!-- Item Name -->
        <TextView
            android:id="@+id/tv_shop_item_name"
            style="@style/MoscoText.Luxury.Card.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_shop_item_image"
            tools:text="Cosmic Cape" />

        <!-- Item Description -->
        <TextView
            android:id="@+id/tv_shop_item_desc"
            style="@style/MoscoText.Luxury.Card.Desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:minLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shop_item_name"
            tools:text="Enhance your item collection." />

        <!-- Timer FOMO -->
        <TextView
            android:id="@+id/tv_shop_item_timer"
            style="@style/MoscoText.Luxury.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:minLines="1"
            android:textColor="@color/shop_timer_warning"
            android:textSize="@dimen/text_size_badge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shop_item_desc"
            tools:text="⏳ Ends in 6 days" />

        <!-- Divider: Ghost Border effect -->
        <View
            android:id="@+id/divider_shop_item"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:background="@color/mosco_outline_variant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shop_item_timer" />

        <!-- Price Row: currency icon + price + buy button -->
        <LinearLayout
            android:id="@+id/ll_price_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_shop_item">

            <!-- Currency Icon -->
            <ImageView
                android:id="@+id/iv_price_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_item_coin"
                android:contentDescription="Currency" />

            <!-- Price Text -->
            <TextView
                android:id="@+id/tv_shop_item_price"
                style="@style/MoscoText.Luxury.Card.Price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                tools:text="250" />

            <!-- Buy Button -->
            <TextView
                android:id="@+id/btn_buy"
                style="@style/MoscoText.Luxury.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_shop_buy_btn"
                android:paddingHorizontal="30dp"
                android:paddingVertical="6dp"
                android:text="@string/shop_btn_buy"
                android:textColor="@color/mosco_on_surface" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
