<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_galactic"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp">

        <!-- Handle Bar (Chuẩn Glassmorphism) -->
        <View
            android:id="@+id/view_handle"
            android:layout_width="@dimen/handle_width"
            android:layout_height="@dimen/handle_height"
            android:background="@drawable/bg_bottomsheet_handle"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Tiêu đề BottomSheet chuyên nghiệp -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streak_header_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/view_handle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ngọn lửa Lottie chính giữa - Thu nhỏ 130dp cho sang trọng và cân đối -->
        <FrameLayout
            android:id="@+id/fl_streak_focal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_streak_icon"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/streak_animation"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />
        </FrameLayout>

        <!-- Khối chỉ số Streak dạng Glassmorphism Card hàng ngang cực kỳ cân xứng -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_streak_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:background="@drawable/bg_glass_card"
            app:layout_constraintTop_toBottomOf="@id/fl_streak_focal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/layout_current_streak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/view_divider"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/streak_label_current"
                    android:textColor="@color/white_40"
                    android:textSize="11sp"
                    android:fontFamily="@font/pretendard"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/placeholder_empty"
                    android:textColor="@color/galactic_accent_orange"
                    android:textSize="28sp"
                    android:fontFamily="@font/pretendard"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/view_divider"
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="@color/white_10"
                app:layout_constraintStart_toEndOf="@id/layout_current_streak"
                app:layout_constraintEnd_toStartOf="@id/layout_best_streak"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout
                android:id="@+id/layout_best_streak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/view_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/streak_label_best"
                    android:textColor="@color/white_40"
                    android:textSize="11sp"
                    android:fontFamily="@font/pretendard"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_best_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/placeholder_empty"
                    android:textColor="@color/lg_accent_secondary"
                    android:textSize="28sp"
                    android:fontFamily="@font/pretendard"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Khối Khiên bảo vệ Streak (Chuẩn Liquid Glass và MoscoButton) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_streak_shield"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="@dimen/lg_radius_card"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/layout_streak_stats"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/streak_label_shield"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/pretendard"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/streak_desc_shield"
                    android:textColor="@color/white_60"
                    android:textSize="11sp"
                    android:fontFamily="@font/pretendard"
                    android:layout_marginTop="4dp" />

                <com.vn.jet.mosco.widget.MoscoButton
                    android:id="@+id/btn_restore_streak"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/streak_action_restore"
                    app:moscoStyle="primary"
                    app:moscoSize="medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
