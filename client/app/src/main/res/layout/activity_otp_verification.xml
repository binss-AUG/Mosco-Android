<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background">

    <include layout="@layout/layout_auth_background" />

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/spacing_48dp"
        android:layout_height="@dimen/spacing_48dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:padding="@dimen/spacing_12dp"
        android:src="@drawable/ic_back_arrow"
        android:elevation="@dimen/spacing_xs"
        app:tint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_lg">

            <!-- Nhóm nội dung trung tâm - Canh giữa dọc và ngang chuyên nghiệp -->
            <LinearLayout
                android:id="@+id/center_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5">

                <!-- Shield Lock Icon -->
                <ImageView
                    android:id="@+id/iv_shield_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/tv_title_verify"
                    style="@style/MoscoText.Luxury.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/auth_title_verify"
                    android:textSize="@dimen/text_size_h1_xl" />

                <TextView
                    android:id="@+id/tv_subtitle_verify"
                    style="@style/MoscoText.Luxury.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:alpha="0.7"
                    android:textAlignment="center"
                    android:text="@string/auth_subtitle_verify"
                    android:textSize="@dimen/text_size_hud_small" />

                <LinearLayout
                    android:id="@+id/glass_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        style="@style/MoscoText.Luxury.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_label_verification_code"
                        android:textSize="@dimen/text_size_body_sm" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_verification_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/stat_atk"
                        app:errorIconDrawable="@null">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_verification_code"
                            style="@style/MoscoText.Luxury.Input"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height_compact"
                            android:background="@drawable/lg_input_bg"
                            android:drawableStart="@drawable/ic_shield_check"
                            android:drawablePadding="@dimen/spacing_15dp"
                            android:hint="@string/auth_prompt_verification_code"
                            android:inputType="number"
                            android:maxLength="6"
                            android:paddingStart="@dimen/spacing_md"
                            android:textCursorDrawable="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Resend Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/tv_timer_label"
                            style="@style/MoscoText.Luxury.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Didn't get code? "
                            android:textSize="@dimen/text_size_body_xs"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/btn_resend"
                            style="@style/MoscoText.Luxury.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_action_resend"
                            android:textSize="@dimen/text_size_body_xs"
                            android:focusable="true" />
                    </LinearLayout>

                    <com.vn.jet.mosco.widget.MoscoButton
                        android:id="@+id/btn_verify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:moscoStyle="primary"
                        app:moscoSize="large"
                        android:text="@string/auth_action_verify" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Overlay Loading -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loading_progress"
        android:layout_width="@dimen/spacing_120dp"
        android:layout_height="@dimen/spacing_120dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loading" />

</FrameLayout>
