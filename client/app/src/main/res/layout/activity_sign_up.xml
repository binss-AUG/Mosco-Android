<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mosco_screen_bg">

    <!-- Bối cảnh vũ trụ trôi nổi (Quản lý tập trung tại layout_auth_background) -->
    <include layout="@layout/layout_auth_background" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.06" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.94" />

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_circle_dark"
                android:focusable="true"
                android:nextFocusForward="@id/edt_username"
                android:padding="12dp"
                android:src="@drawable/ic_back_arrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Nhóm nội dung trung tâm - Căn giữa dọc -->
            <LinearLayout
                android:id="@+id/center_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/gl_end"
                app:layout_constraintStart_toStartOf="@id/gl_start"
                app:layout_constraintTop_toBottomOf="@+id/btn_back"
                app:layout_constraintVertical_bias="0.45">

                <TextView
                    android:id="@+id/tv_title_signup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/title_sign_up"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/glass_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Username -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/stat_atk"
                        app:errorIconDrawable="@null">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_username"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_glass_input"
                            android:drawableStart="@drawable/ic_user"
                            android:drawablePadding="15dp"
                            android:fontFamily="@font/poppins"
                            android:hint="@string/prompt_username"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:nextFocusForward="@id/edt_email"
                            android:paddingStart="15dp"
                            android:textColor="@color/white"
                            android:textColorHint="#80FFFFFF"
                            android:textCursorDrawable="@null"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/stat_atk"
                        app:errorIconDrawable="@null">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_email"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_glass_input"
                            android:drawableStart="@drawable/ic_email"
                            android:drawablePadding="15dp"
                            android:fontFamily="@font/poppins"
                            android:hint="@string/prompt_email"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:nextFocusForward="@id/edt_password"
                            android:paddingStart="15dp"
                            android:textColor="@color/white"
                            android:textColorHint="#80FFFFFF"
                            android:textCursorDrawable="@null"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:boxBackgroundMode="none"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/mosco_text_disabled"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/stat_atk"
                        app:errorIconDrawable="@null">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_password"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_glass_input"
                            android:drawableStart="@drawable/ic_lock"
                            android:drawablePadding="12dp"
                            android:fontFamily="@font/poppins"
                            android:hint="@string/prompt_password"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:nextFocusForward="@id/edt_confirm_password"
                            android:paddingEnd="15dp"
                            android:paddingStart="15dp"
                            android:textColor="@color/white"
                            android:textColorHint="#80FFFFFF"
                            android:textCursorDrawable="@null"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirm Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:boxBackgroundMode="none"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/mosco_text_disabled"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/stat_atk"
                        app:errorIconDrawable="@null">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_glass_input"
                            android:drawableStart="@drawable/ic_lock"
                            android:drawablePadding="12dp"
                            android:fontFamily="@font/poppins"
                            android:hint="@string/prompt_confirm_password"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:nextFocusForward="@id/btn_send_code"
                            android:paddingEnd="15dp"
                            android:paddingStart="15dp"
                            android:textColor="@color/white"
                            android:textColorHint="#80FFFFFF"
                            android:textCursorDrawable="@null"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Verification Code -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_verification_code"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            app:boxBackgroundMode="none"
                            app:hintEnabled="false"
                            app:errorEnabled="true"
                            app:errorTextColor="@color/stat_atk"
                            app:errorIconDrawable="@null"
                            app:layout_constraintEnd_toStartOf="@+id/btn_send_code"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_verification_code"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_glass_input"
                                android:fontFamily="@font/poppins"
                                android:hint="@string/prompt_verification_code"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:maxLength="6"
                                android:maxLines="1"
                                android:nextFocusForward="@id/btn_signup"
                                android:paddingStart="15dp"
                                android:textColor="@color/white"
                                android:textColorHint="#80FFFFFF"
                                android:textCursorDrawable="@null"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_send_code"
                            android:layout_width="100dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_shop_buy_btn"
                            android:fontFamily="@font/poppins"
                            android:text="@string/action_send_code"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Sign Up Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_signup"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_btn_rainbow"
                        android:fontFamily="@font/poppins"
                        android:nextFocusForward="@id/tv_go_to_signin"
                        android:text="@string/action_sign_up"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:elevation="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_go_to_signin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:focusable="true"
                    android:fontFamily="@font/poppins"
                    android:nextFocusForward="@id/btn_back"
                    android:text="@string/msg_already_have_account"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/mosco_primary"
        android:visibility="gone" />

</FrameLayout>
