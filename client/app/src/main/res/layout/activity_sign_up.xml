<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background">

    <include layout="@layout/layout_auth_background" />

    <!-- Back Button (Quay vá» Sign In) -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/spacing_48dp"
        android:layout_height="@dimen/spacing_48dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:padding="@dimen/spacing_12dp"
        android:src="@drawable/ic_back_arrow"
        android:elevation="@dimen/spacing_xs"
        app:tint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_lg">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.06" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.94" />



            <!-- Nhóm nội dung trung tâm - Căn lề trên để chống cắt chữ trên màn hình nhỏ -->
            <LinearLayout
                android:id="@+id/center_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/gl_end"
                app:layout_constraintStart_toStartOf="@id/gl_start"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0">

                <TextView
                    android:id="@+id/tv_title_signup"
                    style="@style/MoscoText.Luxury.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/auth_title_sign_up"
                    android:textSize="@dimen/text_size_h1_xl" />

                <TextView
                    android:id="@+id/tv_subtitle_signup"
                    style="@style/MoscoText.Luxury.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:alpha="0.7"
                    android:text="@string/auth_subtitle_sign_up"
                    android:textSize="@dimen/text_size_hud_small" />

                <LinearLayout
                    android:id="@+id/glass_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <!-- Username -->
                    <TextView
                        android:id="@+id/tv_label_username"
                        style="@style/MoscoText.Luxury.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_label_username" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/stat_atk"
                        app:errorIconDrawable="@null">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_username"
                            style="@style/MoscoText.Luxury.Input"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height_compact"
                            android:background="@drawable/lg_input_bg"
                            android:drawableStart="@drawable/ic_user"
                            android:drawablePadding="@dimen/spacing_15dp"
                            android:hint="@string/auth_prompt_username"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:nextFocusForward="@id/edt_email"
                            android:paddingStart="@dimen/spacing_15dp"
                            android:textCursorDrawable="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <TextView
                        android:id="@+id/tv_label_email"
                        style="@style/MoscoText.Luxury.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/auth_label_email" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_email"
                        style="@style/MoscoTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/stat_atk"
                        app:errorIconDrawable="@null">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_email"
                            style="@style/MoscoText.Luxury.Input"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height_compact"
                            android:background="@drawable/lg_input_bg"
                            android:drawableStart="@drawable/ic_email"
                            android:drawablePadding="@dimen/spacing_15dp"
                            android:hint="@string/auth_prompt_email"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:nextFocusForward="@id/edt_password"
                            android:paddingStart="@dimen/spacing_15dp"
                            android:textCursorDrawable="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <TextView
                        android:id="@+id/tv_label_password"
                        style="@style/MoscoText.Luxury.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/auth_label_password" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        app:boxBackgroundMode="none"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/mosco_white_30"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/stat_atk"
                        app:errorIconDrawable="@null">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_password"
                            style="@style/MoscoText.Luxury.Input"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height_compact"
                            android:background="@drawable/lg_input_bg"
                            android:drawableStart="@drawable/ic_lock"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:hint="@string/auth_prompt_password"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:nextFocusForward="@id/edt_confirm_password"
                            android:paddingEnd="@dimen/spacing_15dp"
                            android:paddingStart="@dimen/spacing_15dp"
                            android:textCursorDrawable="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirm Password -->
                    <TextView
                        android:id="@+id/tv_label_confirm_password"
                        style="@style/MoscoText.Luxury.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/auth_label_confirm_password" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        app:boxBackgroundMode="none"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/mosco_white_30"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:errorTextColor="@color/stat_atk"
                        app:errorIconDrawable="@null">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_confirm_password"
                            style="@style/MoscoText.Luxury.Input"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height_compact"
                            android:background="@drawable/lg_input_bg"
                            android:drawableStart="@drawable/ic_lock"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:hint="@string/auth_prompt_confirm_password"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:nextFocusForward="@id/btn_send_code"
                            android:paddingEnd="@dimen/spacing_15dp"
                            android:paddingStart="@dimen/spacing_15dp"
                            android:textCursorDrawable="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Verification Code -->
                    <TextView
                        android:id="@+id/tv_label_verification_code"
                        style="@style/MoscoText.Luxury.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/auth_label_verification_code" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_verification_code"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            app:boxBackgroundMode="none"
                            app:hintEnabled="false"
                            app:errorEnabled="true"
                            app:errorTextColor="@color/stat_atk"
                            app:errorIconDrawable="@null"
                            app:layout_constraintEnd_toStartOf="@+id/btn_send_code"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_verification_code"
                                style="@style/MoscoText.Luxury.Input"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height_compact"
                                android:background="@drawable/lg_input_bg"
                                android:drawableStart="@drawable/ic_shield_check"
                                android:drawablePadding="@dimen/spacing_15dp"
                                android:hint="@string/auth_prompt_verification_code"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:maxLength="6"
                                android:maxLines="1"
                                android:nextFocusForward="@id/btn_signup"
                                android:paddingStart="@dimen/spacing_15dp"
                                android:textCursorDrawable="@null" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.vn.jet.mosco.widget.MoscoButton
                            android:id="@+id/btn_send_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/spacing_100dp"
                            app:moscoStyle="secondary"
                            app:moscoSize="medium"
                            android:text="@string/auth_action_send_code"
                            app:layout_constraintBottom_toBottomOf="@+id/til_verification_code"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/til_verification_code"
                            app:layout_constraintVertical_bias="0.0" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Sign Up Button -->
                    <com.vn.jet.mosco.widget.MoscoButton
                        android:id="@+id/btn_signup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:nextFocusForward="@id/tv_go_to_signin"
                        app:moscoStyle="primary"
                        app:moscoSize="large"
                        android:text="@string/auth_action_sign_up" />

                    <!-- OR Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/stroke_thin"
                            android:layout_weight="1"
                            android:background="@color/white_10" />

                        <TextView
                            style="@style/MoscoText.Luxury.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/spacing_md"
                            android:text="@string/auth_label_or_continue"
                            android:textSize="@dimen/text_size_body_xs" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/stroke_thin"
                            android:layout_weight="1"
                            android:background="@color/white_10" />
                    </LinearLayout>

                    <!-- Social Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_google"
                            android:layout_width="@dimen/social_button_size_compact"
                            android:layout_height="@dimen/social_button_size_compact"
                            android:layout_marginHorizontal="@dimen/spacing_sm"
                            android:background="@drawable/bg_btn_social_glass"
                            android:padding="@dimen/social_icon_padding_compact"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_google"
                            android:stateListAnimator="@animator/luxury_button_state_animator" />

                        <ImageButton
                            android:id="@+id/btn_discord"
                            android:layout_width="@dimen/social_button_size_compact"
                            android:layout_height="@dimen/social_button_size_compact"
                            android:layout_marginHorizontal="@dimen/spacing_sm"
                            android:background="@drawable/bg_btn_social_glass"
                            android:padding="@dimen/social_icon_padding_compact"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_discord"
                            android:stateListAnimator="@animator/luxury_button_state_animator" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_go_to_signin"
                    style="@style/MoscoText.Luxury.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:focusable="true"
                    android:nextFocusForward="@id/btn_back"
                    android:text="@string/auth_msg_already_have_account"
                    android:textSize="@dimen/text_size_body_lg" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loading_progress"
        android:layout_width="@dimen/spacing_120dp"
        android:layout_height="@dimen/spacing_120dp"
        android:layout_gravity="center"
        app:lottie_rawRes="@raw/loading"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:visibility="gone" />

</FrameLayout>


