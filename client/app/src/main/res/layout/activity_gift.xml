<?xml version="1.0" encoding="utf-8"?>
<!-- GiftActivity — Giao diện gửi/nhận Objet giữa các user -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_gift_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lg_background_deep">

    <!-- ═══ HEADER ═══ -->
    <!-- Standard Common Header -->
    <include
        android:id="@+id/layout_header_gift_container"
        layout="@layout/layout_common_header"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_daily_remaining_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_reveal_result_card_margin_horizontal"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_header_gift_container"
        app:layout_constraintBottom_toBottomOf="@id/layout_header_gift_container">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/social_label_gift_limit"
            style="@style/MoscoText.Luxury.Badge"
            android:textColor="@color/mosco_white_30"
            android:textSize="@dimen/text_size_body_xs"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_daily_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/5"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="@color/lg_accent_primary"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══ TAB LAYOUT: GỬI | NHẬN ═══ -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_gift"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header_gift_container"
        app:tabIndicatorColor="@color/lg_accent_primary"
        app:tabIndicatorHeight="0dp"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="@color/lg_accent_primary"
        app:tabTextColor="@color/mosco_white_30"
        app:tabRippleColor="@null"
        app:tabMaxWidth="0dp"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- ═══ CONTENT AREA ═══ -->
    <FrameLayout
        android:id="@+id/fl_gift_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/tab_layout_gift"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ═══ TAB 1: GỬI TẶNG (Send Wizard) ═══ -->
        <LinearLayout
            android:id="@+id/layout_tab_send"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Step Indicator -->
            <LinearLayout
                android:id="@+id/layout_step_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tv_step_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gift_step_1"
                    style="@style/MoscoText.Luxury.Badge"
                    android:textColor="@color/lg_accent_primary"
                    android:textSize="@dimen/text_size_body_xs"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:textStyle="bold" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/mosco_white_20" />

                <TextView
                    android:id="@+id/tv_step_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gift_step_2"
                    style="@style/MoscoText.Luxury.Badge"
                    android:textColor="@color/mosco_white_30"
                    android:textSize="@dimen/text_size_body_xs"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Step Content Container -->
            <FrameLayout
                android:id="@+id/fl_step_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- STEP 1: Chọn Objet từ Inventory -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_step1_select_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible">

                    <!-- Card Preview (sau khi chọn) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_selected_card"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintWidth_percent="0.65"
                        app:layout_constraintDimensionRatio="H,1:1.54"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/btn_step1_next"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:cardCornerRadius="@dimen/spacing_md"
                        app:cardElevation="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/lg_glass_surface_high"
                        app:strokeColor="@color/mosco_white_20"
                        app:strokeWidth="@dimen/stroke_thin"
                        android:visibility="gone">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <include layout="@layout/layout_core_card" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Placeholder button khi chưa chọn -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_select_card_btn"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintWidth_percent="0.65"
                        app:layout_constraintDimensionRatio="H,1:1.54"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/btn_step1_next"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:cardCornerRadius="@dimen/spacing_md"
                        app:cardElevation="@dimen/spacing_10dp"
                        app:cardBackgroundColor="@color/lg_glass_surface_elevated"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <FrameLayout
                                android:layout_width="@dimen/spacing_60dp"
                                android:layout_height="@dimen/spacing_60dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_dark">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="+"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_h1_xl" />
                            </FrameLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_selected_card_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/radius_lg"
                        style="@style/MoscoText.Luxury.Body"
                        android:textColor="@color/palette_gray_300"
                        android:textSize="@dimen/text_size_badge"
                        android:textAlignment="center"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/cv_selected_card"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Next Button -->
                    <com.vn.jet.mosco.widget.MoscoButton
                        android:id="@+id/btn_step1_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:layout_marginHorizontal="@dimen/item_reveal_result_card_margin_horizontal"
                        android:text="@string/action_next"
                        app:moscoStyle="primary"
                        app:moscoSize="large"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- STEP 2: Chọn Bạn bè -->
                <LinearLayout
                    android:id="@+id/layout_step2_select_friend"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_20dp"
                    android:visibility="gone">

                    <!-- Search Bar (Synced with Friend Activity) -->
                    <com.vn.jet.mosco.view.MoscoSearchBar
                        android:id="@+id/search_bar_gift_friend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginHorizontal="@dimen/spacing_xs" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_friend_select"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/spacing_md" />

                    <TextView
                        android:id="@+id/tv_no_friends"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/gift_empty_friends"
                        style="@style/MoscoText.Luxury.Body"
                        android:textColor="@color/mosco_white_30"
                        android:textSize="@dimen/text_size_body_md"
                        android:visibility="gone" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:layout_marginHorizontal="@dimen/item_reveal_result_card_margin_horizontal"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Previous -->
                        <com.vn.jet.mosco.widget.MoscoButton
                            android:id="@+id/btn_step2_prev"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="@string/action_previous"
                            app:moscoStyle="secondary"
                            app:moscoSize="large" />

                        <!-- Next Button -->
                        <com.vn.jet.mosco.widget.MoscoButton
                            android:id="@+id/btn_step2_next"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="@string/social_dialog_action_send"
                            app:moscoStyle="primary"
                            app:moscoSize="large"
                            android:alpha="0.5" />
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>

            <!-- ═══ SUCCESS SCREEN (Giao dịch thành công) ═══ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_success_screen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <!-- 1. Tick Circle, Status & Timestamp in a top container -->
                <LinearLayout
                    android:id="@+id/layout_success_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Tick Icon (70% size of 64dp/32dp -> 45dp/22dp) -->
                    <FrameLayout
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/bg_circle_white"
                        android:backgroundTint="#4CAF50">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <!-- Status Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="TRANSFER SUCCESSFUL"
                        style="@style/MoscoText.Luxury.Body"
                        android:textColor="#4CAF50"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:gravity="center" />

                    <!-- Card Info Line (IN HOA, ví dụ KAEDE BINARY02 205Z +1) -->
                    <TextView
                        android:id="@+id/tv_success_card_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginHorizontal="24dp"
                        android:text="KAEDE BINARY02 205Z +1"
                        style="@style/MoscoText.Luxury.Body"
                        android:textColor="#4CAF50"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:gravity="center" />

                    <!-- Timestamp -->
                    <TextView
                        android:id="@+id/tv_success_timestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="19:36 Mon 18/05/2026"
                        style="@style/MoscoText.Luxury.Badge"
                        android:textColor="@color/mosco_white_30"
                        android:textSize="@dimen/text_size_caption"
                        android:gravity="center" />
                </LinearLayout>

                <!-- 2. Centered Card Object Preview (130% size -> 208dp / 320dp) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_success_selected_card"
                    android:layout_width="208dp"
                    android:layout_height="320dp"
                    app:cardCornerRadius="@dimen/spacing_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/lg_glass_surface_high"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toBottomOf="@id/layout_success_top"
                    app:layout_constraintBottom_toTopOf="@id/layout_success_info_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_chainStyle="packed">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include layout="@layout/layout_core_card" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Transaction Details container -->
                <LinearLayout
                    android:id="@+id/layout_success_info_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="36dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/cv_success_selected_card"
                    app:layout_constraintBottom_toTopOf="@id/layout_success_buttons"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Line 2: Sender Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tv_success_sender_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="FROM:"
                            style="@style/MoscoText.Luxury.Badge"
                            android:textColor="@color/mosco_white_30"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_success_sender_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="cc3m"
                            style="@style/MoscoText.Luxury.Badge"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Line 3: Receiver Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tv_success_receiver_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="TO:"
                            style="@style/MoscoText.Luxury.Badge"
                            android:textColor="@color/mosco_white_30"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_success_receiver_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="prime"
                            style="@style/MoscoText.Luxury.Badge"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- 4. Footer Action Buttons (Matched with Step 2 size/position) -->
                <LinearLayout
                    android:id="@+id/layout_success_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:layout_marginHorizontal="@dimen/item_reveal_result_card_margin_horizontal"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- COLLECT Button -->
                    <com.vn.jet.mosco.widget.MoscoButton
                        android:id="@+id/btn_success_collect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="COLLECT"
                        app:moscoStyle="secondary"
                        app:moscoSize="large" />

                    <!-- NEW GIFT Button -->
                    <com.vn.jet.mosco.widget.MoscoButton
                        android:id="@+id/btn_success_new_gift"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="NEW GIFT"
                        app:moscoStyle="primary"
                        app:moscoSize="large" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- ═══ TAB 2: NHẬN (Received Inbox) ═══ -->
        <LinearLayout
            android:id="@+id/layout_tab_received"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_20dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_gift_received"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/spacing_md" />

            <TextView
                android:id="@+id/tv_no_gifts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/gift_empty_received"
                style="@style/MoscoText.Luxury.Body"
                android:textColor="@color/mosco_white_30"
                android:textSize="@dimen/text_size_body_md"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>




