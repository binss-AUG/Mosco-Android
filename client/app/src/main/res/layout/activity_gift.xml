<?xml version="1.0" encoding="utf-8"?>
<!-- GiftActivity — Giao diện gửi/nhận Objet giữa các user -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_global_gradient">

    <!-- ═══ HEADER ═══ -->
    <!-- Standard Galactic Header (Synced with Friend) -->
    <include
        android:id="@+id/layout_header_gift_container"
        layout="@layout/layout_galactic_header"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_daily_remaining_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_reveal_result_card_margin_horizontal"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_header_gift_container"
        app:layout_constraintBottom_toBottomOf="@id/layout_header_gift_container">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/social_label_gift_limit"
            style="@style/MoscoText.Luxury.Badge"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_body_xs"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_daily_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/5"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="@color/mosco_primary"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══ TAB LAYOUT: GỬI | NHẬN ═══ -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_gift"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header_gift_container"
        app:tabIndicatorColor="@color/mosco_primary"
        app:tabIndicatorHeight="@dimen/spacing_xs"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="@color/mosco_primary"
        app:tabTextColor="@color/mosco_text_disabled"
        app:tabRippleColor="@null"
        app:tabMaxWidth="0dp"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- ═══ CONTENT AREA ═══ -->
    <FrameLayout
        android:id="@+id/fl_gift_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_xs"
        app:layout_constraintTop_toBottomOf="@id/tab_layout_gift"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ═══ TAB 1: GỬI TẶNG (Send Wizard) ═══ -->
        <LinearLayout
            android:id="@+id/layout_tab_send"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Step Indicator -->
            <LinearLayout
                android:id="@+id/layout_step_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="@dimen/radius_lg">

                <TextView
                    android:id="@+id/tv_step_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gift_step_1"
                    style="@style/MoscoText.Luxury.Badge"
                    android:textColor="@color/mosco_primary"
                    android:textSize="@dimen/text_size_body_md"
                    android:textStyle="bold" />

                <View
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:background="@color/mosco_white_20" />

                <TextView
                    android:id="@+id/tv_step_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gift_step_2"
                    style="@style/MoscoText.Luxury.Badge"
                    android:textColor="@color/mosco_text_disabled"
                    android:textSize="@dimen/text_size_body_md"
                    android:textStyle="bold" />

                <View
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:background="@color/mosco_white_20" />

                <TextView
                    android:id="@+id/tv_step_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gift_step_3"
                    style="@style/MoscoText.Luxury.Badge"
                    android:textColor="@color/mosco_text_disabled"
                    android:textSize="@dimen/text_size_body_md"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Step Content Container -->
            <FrameLayout
                android:id="@+id/fl_step_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- STEP 1: Chọn Objet từ Inventory -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_step1_select_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible">

                    <!-- Card Preview (sau khi chọn) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_selected_card"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintWidth_percent="0.65"
                        app:layout_constraintDimensionRatio="H,1:1.54"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:cardCornerRadius="@dimen/spacing_md"
                        app:cardElevation="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/mosco_card_bg_variant"
                        app:strokeColor="@color/mosco_white_20"
                        app:strokeWidth="@dimen/stroke_thin"
                        android:visibility="gone">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <include layout="@layout/layout_core_card" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Placeholder button khi chưa chọn -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_select_card_btn"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintWidth_percent="0.65"
                        app:layout_constraintDimensionRatio="H,1:1.54"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:cardCornerRadius="@dimen/spacing_md"
                        app:cardElevation="@dimen/spacing_10dp"
                        app:cardBackgroundColor="@color/mosco_card_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <FrameLayout
                                android:layout_width="@dimen/spacing_60dp"
                                android:layout_height="@dimen/spacing_60dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_dark">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="+"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_h1_xl" />
                            </FrameLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_selected_card_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/radius_lg"
                        style="@style/MoscoText.Luxury.Body"
                        android:textColor="@color/palette_gray_300"
                        android:textSize="@dimen/text_size_badge"
                        android:textAlignment="center"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/cv_selected_card"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Next Button -->
                    <com.vn.jet.mosco.widget.MoscoButton
                        android:id="@+id/btn_step1_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:layout_marginHorizontal="@dimen/item_reveal_result_card_margin_horizontal"
                        android:text="@string/action_next"
                        app:moscoStyle="primary"
                        app:moscoSize="large"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- STEP 2: Chọn Bạn bè -->
                <LinearLayout
                    android:id="@+id/layout_step2_select_friend"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_20dp"
                    android:visibility="gone">

                    <!-- Search Bar (Synced with Friend Activity) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_gift_search_friend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginHorizontal="@dimen/spacing_xs"
                        app:cardCornerRadius="@dimen/radius_lg"
                        app:cardElevation="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/mosco_card_bg"
                        app:strokeColor="@color/galactic_accent_purple"
                        app:strokeWidth="@dimen/stroke_thin">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingVertical="@dimen/spacing_sm">

                            <ImageView
                                android:layout_width="@dimen/spacing_20dp"
                                android:layout_height="@dimen/spacing_20dp"
                                android:src="@drawable/ic_search"
                                app:tint="@color/galactic_accent_purple" />

                            <EditText
                                android:id="@+id/et_gift_search_friend"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/radius_lg"
                                android:hint="@string/social_search_hint"
                                android:textColorHint="@color/mosco_text_disabled"
                                android:textColor="@color/white"
                                style="@style/MoscoText.Luxury.Body"
                                android:textSize="@dimen/text_size_body_md"
                                android:background="@null"
                                android:singleLine="true"
                                android:imeOptions="actionSearch"
                                android:inputType="text" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_friend_select"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/spacing_80dp" />

                    <TextView
                        android:id="@+id/tv_no_friends"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/gift_empty_friends"
                        style="@style/MoscoText.Luxury.Body"
                        android:textColor="@color/mosco_text_disabled"
                        android:textSize="@dimen/text_size_body_md"
                        android:visibility="gone" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:layout_marginHorizontal="@dimen/item_reveal_result_card_margin_horizontal"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Previous -->
                        <com.vn.jet.mosco.widget.MoscoButton
                            android:id="@+id/btn_step2_prev"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="@string/action_previous"
                            app:moscoStyle="secondary"
                            app:moscoSize="large" />

                        <!-- Next Button -->
                        <com.vn.jet.mosco.widget.MoscoButton
                            android:id="@+id/btn_step2_next"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="@string/action_next"
                            app:moscoStyle="primary"
                            app:moscoSize="large"
                            android:alpha="0.5" />
                    </LinearLayout>
                </LinearLayout>

                <!-- STEP 3: Xác nhận & Gửi -->
                <LinearLayout
                    android:id="@+id/layout_step3_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_xl"
                    android:visibility="gone">

                    <!-- Avatars & XML Arrows Container (No card here as requested) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_64dp">

                        <!-- Sender (Left) -->
                        <LinearLayout
                            android:id="@+id/layout_confirm_sender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/iv_confirm_arrows"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintHorizontal_chainStyle="packed">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="@dimen/spacing_64dp"
                                android:layout_height="@dimen/spacing_64dp"
                                app:cardCornerRadius="@dimen/spacing_xl"
                                app:cardElevation="@dimen/spacing_xs"
                                app:strokeWidth="1.5dp"
                                app:strokeColor="@color/palette_green_forest">
                                <ImageView
                                    android:id="@+id/iv_sender_avatar_img"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_user"
                                    android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tv_sender_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="You"
                                style="@style/MoscoText.Luxury.Badge"
                                android:textColor="@color/palette_gray_300"
                                android:textSize="@dimen/text_size_caption"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- XML Arrows (Triple Neon) -->
                        <ImageView
                            android:id="@+id/iv_confirm_arrows"
                            android:layout_width="@dimen/spacing_60dp"
                            android:layout_height="@dimen/spacing_lg"
                            android:layout_marginHorizontal="@dimen/spacing_lg"
                            android:src="@drawable/ic_triple_arrow_neon"
                            app:layout_constraintStart_toEndOf="@id/layout_confirm_sender"
                            app:layout_constraintEnd_toStartOf="@+id/layout_confirm_receiver"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <!-- Receiver (Right) -->
                        <LinearLayout
                            android:id="@+id/layout_confirm_receiver"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            app:layout_constraintStart_toEndOf="@id/iv_confirm_arrows"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="@dimen/spacing_64dp"
                                android:layout_height="@dimen/spacing_64dp"
                                app:cardCornerRadius="@dimen/spacing_xl"
                                app:cardElevation="@dimen/spacing_xs"
                                app:strokeWidth="1.5dp"
                                app:strokeColor="@color/palette_red_accent">
                                <ImageView
                                    android:id="@+id/iv_confirm_friend_avatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_user"
                                    android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tv_confirm_friend_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                style="@style/MoscoText.Luxury.Badge"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_caption"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Phí gửi -->
                    <LinearLayout
                        android:id="@+id/layout_gift_cost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:gravity="center"
                        android:background="@drawable/bg_header_glass_v2"
                        android:paddingVertical="@dimen/radius_lg"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gift_label_cost"
                            style="@style/MoscoText.Luxury.Badge"
                            android:textColor="@color/mosco_text_disabled"
                            android:textSize="@dimen/text_size_mini"
                            android:textStyle="bold"
                            android:fontWeight="700"
                            android:letterSpacing="0.1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/spacing_20dp"
                                android:layout_height="@dimen/spacing_20dp"
                                android:src="@drawable/ic_item_coin" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:text="36,000"
                                style="@style/MoscoText.Luxury.Body"
                                android:textColor="@color/mosco_primary"
                                android:textSize="@dimen/text_size_body_md"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/spacing_sm"
                                android:text="+"
                                android:textColor="#555555" />

                            <ImageView
                                android:layout_width="@dimen/spacing_md"
                                android:layout_height="@dimen/spacing_md"
                                android:src="@drawable/ic_item_diamond" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:text="36"
                                style="@style/MoscoText.Luxury.Body"
                                android:textColor="@color/palette_cyan_neon"
                                android:textSize="@dimen/text_size_body_md"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:id="@+id/layout_confirm_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:layout_marginHorizontal="@dimen/item_reveal_result_card_margin_horizontal"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Cancel -->
                        <com.vn.jet.mosco.widget.MoscoButton
                            android:id="@+id/btn_confirm_cancel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="@string/action_previous"
                            app:moscoStyle="secondary"
                            app:moscoSize="large" />

                        <!-- Send Button -->
                        <com.vn.jet.mosco.widget.MoscoButton
                            android:id="@+id/btn_confirm_send"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="@string/gift_action_send"
                            app:moscoStyle="primary"
                            app:moscoSize="large" />
                    </LinearLayout>

                    <!-- DONE Button (Hidden until success) -->
                    <com.vn.jet.mosco.widget.MoscoButton
                        android:id="@+id/btn_confirm_done"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:layout_marginHorizontal="@dimen/item_reveal_result_card_margin_horizontal"
                        android:text="@string/action_done"
                        app:moscoStyle="primary"
                        app:moscoSize="large"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ═══ TAB 2: NHẬN (Received Inbox) ═══ -->
        <LinearLayout
            android:id="@+id/layout_tab_received"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_20dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_gift_received"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/spacing_md" />

            <TextView
                android:id="@+id/tv_no_gifts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/gift_empty_received"
                style="@style/MoscoText.Luxury.Body"
                android:textColor="@color/mosco_text_disabled"
                android:textSize="@dimen/text_size_body_md"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>




