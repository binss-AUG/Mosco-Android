<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="@dimen/spacing_lg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingVertical="@dimen/spacing_xl">

    <!-- Container tỷ lệ vé 1:1.75 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ticket_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintDimensionRatio="1:1.75"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Nền Ticket -->
        <com.vn.jet.mosco.utils.TicketBackgroundView
            android:id="@+id/ticket_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Đường cơ sở khuyết tròn (đọc tỉ lệ từ resource, không hardcode) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_notch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.75" />

        <!-- Nút đóng -->
        <ImageView
            android:id="@+id/btn_close_collection_detail"
            android:layout_width="@dimen/spacing_xl"
            android:layout_height="@dimen/spacing_xl"
            android:src="@drawable/ic_close"
            android:padding="@dimen/spacing_xs"
            android:layout_margin="@dimen/radius_lg"
            app:tint="@color/mosco_white_60"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Name Tag Bubble (Top Position - Balanced Premium Style) -->
        <TextView
            android:id="@+id/tv_detail_card_name"
            style="@style/MoscoText.Luxury"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card_name_tag"
            android:paddingHorizontal="@dimen/spacing_16dp"
            android:paddingVertical="@dimen/spacing_4dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btn_close_collection_detail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="SeoAh A2 316Z" />

        <!-- Vùng chứa thẻ bài (Shrunk variant for Modern Look) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_album_card_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginHorizontal="@dimen/card_detail_margin_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintDimensionRatio="1:1.54"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_card_name"
            app:layout_constraintBottom_toTopOf="@id/guide_notch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardBackgroundColor="@color/mosco_card_bg"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/spacing_sm">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Unified Card Content -->
                <include layout="@layout/layout_core_card" />

                <!-- Lock Icon (Góc trên phải) -->
                <ImageView
                    android:id="@+id/iv_detail_lock"
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/ic_lock"
                    android:layout_margin="@dimen/spacing_sm"
                    app:tint="@color/mosco_gold"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Back Face -->
                <ImageView
                    android:id="@+id/iv_collection_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/objet_back_spin"
                    android:visibility="gone" />

                <!-- Locked Overlay (Phủ xám + Mặt buồn khóc) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_locked_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/mosco_card_bg"
                    android:visibility="gone"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_locked_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(╥﹏╥)"
                        android:textColor="@color/mosco_white_30"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintVertical_bias="0.45" />

                    <TextView
                        android:id="@+id/tv_locked_sad_notice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/collection_album_not_collected"
                        android:textColor="@color/mosco_white_40"
                        android:textSize="@dimen/text_size_body_xs"
                        android:textStyle="bold"
                        android:fontWeight="700"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        style="@style/MoscoText.Luxury.Body"
                        app:layout_constraintTop_toBottomOf="@id/tv_locked_emoji"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="@dimen/radius_lg" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/divider_ticket"
            android:layout_width="0dp"
            android:layout_height="@dimen/stroke_thin"
            android:layout_marginHorizontal="@dimen/spacing_20dp"
            android:background="@color/mosco_white_15"
            app:layout_constraintTop_toTopOf="@id/guide_notch"
            app:layout_constraintBottom_toBottomOf="@id/guide_notch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Cụm Content dưới -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_md"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@id/guide_notch"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Hệ thống Ghost Buttons (Dọc) -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Container cho Thẻ CHƯA sở hữu -->
                    <LinearLayout
                        android:id="@+id/layout_buttons_locked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include
                            android:id="@+id/item_btn_spin"
                            layout="@layout/item_ghost_menu" />

                        <View android:layout_width="match_parent" android:layout_height="@dimen/spacing_sm" />

                        <include
                            android:id="@+id/item_btn_shop"
                            layout="@layout/item_ghost_menu" />
                    </LinearLayout>

                    <!-- Container cho Thẻ ĐÃ sở hữu -->
                    <LinearLayout
                        android:id="@+id/layout_buttons_owned"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include
                            android:id="@+id/item_btn_take_photo"
                            layout="@layout/item_ghost_menu" />

                        <!-- Tương tác Get more (Chỉ hiện khi đã từng có nhưng hiện tại kho đồ trống) -->
                        <LinearLayout
                            android:id="@+id/layout_get_more_expandable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:visibility="gone"
                            android:layout_marginTop="@dimen/spacing_xs">

                            <LinearLayout
                                android:id="@+id/btn_get_more_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="@dimen/spacing_sm"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/action_get_more"
                                    android:textColor="@color/mosco_white_60"
                                    android:textSize="@dimen/text_size_body_xs"
                                    android:textStyle="bold"
                                    android:fontWeight="700"
                                    style="@style/MoscoText.Luxury.Body" />

                                <ImageView
                                    android:id="@+id/iv_get_more_arrow"
                                    android:layout_width="@dimen/spacing_14dp"
                                    android:layout_height="@dimen/spacing_14dp"
                                    android:layout_marginStart="@dimen/spacing_xs"
                                    android:src="@drawable/ic_arrow_down"
                                    app:tint="@color/mosco_white_60" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layout_get_more_content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone"
                                android:alpha="0"
                                android:layout_marginTop="@dimen/spacing_xs">

                                <include
                                    android:id="@+id/item_btn_shop_secondary"
                                    layout="@layout/item_ghost_menu" />

                                <View android:layout_width="match_parent" android:layout_height="@dimen/spacing_sm" />

                                <include
                                    android:id="@+id/item_btn_spin_secondary"
                                    layout="@layout/item_ghost_menu" />
                            </LinearLayout>
                        </LinearLayout>

                        <View 
                            android:id="@+id/spacer_owned_1"
                            android:layout_width="match_parent" 
                            android:layout_height="@dimen/spacing_sm" />

                        <include
                            android:id="@+id/item_btn_send"
                            layout="@layout/item_ghost_menu" />

                        <View 
                            android:id="@+id/spacer_owned_2"
                            android:layout_width="match_parent" 
                            android:layout_height="@dimen/spacing_sm" />

                        <include
                            android:id="@+id/item_btn_upgrade"
                            layout="@layout/item_ghost_menu" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>




