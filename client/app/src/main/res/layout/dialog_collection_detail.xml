<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- [LIQUID GLASS] Main Background Surface (Obsidian Obsidian) -->
    <View
        android:id="@+id/dialog_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/lg_glass_dialog_bg" />

    <!-- Drag Handle (Pull down to dismiss) -->
    <View
        android:id="@+id/view_drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@color/lg_glass_stroke_strong"
        android:alpha="0.5"
        app:layout_constraintTop_toTopOf="@id/dialog_glass_bg"
        app:layout_constraintStart_toStartOf="@id/dialog_glass_bg"
        app:layout_constraintEnd_toEndOf="@id/dialog_glass_bg" />

    <!-- ═══ TOP CONTROL BAR ═══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/view_drag_handle"
        app:layout_constraintStart_toStartOf="@id/dialog_glass_bg"
        app:layout_constraintEnd_toEndOf="@id/dialog_glass_bg">

        <!-- Close Button (Left) -->
        <ImageView
            android:id="@+id/btn_close_detail"
            android:layout_width="@dimen/spacing_xl"
            android:layout_height="@dimen/spacing_xl"
            android:padding="@dimen/spacing_xs"
            android:src="@drawable/ic_close"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- OBJET NAME TITLE (Center) -->
        <TextView
            android:id="@+id/tv_detail_card_name"
            style="@style/MoscoText.Luxury.SubHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="56dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="SeoAh A2 316Z" />

        <!-- Send/Gift Button (Right) -->
        <FrameLayout
            android:id="@+id/btn_send_gift"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_square"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══ CENTER: THE CARD ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_album_card_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="@dimen/spacing_xl"
        android:layout_marginBottom="120dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:cardBackgroundColor="@color/transparent"
        app:cardElevation="20dp"
        app:cardCornerRadius="20dp"
        app:layout_constraintDimensionRatio="1:1.54"
        app:layout_constraintTop_toBottomOf="@id/layout_top_controls"
        app:layout_constraintBottom_toBottomOf="@id/dialog_glass_bg"
        app:layout_constraintStart_toStartOf="@id/dialog_glass_bg"
        app:layout_constraintEnd_toEndOf="@id/dialog_glass_bg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/layout_core_card" />

            <!-- Card Back (for Flip) -->
            <ImageView
                android:id="@+id/iv_collection_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/objet_back_spin"
                android:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ BOTTOM CONTROLS ═══ -->
    
    <!-- Pin Button (Bottom Left) -->
    <FrameLayout
        android:id="@+id/btn_pin_card"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:background="@drawable/bg_glass_square"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/dialog_glass_bg"
        app:layout_constraintStart_toStartOf="@id/dialog_glass_bg">
        <ImageView
            android:id="@+id/iv_pin_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pin"
            app:tint="@color/white_60" />
    </FrameLayout>

    <!-- Right Side Actions (Photo & Upgrade) -->
    <LinearLayout
        android:id="@+id/layout_bottom_right_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/dialog_glass_bg"
        app:layout_constraintEnd_toEndOf="@id/dialog_glass_bg">

        <!-- Capture Photo Button -->
        <FrameLayout
            android:id="@+id/btn_capture_photo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/spacing_md"
            android:background="@drawable/bg_glass_square"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Upgrade Button -->
        <FrameLayout
            android:id="@+id/btn_upgrade_detail"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_glass_square"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/white" />
        </FrameLayout>

    </LinearLayout>

    <!-- Legacy Views (Keep IDs for Binder but hide if not used) -->
    <View android:id="@+id/ticket_container" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <View android:id="@+id/ticket_bg" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <View android:id="@+id/layout_buttons_owned" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <View android:id="@+id/layout_buttons_locked" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <View android:id="@+id/layout_locked_overlay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <View android:id="@+id/guide_notch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <View android:id="@+id/divider_ticket" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
