<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="24dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingVertical="32dp">

    <!-- Container tỷ lệ vé 1:1.75 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ticket_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintDimensionRatio="1:1.75"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Nền Ticket -->
        <com.vn.jet.mosco.utils.TicketBackgroundView
            android:id="@+id/ticket_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Đường cơ sở khuyết tròn (đọc tỉ lệ từ resource, không hardcode) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_notch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.75" />

        <!-- Nút đóng -->
        <ImageView
            android:id="@+id/btn_close_collection_detail"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="4dp"
            android:layout_margin="12dp"
            app:tint="#99FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Vùng chứa thẻ bài (Giảm kích thước 20% bằng cách tăng margin) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_album_card_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="48dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintDimensionRatio="1:1.54"
            app:layout_constraintTop_toBottomOf="@id/btn_close_collection_detail"
            app:layout_constraintBottom_toTopOf="@id/guide_notch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardBackgroundColor="#1A1C29"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Unified Card Content -->
                <include layout="@layout/layout_core_card" />

                <!-- Lock Icon (Góc trên phải) -->
                <ImageView
                    android:id="@+id/iv_detail_lock"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    android:layout_margin="8dp"
                    app:tint="@color/mosco_gold"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Back Face -->
                <ImageView
                    android:id="@+id/iv_collection_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/objet_back_spin"
                    android:visibility="gone" />

                <!-- Locked Overlay (Phủ xám + Mặt buồn khóc) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_locked_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CC1A1C29"
                    android:visibility="gone"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_locked_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(╥﹏╥)"
                        android:textColor="#4DFFFFFF"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintVertical_bias="0.45" />

                    <TextView
                        android:id="@+id/tv_locked_sad_notice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/album_sad_wav_notice"
                        android:textColor="#66FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingHorizontal="24dp"
                        android:fontFamily="@font/poppins"
                        app:layout_constraintTop_toBottomOf="@id/tv_locked_emoji"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="12dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Divider vệt xé vé -->
        <View
            android:id="@+id/divider_ticket"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="#22FFFFFF"
            app:layout_constraintTop_toTopOf="@id/guide_notch"
            app:layout_constraintBottom_toBottomOf="@id/guide_notch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Cụm Content dưới -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/guide_notch"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Hệ thống Ghost Buttons (Dọc) -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Container cho Thẻ CHƯA sở hữu -->
                    <LinearLayout
                        android:id="@+id/layout_buttons_locked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include
                            android:id="@+id/item_btn_spin"
                            layout="@layout/item_ghost_menu" />

                        <View android:layout_width="match_parent" android:layout_height="8dp" />

                        <include
                            android:id="@+id/item_btn_shop"
                            layout="@layout/item_ghost_menu" />
                    </LinearLayout>

                    <!-- Container cho Thẻ ĐÃ sở hữu -->
                    <LinearLayout
                        android:id="@+id/layout_buttons_owned"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include
                            android:id="@+id/item_btn_take_photo"
                            layout="@layout/item_ghost_menu" />

                        <!-- Tương tác Get more (Chỉ hiện khi đã từng có nhưng hiện tại kho đồ trống) -->
                        <LinearLayout
                            android:id="@+id/layout_get_more_expandable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:visibility="gone"
                            android:layout_marginTop="4dp">

                            <LinearLayout
                                android:id="@+id/btn_get_more_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="8dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Get more"
                                    android:textColor="#99FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins" />

                                <ImageView
                                    android:id="@+id/iv_get_more_arrow"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginStart="4dp"
                                    android:src="@drawable/ic_arrow_down"
                                    app:tint="#99FFFFFF" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layout_get_more_content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone"
                                android:alpha="0"
                                android:layout_marginTop="4dp">

                                <include
                                    android:id="@+id/item_btn_shop_secondary"
                                    layout="@layout/item_ghost_menu" />

                                <View android:layout_width="match_parent" android:layout_height="8dp" />

                                <include
                                    android:id="@+id/item_btn_spin_secondary"
                                    layout="@layout/item_ghost_menu" />
                            </LinearLayout>
                        </LinearLayout>

                        <View 
                            android:id="@+id/spacer_owned_1"
                            android:layout_width="match_parent" 
                            android:layout_height="8dp" />

                        <include
                            android:id="@+id/item_btn_send"
                            layout="@layout/item_ghost_menu" />

                        <View 
                            android:id="@+id/spacer_owned_2"
                            android:layout_width="match_parent" 
                            android:layout_height="8dp" />

                        <include
                            android:id="@+id/item_btn_upgrade"
                            layout="@layout/item_ghost_menu" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
