<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background">

    <!-- Top Row: Filter Bar & Count -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_filter_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Filter Bar (Smart Pill) -->
        <com.vn.jet.mosco.view.InventoryFilterBar
            android:id="@+id/filter_bar_system_mails"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/inventory_filter_bar_height"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Mail Count -->
        <TextView
            android:id="@+id/tv_system_mails_count"
            style="@style/MoscoText.Luxury.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lg_text_secondary"
            android:textSize="@dimen/text_size_body_sm"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RecyclerView fills the remaining height, constrained above the floating footer -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_system_mails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/layout_filter_row"
        app:layout_constraintBottom_toTopOf="@id/footer_receive_all"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_mailbox" />

    <!-- Floating Footer with Receive All button -->
    <FrameLayout
        android:id="@+id/footer_receive_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/lg_floating_footer_bg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_receive_all"
            style="@style/LiquidGlass_Button_Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl"
            android:layout_marginHorizontal="@dimen/spacing_20dp"
            android:layout_marginBottom="@dimen/lg_content_bottom_clearance"
            android:text="@string/collection_action_receive_all"
            android:textAllCaps="true" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
