<?xml version="1.0" encoding="utf-8"?>
<!-- Item for friend request: Avatar | Name + Level | Accept + Reject buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_header_glass_v2"
    android:paddingHorizontal="@dimen/spacing_14dp"
    android:paddingVertical="@dimen/radius_lg"
    android:layout_marginBottom="@dimen/spacing_sm">

    <!-- Avatar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:cardCornerRadius="@dimen/spacing_100dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/mosco_card_bg_variant"
        app:strokeColor="@color/mosco_white_20"
        app:strokeWidth="0.8dp">

        <ImageView
            android:id="@+id/iv_friend_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Name + Level -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/radius_lg">

        <TextView
            android:id="@+id/tv_friend_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.Body"
            android:textSize="@dimen/text_size_hud_small"
            android:textStyle="bold"
            android:fontWeight="700"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_friend_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.Body"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_mini" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_accept"
        android:layout_width="70dp"
        android:layout_height="@dimen/spacing_xl"
        android:text="@string/social_action_accept"
        style="@style/MoscoText.Luxury.Button"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_mini"
        android:textStyle="bold"
        android:fontWeight="700"
        android:background="@drawable/bg_btn_rainbow"
        android:textAllCaps="false"
        android:layout_marginEnd="@dimen/spacing_6dp" />

    <!-- Reject button -->
    <ImageView
        android:id="@+id/btn_reject"
        android:layout_width="@dimen/spacing_xl"
        android:layout_height="@dimen/spacing_xl"
        android:src="@drawable/ic_arrow_down"
        android:rotation="0"
        android:padding="@dimen/spacing_6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/palette_red_accent" />

</LinearLayout>


