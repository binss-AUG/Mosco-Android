<?xml version="1.0" encoding="utf-8"?>
<!-- Item for friend request: Avatar | Name + Level | Accept + Reject buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_header_glass_v2"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:layout_marginBottom="8dp">

    <!-- Avatar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:cardCornerRadius="100dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#3A3A55"
        app:strokeColor="#30FFFFFF"
        app:strokeWidth="0.8dp">

        <ImageView
            android:id="@+id/iv_friend_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Name + Level -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tv_friend_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/saira"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_friend_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:textColor="#A2A2A7"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Accept button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_accept"
        android:layout_width="70dp"
        android:layout_height="32dp"
        android:text="Accept"
        android:fontFamily="@font/saira"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_rainbow"
        android:textAllCaps="false"
        android:layout_marginEnd="6dp" />

    <!-- Reject button -->
    <ImageView
        android:id="@+id/btn_reject"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_arrow_down"
        android:rotation="0"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#FF5252" />

</LinearLayout>
