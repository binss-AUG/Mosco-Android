<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/spacing_24dp"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/dialog_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_surface_solid"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24dp"
        android:elevation="@dimen/spacing_10dp">

        <!-- Icon -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_md"
            android:src="@drawable/ic_lock"
            app:tint="@color/mosco_error" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/dialog_session_expired_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/pretendard_bold" />

        <!-- Message -->
        <TextView
            android:id="@+id/tv_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16dp"
            android:gravity="center"
            android:text="@string/dialog_session_expired_msg"
            android:textColor="@color/mosco_white_80"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard" />

        <!-- Single OK Button -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24dp"
            app:moscoStyle="primary"
            app:moscoSize="medium"
            app:moscoShape="square"
            android:text="@string/dialog_session_expired_btn" />

    </LinearLayout>
</FrameLayout>
