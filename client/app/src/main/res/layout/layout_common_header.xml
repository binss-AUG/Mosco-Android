<?xml version="1.0" encoding="utf-8"?>
<!-- Common Subpage Header Component — Unified for all sub-screens -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/item_reveal_result_card_margin_horizontal"
    android:paddingBottom="@dimen/spacing_12dp"
    android:paddingHorizontal="@dimen/spacing_lg">

    <!-- BACK BUTTON (Left side, VISIBLE by default) -->
    <ImageView
        android:id="@+id/btn_back_common"
        android:layout_width="@dimen/spacing_40dp"
        android:layout_height="@dimen/spacing_40dp"
        android:src="@drawable/ic_back_arrow"
        android:padding="@dimen/spacing_xs"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="@color/white" />

    <!-- TITLE + UNDERLINE -->
        <LinearLayout
            android:id="@+id/layout_title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_16dp"
            android:layout_marginEnd="@dimen/spacing_8dp"
            app:layout_constraintStart_toEndOf="@id/btn_back_common"
            app:layout_constraintEnd_toStartOf="@id/fl_header_actions"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_h3"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/white" />

        <View
            android:id="@+id/view_header_underline"
            android:layout_width="@dimen/spacing_40dp"
            android:layout_height="@dimen/spacing_2dp"
            android:layout_marginTop="@dimen/spacing_2dp"
            android:background="@color/lg_accent_secondary" />
    </LinearLayout>

    <!-- RIGHT-SIDE ACTION SLOT (GONE by default, for custom actions like shop button) -->
    <FrameLayout
        android:id="@+id/fl_header_actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/btn_close_common"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Shop Currencies (pill-shaped chips with border) -->
        <LinearLayout
            android:id="@+id/ll_shop_currencies"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="@dimen/spacing_4dp">

            <!-- Diamond Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/header_pill_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_currency_pill">

                <ImageView
                    android:layout_width="@dimen/icon_size_xs"
                    android:layout_height="@dimen/icon_size_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:src="@drawable/ic_item_diamond" />
                <TextView
                    android:id="@+id/tv_shop_diamonds"
                    android:layout_width="@dimen/spacing_56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="14sp"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Coin Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/header_pill_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:background="@drawable/bg_currency_pill">

                <ImageView
                    android:layout_width="@dimen/icon_size_xs"
                    android:layout_height="@dimen/icon_size_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:src="@drawable/ic_item_coin" />
                <TextView
                    android:id="@+id/tv_shop_coins"
                    android:layout_width="@dimen/spacing_56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="14sp"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- CLOSE BUTTON (Right side, GONE by default) -->
    <ImageView
        android:id="@+id/btn_close_common"
        android:layout_width="@dimen/spacing_40dp"
        android:layout_height="@dimen/spacing_40dp"
        android:src="@drawable/ic_close"
        android:padding="@dimen/spacing_xs"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
