<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_menu_glass"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_header_title"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_h3"
            android:textStyle="bold"
            android:fontWeight="700"
            android:letterSpacing="0.1" />
        <ImageView
            android:id="@+id/btn_close_settings"
            android:layout_width="@dimen/spacing_lg"
            android:layout_height="@dimen/spacing_lg"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />
    </RelativeLayout>

    <!-- Theme Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="@dimen/spacing_lg"
            android:layout_height="@dimen/spacing_lg"
            android:src="@drawable/ic_dark_mode"
            app:tint="@color/white" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="@string/settings_label_dark_mode"
            style="@style/MoscoText.Luxury.Body"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_dark_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/item_diamond"
            app:trackTint="@color/lg_accent_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_thin"
        android:background="@color/mosco_white_10" />

    <!-- Music Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="@dimen/spacing_lg"
            android:layout_height="@dimen/spacing_lg"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/white" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="@string/settings_label_music"
            style="@style/MoscoText.Luxury.Body"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/item_diamond"
            app:trackTint="@color/lg_accent_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_thin"
        android:background="@color/mosco_white_10" />

    <!-- SFX Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="@dimen/spacing_lg"
            android:layout_height="@dimen/spacing_lg"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/white" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="@string/settings_label_sfx"
            style="@style/MoscoText.Luxury.Body"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_sfx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/item_diamond"
            app:trackTint="@color/lg_accent_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_thin"
        android:background="@color/mosco_white_10" />

    <!-- Storage Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_80dp"
        android:paddingTop="@dimen/radius_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_label_storage"
                style="@style/MoscoText.Luxury.Body"
                android:textSize="@dimen/text_size_body_md"
                android:textStyle="bold"
                android:fontWeight="700" />
            <TextView
                android:id="@+id/tv_cache_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_msg_loading"
                style="@style/MoscoText.Luxury.Body"
                android:textColor="@color/mosco_white_50"
                android:textSize="@dimen/text_size_mini" />
        </LinearLayout>
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_clear_cache"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:moscoStyle="ghost"
            app:moscoSize="small"
            android:text="@string/settings_action_clear_cache" />
    </LinearLayout>

    <!-- Version Info -->
    <TextView
        android:id="@+id/tv_version_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:text="@string/common_galactic_edition"
        style="@style/MoscoText.Luxury.Body"
        android:textColor="@color/lg_outline"
        android:textSize="@dimen/text_size_mini"
        android:alpha="0.5" />

</LinearLayout>



