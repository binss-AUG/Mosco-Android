<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_menu_glass"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_h3"
            android:textStyle="bold"
            android:fontWeight="700"
            android:letterSpacing="0.1" />
        <ImageView
            android:id="@+id/btn_close_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />
    </RelativeLayout>

    <!-- Theme Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_dark_mode"
            app:tint="@color/white" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="@string/settings_dark_mode"
            style="@style/MoscoText.Luxury.Body"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_dark_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/item_diamond"
            app:trackTint="@color/mosco_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Music Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/white" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="@string/settings_music"
            style="@style/MoscoText.Luxury.Body"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/item_diamond"
            app:trackTint="@color/mosco_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- SFX Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/white" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="@string/settings_sfx"
            style="@style/MoscoText.Luxury.Body"
            android:textSize="@dimen/text_size_body_md"
            android:textStyle="bold"
            android:fontWeight="700" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_sfx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/item_diamond"
            app:trackTint="@color/mosco_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Storage Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:paddingTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_storage"
                style="@style/MoscoText.Luxury.Body"
                android:textSize="@dimen/text_size_body_md"
                android:textStyle="bold"
                android:fontWeight="700" />
            <TextView
                android:id="@+id/tv_cache_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculating..."
                style="@style/MoscoText.Luxury.Body"
                android:textColor="@color/mosco_on_surface_variant"
                android:textSize="@dimen/text_size_mini" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_cache"
            style="@style/MoscoText.Luxury.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_cache"
            android:textColor="@color/stat_atk"
            android:textSize="@dimen/text_size_badge"
            android:textStyle="bold"
            android:fontWeight="700"
            app:backgroundTint="@android:color/transparent" />
    </LinearLayout>

    <!-- Version Info -->
    <TextView
        android:id="@+id/tv_version_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Mosco Galactic Edition v1.0.0"
        style="@style/MoscoText.Luxury.Body"
        android:textColor="@color/mosco_outline_variant"
        android:textSize="@dimen/text_size_mini"
        android:alpha="0.5" />

</LinearLayout>
