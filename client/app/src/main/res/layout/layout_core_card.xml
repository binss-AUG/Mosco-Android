<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Selected card image -->
    <ImageView
        android:id="@+id/card_iv_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1.54"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scaleType="centerCrop" />

    <!-- Skeleton Loading Placeholder (Standardized) -->
    <include
        layout="@layout/layout_objekt_card_skeleton"
        android:id="@+id/layout_card_skeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/card_iv_image"
        app:layout_constraintBottom_toBottomOf="@id/card_iv_image"
        app:layout_constraintStart_toStartOf="@id/card_iv_image"
        app:layout_constraintEnd_toEndOf="@id/card_iv_image" />

    <!-- Masking Container: Để chứa Shimmer và Lớp Mặt Nạ (triplesborder) cắt lẫn nhau -->
    <FrameLayout
        android:id="@+id/layout_shimmer_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/card_iv_image"
        app:layout_constraintBottom_toBottomOf="@id/card_iv_image"
        app:layout_constraintStart_toStartOf="@id/card_iv_image"
        app:layout_constraintEnd_toEndOf="@id/card_iv_image">

        <View
            android:id="@+id/view_card_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 3D Overlay Mask (triplesborder) - Sẽ được code Java ép thuộc tính DST_OUT để chọc thủng khung bắt Shimmer luồn xuống dưới -->
        <ImageView
            android:id="@+id/card_iv_triplesborder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            android:scaleType="fitXY"
            android:src="@drawable/triplesborder" />

    </FrameLayout>

    <!-- OVR Text on card -->
    <com.vn.jet.mosco.utils.StrokedTextView
        android:id="@+id/card_tv_ovr"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="start|top"
        android:fontFamily="@font/pretendard"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:fontWeight="700"
        android:includeFontPadding="false"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="2sp"
        app:autoSizeMaxTextSize="40sp"
        app:autoSizeStepGranularity="1sp"
        app:layout_constraintWidth_percent="0.25"
        app:layout_constraintHeight_percent="0.14"
        app:layout_constraintTop_toTopOf="@id/card_iv_image"
        app:layout_constraintBottom_toBottomOf="@id/card_iv_image"
        app:layout_constraintStart_toStartOf="@id/card_iv_image"
        app:layout_constraintEnd_toEndOf="@id/card_iv_image"
        app:layout_constraintHorizontal_bias="0.04"
        app:layout_constraintVertical_bias="0.02"
        android:visibility="gone"
        tools:text="102" />

    <!-- Level Badge on card -->
    <ImageView
        android:id="@+id/card_iv_level"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        app:layout_constraintWidth_percent="0.225"
        app:layout_constraintTop_toTopOf="@id/card_iv_image"
        app:layout_constraintBottom_toBottomOf="@id/card_iv_image"
        app:layout_constraintStart_toStartOf="@id/card_iv_image"
        app:layout_constraintEnd_toEndOf="@id/card_iv_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintVertical_bias="1"
        android:visibility="gone" />
</merge>

