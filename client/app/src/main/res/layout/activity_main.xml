<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Content: full-height để nội dung trượt dưới nav bar floating -->
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Liquid Glass: Floating Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/Widget.MaterialComponents.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lg_nav_height"
        android:layout_marginHorizontal="@dimen/lg_nav_margin_horizontal"
        android:layout_marginBottom="@dimen/lg_nav_margin_bottom"
        android:background="@drawable/lg_surface_nav"
        app:backgroundTint="@null"
        app:itemBackground="@null"
        app:itemRippleColor="@null"
        app:itemShapeAppearanceOverlay="@null"
        app:itemShapeFillColor="@null"
        android:elevation="0dp"
        app:itemIconTint="@color/lg_nav_item_color"
        app:itemTextColor="@color/lg_nav_item_color"
        app:itemIconSize="@dimen/lg_nav_icon_size"
        app:itemIconPadding="6dp"
        app:itemTextAppearanceActive="@style/MoscoBottomNavText.Active"
        app:itemTextAppearanceInactive="@style/MoscoBottomNavText"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>
