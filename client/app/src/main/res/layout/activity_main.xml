<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lg_background_deep"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <!-- TOP HEADER: Integrated Profile & Quick Actions (Shared) -->
    <include
        android:id="@+id/cl_header_row"
        layout="@layout/layout_home_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Content: positioned below the header -->
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_header_row" />

    <!-- Liquid Glass: Floating Bottom Navigation (Hidden for backward-compatible state management) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/Widget.MaterialComponents.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lg_nav_height"
        android:layout_marginHorizontal="@dimen/lg_nav_margin_horizontal"
        android:layout_marginBottom="@dimen/lg_nav_margin_bottom"
        android:background="@drawable/lg_surface_nav"
        android:visibility="gone"
        app:backgroundTint="@null"
        app:itemBackground="@null"
        app:itemRippleColor="@null"
        app:itemShapeAppearanceOverlay="@null"
        app:itemShapeFillColor="@null"
        android:elevation="0dp"
        app:itemIconTint="@color/lg_nav_item_color"
        app:itemTextColor="@color/lg_nav_item_color"
        app:itemIconSize="@dimen/lg_nav_icon_size"
        app:itemIconPadding="4dp"
        app:itemPaddingTop="10dp"
        app:itemPaddingBottom="8dp"
        app:itemTextAppearanceActive="@style/MoscoBottomNavText.Active"
        app:itemTextAppearanceInactive="@style/MoscoBottomNavText"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Liquid Glass: Custom Floating Bottom Navigation (Aesthetic Masterpiece) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_custom_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lg_nav_height"
        android:layout_marginHorizontal="@dimen/lg_nav_margin_horizontal"
        android:layout_marginBottom="@dimen/lg_nav_margin_bottom"
        android:background="@drawable/bg_custom_nav_bar_glass_light"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:weightSum="5">

            <!-- Tab 1: Home -->
            <LinearLayout
                android:id="@+id/btn_custom_nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_custom_nav_home"
                    android:layout_width="@dimen/lg_nav_icon_size"
                    android:layout_height="@dimen/lg_nav_icon_size"
                    android:src="@drawable/ic_home"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/tv_custom_nav_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Home"
                    android:textSize="@dimen/text_size_badge"
                    android:fontFamily="@font/pretendard"
                    android:textColor="@color/brand_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Tab 2: Stage -->
            <LinearLayout
                android:id="@+id/btn_custom_nav_stage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_custom_nav_stage"
                    android:layout_width="@dimen/lg_nav_icon_size"
                    android:layout_height="@dimen/lg_nav_icon_size"
                    android:src="@drawable/ic_stage"
                    app:tint="@color/semantic_text_secondary" />

                <TextView
                    android:id="@+id/tv_custom_nav_stage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Stage"
                    android:textSize="@dimen/text_size_badge"
                    android:fontFamily="@font/pretendard"
                    android:textColor="@color/semantic_text_secondary"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Tab 3: Spin (The Galactic Center Pill - Pure Cyan Gradient & Large Size) -->
            <FrameLayout
                android:id="@+id/btn_custom_nav_spin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Neon Aura Glow under the button -->
                <View
                    android:layout_width="@dimen/custom_nav_spin_glow_width"
                    android:layout_height="@dimen/custom_nav_spin_glow_height"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nav_spin_glow" />

                <!-- Pill-shaped Glassmorphic Elevated Button (Large & Pure Cyan) -->
                <LinearLayout
                    android:layout_width="@dimen/custom_nav_spin_pill_width"
                    android:layout_height="@dimen/custom_nav_spin_pill_height"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_nav_spin_pill"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageView
                        android:id="@+id/iv_custom_nav_spin"
                        android:layout_width="@dimen/custom_nav_spin_icon_size"
                        android:layout_height="@dimen/custom_nav_spin_icon_size"
                        android:src="@drawable/ic_spin_vede"
                        app:tint="@color/white" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab 4: Collect -->
            <LinearLayout
                android:id="@+id/btn_custom_nav_collect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_custom_nav_collect"
                    android:layout_width="@dimen/lg_nav_icon_size"
                    android:layout_height="@dimen/lg_nav_icon_size"
                    android:src="@drawable/ic_collect"
                    app:tint="@color/semantic_text_secondary" />

                <TextView
                    android:id="@+id/tv_custom_nav_collect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Collect"
                    android:textSize="@dimen/text_size_badge"
                    android:fontFamily="@font/pretendard"
                    android:textColor="@color/semantic_text_secondary"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Tab 5: Profile -->
            <LinearLayout
                android:id="@+id/btn_custom_nav_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_custom_nav_profile"
                    android:layout_width="@dimen/lg_nav_icon_size"
                    android:layout_height="@dimen/lg_nav_icon_size"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/semantic_text_secondary" />

                <TextView
                    android:id="@+id/tv_custom_nav_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Profile"
                    android:textSize="@dimen/text_size_badge"
                    android:fontFamily="@font/pretendard"
                    android:textColor="@color/semantic_text_secondary"
                    android:letterSpacing="0.05" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
