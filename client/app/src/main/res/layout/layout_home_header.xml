<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable Home Header Component — Unified Master HUD -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_header_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_8dp"
    android:paddingTop="@dimen/spacing_8dp"
    android:paddingBottom="@dimen/spacing_8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- BACK BUTTON: Consistent style with other tabs -->
    <FrameLayout
        android:id="@+id/btn_header_back"
        android:layout_width="@dimen/header_btn_size"
        android:layout_height="@dimen/header_btn_size"
        android:background="@drawable/bg_glass_circle"
        android:stateListAnimator="@animator/lg_btn_state_animator"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:layout_width="@dimen/header_icon_size"
            android:layout_height="@dimen/header_icon_size"
            android:layout_gravity="center"
            android:src="@drawable/ic_back_arrow" />
    </FrameLayout>

    <!-- Unified Master HUD — Single Continuous Glass Pill -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/home_header_pill_height"
        android:background="@drawable/bg_header_asymmetric_glass"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintStart_toEndOf="@id/btn_header_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Avatar Head (Perfect circle on left) -->
        <FrameLayout
            android:id="@+id/fl_avatar_group"
            android:layout_width="@dimen/home_header_pill_height"
            android:layout_height="@dimen/home_header_pill_height"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_home_avatar"
                android:layout_width="@dimen/home_header_avatar_size_hud"
                android:layout_height="@dimen/home_header_avatar_size_hud"
                android:layout_gravity="center"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/white_25"
                app:strokeWidth="@dimen/home_avatar_stroke_hud"
                android:src="@drawable/ic_user" />

            <!-- MINI STREAK OVERLAY (Hộp ảo ẩn phòng NPE trong code Java) -->
            <FrameLayout
                android:id="@+id/fl_streak_avatar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_streak_avatar"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
                <com.vn.jet.mosco.utils.StrokedTextView
                    android:id="@+id/tv_streak_avatar_val"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="0" />
            </FrameLayout>
        </FrameLayout>

        <!-- Right Side HUD Content (Username, XP, Currencies) -->
        <!-- LinearLayout Tự động canh giữa (wrap_content chiều cao), không lo bị lỗi Constraint Chain -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@id/fl_avatar_group"
            app:layout_constraintEnd_toStartOf="@id/header_divider"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <!-- Username (Canh trái - Chạy chữ marquee nếu tên quá dài) -->
                <TextView
                    android:id="@+id/tv_home_username"
                    style="@style/MoscoText.Luxury.SubHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/placeholder_commander"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:scrollHorizontally="true"
                    android:singleLine="true" />
                    
                <!-- Level (Canh phải, text bình thường) -->
                <TextView
                    android:id="@+id/tv_home_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="LV.1"
                    android:textColor="@color/lg_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Middle Row: XP Bar (Bo góc capsule) -->
            <ProgressBar
                android:id="@+id/pb_home_xp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_xp_bar_height"
                android:progress="0"
                android:progressDrawable="@drawable/bg_xp_progress"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp" />

            <!-- Bottom Row: Currencies (Weight-based - 50/50 split) -->
            <LinearLayout
                android:id="@+id/ll_internal_currencies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <!-- Diamond group -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView 
                        android:layout_width="14dp" 
                        android:layout_height="14dp" 
                        android:src="@drawable/ic_item_diamond" />
                    <TextView 
                        android:id="@+id/tv_home_diamonds" 
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp" 
                        android:text="0" 
                        android:maxLines="1" 
                        android:ellipsize="end" 
                        android:textColor="@color/white" 
                        android:textSize="12sp" 
                        android:textStyle="bold" 
                        android:autoSizeTextType="uniform" 
                        android:autoSizeMinTextSize="8sp" 
                        android:autoSizeMaxTextSize="13sp" />
                </LinearLayout>
                
                <!-- Coin group -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView 
                        android:layout_width="14dp" 
                        android:layout_height="14dp" 
                        android:src="@drawable/ic_item_coin" />
                    <TextView 
                        android:id="@+id/tv_home_coins" 
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp" 
                        android:text="0" 
                        android:maxLines="1" 
                        android:ellipsize="end" 
                        android:textColor="@color/white" 
                        android:textSize="12sp" 
                        android:textStyle="bold" 
                        android:autoSizeTextType="uniform" 
                        android:autoSizeMinTextSize="8sp" 
                        android:autoSizeMaxTextSize="13sp" />
                </LinearLayout>
            </LinearLayout> 
        </LinearLayout>

        <!-- SUBTLE VERTICAL DIVIDER: Đường chia kính mờ mỏng sang trọng -->
        <View
            android:id="@+id/header_divider"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="#26FFFFFF"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@id/btn_header_more"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- OVERFLOW BUTTON: không border, chỉ icon -->
        <ImageView
            android:id="@+id/btn_header_more"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_more_options"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SHOP MODE CURRENCIES: Larger for visibility -->
    <LinearLayout
        android:id="@+id/ll_shop_currencies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Diamond Large -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_glass_circle">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_item_diamond" />
            <TextView android:id="@+id/tv_shop_diamonds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="0" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Coin Large -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_glass_circle">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_item_coin" />
            <TextView android:id="@+id/tv_shop_coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="0" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
