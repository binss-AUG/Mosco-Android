<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable Home Header Component — Unified Master HUD -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_header_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_8dp"
    android:paddingTop="@dimen/spacing_8dp"
    android:paddingBottom="@dimen/spacing_8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- BACK BUTTON: Consistent style with other tabs -->
    <FrameLayout
        android:id="@+id/btn_header_back"
        android:layout_width="@dimen/header_btn_size"
        android:layout_height="@dimen/header_btn_size"
        android:background="@drawable/bg_glass_circle"
        android:stateListAnimator="@animator/lg_btn_state_animator"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:layout_width="@dimen/header_icon_size"
            android:layout_height="@dimen/header_icon_size"
            android:layout_gravity="center"
            android:src="@drawable/ic_back_arrow" />
    </FrameLayout>

    <!-- Unified Master HUD — Single Continuous Glass Pill -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_header_pill_height"
        android:background="@drawable/bg_header_asymmetric_glass"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintStart_toEndOf="@id/btn_header_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Avatar Head (Perfect circle on left) -->
        <FrameLayout
            android:id="@+id/fl_avatar_group"
            android:layout_width="@dimen/home_header_pill_height"
            android:layout_height="@dimen/home_header_pill_height"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_home_avatar"
                android:layout_width="@dimen/home_header_avatar_size_hud"
                android:layout_height="@dimen/home_header_avatar_size_hud"
                android:layout_gravity="center"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/white_25"
                app:strokeWidth="@dimen/home_avatar_stroke_hud"
                android:src="@drawable/ic_user" />

            <!-- MINI STREAK OVERLAY (Hộp ảo ẩn phòng NPE trong code Java) -->
            <FrameLayout
                android:id="@+id/fl_streak_avatar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_streak_avatar"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
                <com.vn.jet.mosco.utils.StrokedTextView
                    android:id="@+id/tv_streak_avatar_val"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="0" />
            </FrameLayout>
        </FrameLayout>

        <!-- Right Side HUD Content (Username, XP, Currencies) -->
        <!-- RỘNG 0DP DYNAMIC: Tự co giãn theo màn hình, chống tràn 100% -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintStart_toEndOf="@id/fl_avatar_group"
            app:layout_constraintEnd_toStartOf="@id/header_divider"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Username (Canh trái - Chạy chữ marquee nếu tên quá dài) -->
            <TextView
                android:id="@+id/tv_home_username"
                style="@style/MoscoText.Luxury.SubHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_commander"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_home_level"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/pb_home_xp"
                app:layout_constraintVertical_chainStyle="packed"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true" />

            <!-- Level (Canh phải, text bình thường, loại bỏ viền bao quanh) -->
            <TextView
                android:id="@+id/tv_home_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LV.1"
                android:textColor="@color/lg_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/tv_home_username"
                app:layout_constraintTop_toTopOf="@id/tv_home_username" />

            <!-- Middle Row: XP Bar (Bo góc capsule, không lo clipping) -->
            <ProgressBar
                android:id="@+id/pb_home_xp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_xp_bar_height"
                android:progress="0"
                android:progressDrawable="@drawable/bg_xp_progress"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                app:layout_constraintTop_toBottomOf="@id/tv_home_username"
                app:layout_constraintBottom_toTopOf="@id/ll_internal_currencies" />

            <!-- Bottom Row: Currencies (Vàng & Kim cương - Canh phải và margin nhau) -->
            <LinearLayout
                android:id="@+id/ll_internal_currencies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                app:layout_constraintTop_toBottomOf="@id/pb_home_xp"
                app:layout_constraintBottom_toBottomOf="parent">
                
                <!-- Diamond -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="16dp">
                    <ImageView 
                        android:layout_width="@dimen/home_currency_icon_size_hud" 
                        android:layout_height="@dimen/home_currency_icon_size_hud" 
                        android:src="@drawable/ic_item_diamond" />
                    <TextView 
                        android:id="@+id/tv_home_diamonds" 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:layout_marginStart="4dp" 
                        android:text="0" 
                        android:textColor="@color/white" 
                        android:textSize="12sp" 
                        android:textStyle="bold" />
                </LinearLayout>
                
                <!-- Coin -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView 
                        android:layout_width="@dimen/home_currency_icon_size_hud" 
                        android:layout_height="@dimen/home_currency_icon_size_hud" 
                        android:src="@drawable/ic_item_coin" />
                    <TextView 
                        android:id="@+id/tv_home_coins" 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:layout_marginStart="4dp" 
                        android:text="0" 
                        android:textColor="@color/white" 
                        android:textSize="12sp" 
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout> 
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SUBTLE VERTICAL DIVIDER: Đường chia kính mờ mỏng sang trọng -->
        <View
            android:id="@+id/header_divider"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="#26FFFFFF"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@id/ll_header_buttons"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- STANDARD MODE BUTTONS (3 Nút tròn nằm trọn vẹn trong Pill) -->
        <LinearLayout
            android:id="@+id/ll_header_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Friends Button -->
            <FrameLayout
                android:id="@+id/btn_header_friends"
                android:layout_width="@dimen/header_btn_size"
                android:layout_height="@dimen/header_btn_size"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_circle"
                android:stateListAnimator="@animator/lg_btn_state_animator"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageView
                    android:layout_width="@dimen/header_icon_size"
                    android:layout_height="@dimen/header_icon_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_friends" />
                <TextView
                    android:id="@+id/tv_badge_friends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notification_badge"
                    android:paddingHorizontal="@dimen/header_badge_padding_h"
                    android:paddingVertical="@dimen/header_badge_padding_v"
                    android:minWidth="@dimen/header_badge_min_size"
                    android:minHeight="@dimen/header_badge_min_size"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="@dimen/header_badge_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Mailbox Button -->
            <FrameLayout
                android:id="@+id/btn_header_mailbox"
                android:layout_width="@dimen/header_btn_size"
                android:layout_height="@dimen/header_btn_size"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_circle"
                android:stateListAnimator="@animator/lg_btn_state_animator"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageView
                    android:layout_width="@dimen/header_icon_size"
                    android:layout_height="@dimen/header_icon_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell_neon" />
                <TextView
                    android:id="@+id/tv_badge_mailbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notification_badge"
                    android:paddingHorizontal="@dimen/header_badge_padding_h"
                    android:paddingVertical="@dimen/header_badge_padding_v"
                    android:minWidth="@dimen/header_badge_min_size"
                    android:minHeight="@dimen/header_badge_min_size"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="@dimen/header_badge_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Shop Button -->
            <FrameLayout
                android:id="@+id/btn_header_shop"
                android:layout_width="@dimen/header_btn_size"
                android:layout_height="@dimen/header_btn_size"
                android:background="@drawable/bg_glass_circle"
                android:stateListAnimator="@animator/lg_btn_state_animator"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageView
                    android:layout_width="@dimen/header_icon_size"
                    android:layout_height="@dimen/header_icon_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shop_bag" />
                <TextView
                    android:id="@+id/tv_badge_shop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notification_badge"
                    android:paddingHorizontal="@dimen/header_badge_padding_h"
                    android:paddingVertical="@dimen/header_badge_padding_v"
                    android:minWidth="@dimen/header_badge_min_size"
                    android:minHeight="@dimen/header_badge_min_size"
                    android:gravity="center"
                    android:text="N"
                    android:textColor="@color/white"
                    android:textSize="@dimen/header_badge_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SHOP MODE CURRENCIES: Larger for visibility -->
    <LinearLayout
        android:id="@+id/ll_shop_currencies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Diamond Large -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_glass_circle">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_item_diamond" />
            <TextView android:id="@+id/tv_shop_diamonds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="0" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Coin Large -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_glass_circle">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_item_coin" />
            <TextView android:id="@+id/tv_shop_coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="0" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
