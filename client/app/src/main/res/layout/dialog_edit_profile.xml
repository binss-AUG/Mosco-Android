<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/mosco_card_bg"
    app:cardCornerRadius="@dimen/spacing_md"
    app:cardElevation="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_edit_title"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_body_lg"
            android:textStyle="bold"
            android:fontWeight="700" />

        <!-- Username (cho sửa) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20dp"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:errorEnabled="true"
            app:errorTextColor="@color/stat_atk"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_edit_username"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_52dp"
                android:background="@drawable/bg_glass_input"
                android:drawableStart="@drawable/ic_user"
                android:drawablePadding="@dimen/radius_lg"
                style="@style/MoscoText.Luxury.Body"
                android:hint="@string/auth_prompt_username"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_15dp"
                android:paddingEnd="@dimen/spacing_15dp"
                android:textColorHint="@color/mosco_white_50"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_body_sm" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email (KHÔNG cho sửa — read only) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/radius_lg"
            app:boxBackgroundMode="none"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_edit_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_52dp"
                android:background="@drawable/bg_glass_input"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="@dimen/radius_lg"
                android:enabled="false"
                android:alpha="0.5"
                style="@style/MoscoText.Luxury.Body"
                android:hint="@string/auth_prompt_email"
                android:inputType="none"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_15dp"
                android:paddingEnd="@dimen/spacing_15dp"
                android:textColorHint="@color/mosco_white_50"
                android:textSize="@dimen/text_size_body_sm" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Display Name (cho sửa) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_display_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/radius_lg"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:errorEnabled="true"
            app:errorTextColor="@color/stat_atk"
            app:errorIconDrawable="@null"
            app:counterEnabled="true"
            app:counterMaxLength="16"
            app:counterTextColor="@color/mosco_text_disabled">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_edit_display_name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_52dp"
                android:background="@drawable/bg_glass_input"
                android:drawableStart="@drawable/ic_profile"
                android:drawablePadding="@dimen/radius_lg"
                style="@style/MoscoText.Luxury.Body"
                android:hint="@string/setup_prompt_display_name"
                android:inputType="text"
                android:maxLength="16"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_15dp"
                android:paddingEnd="@dimen/spacing_15dp"
                android:textColorHint="@color/mosco_white_50"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_body_sm" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/spacing_xxl"
                android:background="@android:color/transparent"
                android:text="@string/action_cancel"
                style="@style/MoscoText.Luxury.Button"
                android:paddingHorizontal="@dimen/spacing_md"
                android:textAllCaps="false"
                android:textColor="@color/mosco_text_disabled"
                android:textSize="@dimen/text_size_body_sm" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/spacing_xxl"
                android:layout_marginStart="@dimen/radius_lg"
                android:background="@drawable/bg_button"
                android:backgroundTint="@color/mosco_card_stroke"
                android:text="@string/action_save"
                style="@style/MoscoText.Luxury.Button"
                android:paddingHorizontal="@dimen/spacing_20dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body_sm"
                android:textStyle="bold"
                android:fontWeight="700" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>


