<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_surface_solid"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_edit_title"
            style="@style/MoscoText.Luxury.SubHeader"
            android:textSize="@dimen/text_size_h3"
            android:textStyle="bold"
            android:fontWeight="700" />

        <!-- Username (cho sá»­a) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20dp"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:errorEnabled="true"
            app:errorTextColor="@color/stat_atk"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_edit_username"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_52dp"
                android:background="@drawable/lg_input_bg"
                android:drawableStart="@drawable/ic_user"
                android:drawablePadding="@dimen/radius_lg"
                style="@style/MoscoText.Luxury.Body"
                android:hint="@string/auth_prompt_username"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_15dp"
                android:paddingEnd="@dimen/spacing_15dp"
                android:textColorHint="@color/mosco_white_50"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_body_sm" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email (KHÃ”NG cho sá»­a â€” read only) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:boxBackgroundMode="none"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_edit_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_52dp"
                android:background="@drawable/lg_input_bg"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="@dimen/radius_lg"
                android:enabled="false"
                android:alpha="0.5"
                style="@style/MoscoText.Luxury.Body"
                android:hint="@string/auth_prompt_email"
                android:inputType="none"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_15dp"
                android:paddingEnd="@dimen/spacing_15dp"
                android:textColorHint="@color/mosco_white_50"
                android:textSize="@dimen/text_size_body_sm" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Display Name (cho sá»­a) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_display_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:errorEnabled="true"
            app:errorTextColor="@color/stat_atk"
            app:errorIconDrawable="@null"
            app:counterEnabled="true"
            app:counterMaxLength="16"
            app:counterTextColor="@color/mosco_white_30">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_edit_display_name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_52dp"
                android:background="@drawable/lg_input_bg"
                android:drawableStart="@drawable/ic_profile"
                android:drawablePadding="@dimen/radius_lg"
                style="@style/MoscoText.Luxury.Body"
                android:hint="@string/setup_prompt_display_name"
                android:inputType="text"
                android:maxLength="16"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_15dp"
                android:paddingEnd="@dimen/spacing_15dp"
                android:textColorHint="@color/mosco_white_50"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_body_sm" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="horizontal">

            <com.vn.jet.mosco.widget.MoscoButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_cancel"
                app:moscoStyle="ghost"
                app:moscoSize="medium"
                app:moscoShape="square" />

            <com.vn.jet.mosco.widget.MoscoButton
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_12dp"
                android:text="@string/action_save"
                app:moscoStyle="primary"
                app:moscoSize="medium"
                app:moscoShape="square" />

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>



