<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:background="@drawable/lg_glass_dialog_bg"
    android:padding="20dp"
    app:layout_constraintBottom_toBottomOf="parent">

    <!-- Drag Handle -->
    <View
        android:id="@+id/v_drag_handle"
        android:layout_width="32dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="#20FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Item Image Card (Apple Card Style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_image_container"
        android:layout_width="140dp"
        android:layout_height="215dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#0FFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/v_drag_handle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/iv_dialog_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/item_shop_demo" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_dialog_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        style="@style/MoscoText.Luxury.Header"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="-0.01"
        app:layout_constraintTop_toBottomOf="@id/mcv_image_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Metal Pack" />

    <TextView
        android:id="@+id/tv_dialog_rarity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_price_tag"
        style="@style/MoscoText.Luxury.Badge"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textSize="10sp"
        android:alpha="0.8"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="PACK" />

    <TextView
        android:id="@+id/tv_dialog_timer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        style="@style/MoscoText.Luxury.Label"
        android:textColor="@color/shop_timer_warning"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_rarity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="⏳ Ends in 6 days" />

    <TextView
        android:id="@+id/tv_dialog_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        style="@style/MoscoText.Luxury.Body"
        android:textColor="@color/mosco_white_50"
        android:textSize="13sp"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_timer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Rates: 80% First, Welcome, 15% Double" />

    <!-- Quantity Selector (Sleek Capsule) -->
    <LinearLayout
        android:id="@+id/ll_quantity"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_asymmetric_glass"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_minus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="−"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <EditText
            android:id="@+id/et_quantity"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@null"
            android:inputType="number"
            android:maxLength="4"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="+"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Total Recap Row -->
    <LinearLayout
        android:id="@+id/ll_total_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/ll_quantity">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL INVESTMENT"
            style="@style/MoscoText.Luxury.Label"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:alpha="0.6" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/iv_total_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_item_coin" />
            <TextView
                android:id="@+id/tv_total_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                style="@style/MoscoText.Luxury.Price"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                tools:text="1,000" />
        </LinearLayout>
    </LinearLayout>

    <com.vn.jet.mosco.widget.MoscoButton
        android:id="@+id/btn_confirm_buy"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp"
        android:text="Complete Order"
        app:moscoStyle="primary"
        app:moscoSize="large"
        app:layout_constraintTop_toBottomOf="@id/ll_total_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
