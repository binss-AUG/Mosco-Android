<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/spacing_xs"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Album Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_book_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/lg_glass_surface_elevated"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="@dimen/elevation_s"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:layout_constraintDimensionRatio="1:1.54"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Unified Card Content (Image + OVR + Badge) -->
            <include
                android:id="@+id/layout_core"
                layout="@layout/layout_core_card" />

            <!-- Overlay tối cho thẻ chưa sở hữu -->
            <View
                android:id="@+id/view_locked_overlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#CC0D0F1A"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/layout_core"
                app:layout_constraintEnd_toEndOf="@id/layout_core"
                app:layout_constraintStart_toStartOf="@id/layout_core"
                app:layout_constraintTop_toTopOf="@id/layout_core" />

            <!-- Icon khóa cho thẻ chưa sở hữu -->
            <ImageView
                android:id="@+id/iv_lock_icon"
                android:layout_width="@dimen/spacing_28dp"
                android:layout_height="@dimen/spacing_28dp"
                android:src="@drawable/ic_lock"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/layout_core"
                app:layout_constraintEnd_toEndOf="@id/layout_core"
                app:layout_constraintStart_toStartOf="@id/layout_core"
                app:layout_constraintTop_toTopOf="@id/layout_core"
                app:tint="@color/mosco_white_30" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card Name Tag (Outside CardView: Separate Bubble) -->
    <TextView
        android:id="@+id/tv_card_name"
        style="@style/MoscoText.Luxury"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:layout_marginBottom="@dimen/spacing_4dp"
        android:background="@drawable/bg_card_name_tag"
        android:paddingHorizontal="@dimen/spacing_10dp"
        android:paddingVertical="@dimen/spacing_2dp"
        android:textColor="@color/white"
        android:textSize="@dimen/text_11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:elevation="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_book_card"
        tools:text="JiYeon F·B503Z" />

    <!-- Skeleton Loading State (Synchronized) -->
    <include
        android:id="@+id/layout_skeleton"
        layout="@layout/item_objet_skeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
