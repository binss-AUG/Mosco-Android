<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_surface_solid"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Success Icon Header -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_md"
            android:src="@drawable/ic_check"
            app:tint="@color/mosco_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            style="@style/MoscoText.Luxury.SubHeader"
            android:text="@string/shop_dialog_success_title"
            android:textSize="@dimen/text_size_h3"
            android:textStyle="bold"
            android:fontWeight="700" />

        <TextView
            android:id="@+id/tv_success_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/radius_lg"
            android:textAlignment="center"
            style="@style/MoscoText.Luxury.Body"
            android:text="Purchase Successful!"
            android:textColor="@color/mosco_text_disabled"
            android:textSize="@dimen/text_size_body_sm" />

        <!-- Navigation Actions -->
        <LinearLayout
            android:id="@+id/ll_actions_standard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="horizontal">

            <com.vn.jet.mosco.widget.MoscoButton
                android:id="@+id/btn_go_inventory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:moscoStyle="secondary"
                app:moscoSize="large"
                android:text="@string/shop_dialog_action_inventory" />

            <com.vn.jet.mosco.widget.MoscoButton
                android:id="@+id/btn_use_now"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_12dp"
                app:moscoStyle="primary"
                app:moscoSize="large"
                android:text="@string/shop_dialog_action_use_now" />

        </LinearLayout>

        <!-- Resource Confirmation (Single Button) -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            app:moscoStyle="primary"
            app:moscoSize="large"
            android:text="@string/action_ok"
            android:visibility="gone" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
