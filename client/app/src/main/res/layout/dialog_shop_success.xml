<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/mosco_surface_container"
    app:cardCornerRadius="16dp"
    app:cardElevation="12dp"
    app:strokeColor="@color/mosco_primary"
    app:strokeWidth="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Success Icon -->
        <ImageView
            android:id="@+id/iv_success_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_check"
            app:tint="@color/mosco_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_success_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins"
            android:text="Purchase Successful!"
            android:textColor="@color/mosco_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/iv_success_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Message -->
        <TextView
            android:id="@+id/tv_success_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:fontFamily="@font/poppins"
            android:textColor="@color/mosco_on_surface_variant"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tv_success_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="You bought 1x Metal Pack." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_success_message">

            <!-- Check Inventory Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go_inventory"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Inventory"
                android:fontFamily="@font/poppins"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/mosco_outline"
                android:textColor="@color/mosco_on_surface" />

            <!-- Use Now Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_use_now"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Use Now"
                android:fontFamily="@font/poppins"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/mosco_primary" />
                
            <!-- OK Button (for resource) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ok"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="OK"
                android:fontFamily="@font/poppins"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/mosco_primary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
