<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/spacing_24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_surface_solid"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24dp"
        android:elevation="@dimen/spacing_10dp"
        android:gravity="center">

        <!-- Success Icon with Glow -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_glass_circle">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="@color/lg_accent_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            style="@style/MoscoText.Luxury.Header"
            android:text="@string/shop_dialog_success_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/tv_success_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAlignment="center"
            style="@style/MoscoText.Luxury.Body"
            android:text="@string/common_msg_purchase_success"
            android:textColor="@color/mosco_white_50"
            android:textSize="14sp" />

        <!-- Navigation Actions -->
        <LinearLayout
            android:id="@+id/ll_actions_standard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <com.vn.jet.mosco.widget.MoscoButton
                android:id="@+id/btn_use_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:moscoStyle="primary"
                app:moscoSize="medium"
                app:moscoShape="square"
                android:text="@string/shop_dialog_action_use_now" />

            <com.vn.jet.mosco.widget.MoscoButton
                android:id="@+id/btn_go_inventory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:moscoStyle="secondary"
                app:moscoSize="medium"
                app:moscoShape="square"
                android:text="@string/shop_dialog_action_inventory" />

        </LinearLayout>

        <!-- Resource Confirmation (Single Button) -->
        <com.vn.jet.mosco.widget.MoscoButton
            android:id="@+id/btn_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:moscoStyle="primary"
            app:moscoSize="medium"
            app:moscoShape="square"
            android:text="@string/action_ok"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
