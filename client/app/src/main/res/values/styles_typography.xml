<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================== -->
    <!-- MOSCO LUXURY TYPOGRAPHY SYSTEM (2026)      -->
    <!-- Base Font: Pretendard (Quiet Luxury)       -->
    <!-- Galactic Font: Orbitron (Futuristic)       -->
    <!-- Technical Font: Chakra Petch (Stats/Data)  -->
    <!-- ========================================== -->

    <!-- Root Mosco Text Style -->
    <style name="MoscoText" />

    <!-- Base Luxury Style -->
    <style name="MoscoText.Luxury">
        <item name="android:fontFamily">@font/pretendard</item>
    </style>
    
    <!-- 2. GALACTIC TYPOGRAPHY (Futuristic/Bold) -->
    <style name="MoscoText.Galactic">
        <item name="android:fontFamily">@font/orbitron</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <!-- 3. TECHNICAL TYPOGRAPHY (Monospace/Data) -->
    <style name="MoscoText.Technical">
        <item name="android:fontFamily">@font/chakra_petch</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Luxury Header: Airy, Light, Sophisticated -->
    <style name="MoscoText.Luxury.Header">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontWeight">200</item>
        <item name="android:textSize">@dimen/text_size_h2</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Luxury SubHeader: Refined and Precise -->
    <style name="MoscoText.Luxury.SubHeader">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_size_body_lg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Luxury Nav: For list items in settings/profile -->
    <style name="MoscoText.Luxury.Nav">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_size_h3</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Luxury Section: For headers like "Account", "Etc" -->
    <style name="MoscoText.Luxury.Section">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">700</item>
        <item name="android:textSize">@dimen/text_size_body_md</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Luxury Body: Clean and Readable -->
    <style name="MoscoText.Luxury.Body">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontWeight">200</item>
        <item name="android:textSize">@dimen/text_size_body_md</item>
        <item name="android:textColor">@color/white_80</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

    <!-- Luxury Label: Small but high contrast -->
    <style name="MoscoText.Luxury.Label">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_size_body_sm</item>
        <item name="android:textColor">@color/lg_text_disabled</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Tab Appearance for centered alignment -->
    <style name="MoscoTabTextAppearance" parent="MoscoText.Luxury.Label">
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/text_size_body_sm</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Luxury Price: Bold and Authority -->
    <style name="MoscoText.Luxury.Price">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontWeight">700</item>
        <item name="android:textSize">@dimen/text_size_h3</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Luxury Input: Clean and precise for forms -->
    <style name="MoscoText.Luxury.Input">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">200</item>
        <item name="android:textSize">@dimen/text_size_body_md</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white_50</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">@dimen/spacing_xs</item>
        <item name="android:paddingHorizontal">@dimen/spacing_md</item>
    </style>

    <!-- Luxury Link: Subtle but interactive -->
    <style name="MoscoText.Luxury.Link">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_size_body_sm</item>
        <item name="android:textColor">@color/mosco_primary_dim</item>
    </style>

    <!-- Card Specific Styles -->
    <style name="MoscoText.Luxury.Card" parent="MoscoText.Luxury" />

    <style name="MoscoText.Luxury.Card.Title">
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_size_card_title</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="MoscoText.Luxury.Card.Price">
        <item name="android:fontWeight">700</item>
        <item name="android:textSize">@dimen/text_size_card_price</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="MoscoText.Luxury.Card.Desc">
        <item name="android:fontWeight">200</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/white_60</item>
    </style>

    <!-- Badge Style -->
    <style name="MoscoText.Luxury.Badge">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">700</item>
        <item name="android:textSize">@dimen/text_size_badge</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Luxury Button: Bold and centered -->
    <style name="MoscoText.Luxury.Button">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_size_body_lg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/luxury_button_state_animator</item>
    </style>

    <style name="MoscoText.Luxury.Button.Primary">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontWeight">700</item>
        <item name="android:textSize">@dimen/text_size_body_lg</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Reward Overlay Specific Styles -->
    <style name="MoscoText.Luxury.RewardTitle">
        <item name="android:fontWeight">700</item>
        <item name="android:textSize">@dimen/stage_reward_title_size</item>
        <item name="android:textColor">@color/stage_coin_gold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="MoscoText.Luxury.RewardTap">
        <item name="android:fontWeight">700</item>
        <item name="android:textSize">@dimen/stage_reward_tap_text_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Semantic Galactic Styles -->
    <style name="MoscoText.Galactic.Header">
        <item name="android:textSize">@dimen/text_size_h1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MoscoText.Galactic.SubHeader">
        <item name="android:textSize">@dimen/text_size_h3</item>
        <item name="android:textColor">@color/white_70</item>
    </style>

    <style name="MoscoText.Galactic.Label">
        <item name="android:textSize">@dimen/text_size_badge</item>
        <item name="android:textColor">@color/white_40</item>
        <item name="android:letterSpacing">0.2</item>
    </style>

    <!-- Semantic Technical Styles -->
    <style name="MoscoText.Technical.Badge">
        <item name="android:textSize">@dimen/text_size_badge</item>
        <item name="android:textColor">@color/galactic_accent_cyan</item>
    </style>

    <style name="MoscoText.Technical.Stat">
        <item name="android:textSize">@dimen/text_size_body_xs</item>
        <item name="android:textColor">@color/white_90</item>
    </style>

    <style name="MoscoText.Technical.Value">
        <item name="android:textSize">@dimen/text_size_h2</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

