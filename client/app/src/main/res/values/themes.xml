<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Mosco" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Matte Obsidian Background - Đồng bộ toàn hệ thống -->
        <item name="android:windowBackground">@drawable/bg_global_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/mosco_surface_container</item>
    </style>

    <style name="Theme.Mosco" parent="Base.Theme.Mosco" />

    <!-- Theme cho BottomSheet để có nền trong suốt và bo góc đúng cách -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>