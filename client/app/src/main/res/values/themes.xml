<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Mosco" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Global Typography - Quiet Luxury Standard -->
        <item name="android:fontFamily">@font/pretendard</item>
        
        <!-- Liquid Glass: Deep Space Background -->
        <item name="android:windowBackground">@drawable/lg_background_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Transparent để floating nav bar hiển thị đúng -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Mosco" parent="Base.Theme.Mosco" >
        <item name="android:windowAnimationStyle">@style/LuxuryAnimation</item>
    </style>

    <style name="LuxuryAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/luxury_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/luxury_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/luxury_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/luxury_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/luxury_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/luxury_exit</item>
    </style>

    <!-- Theme cho BottomSheet để có nền trong suốt và bo góc đúng cách -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.Mosco.CardTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <!-- Hộp thoại mang phong cách Galactic -->
    <style name="GalacticDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_galactic</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white_70</item>
        <item name="colorAccent">@color/galactic_accent_purple</item>
    </style>
    <style name="RewardOverlayTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/overlay_dark_90</item>
    </style>

    <!-- ============================================= -->
    <!-- LIQUID GLASS THEME SYSTEM                     -->
    <!-- ============================================= -->

    <!-- LG: Dialog Theme -->
    <style name="LiquidGlass_DialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/lg_surface_modal</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/mosco_white_70</item>
        <item name="colorAccent">@color/lg_accent_primary</item>
        <item name="android:backgroundDimAmount">0.75</item>
    </style>

    <!-- LG: BottomSheet Dialog Theme -->
    <style name="LiquidGlass_BottomSheetTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/LiquidGlass_BottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="LiquidGlass_BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>