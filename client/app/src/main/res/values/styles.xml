<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================================== -->
    <!-- 1. CHIPS & TAGS (Dành cho bộ lọc, nhãn)      -->
    <!-- ========================================== -->
    <style name="FilterChipStyle" parent="LiquidGlass_Chip">
        <!-- Heritage mapping for legacy code -->
    </style>

    <style name="LiquidGlass_Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/spacing_xxl</item>
        <item name="android:background">@drawable/lg_chip_bg</item>
        <item name="android:paddingHorizontal">@dimen/spacing_md</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/lg_text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body_xs</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">500</item>
        <item name="android:stateListAnimator">@animator/lg_btn_state_animator</item>
    </style>

    <!-- ============================================= -->
    <!-- LIQUID GLASS V1.1 INTERACTIVE COMPONENTS      -->
    <!-- ============================================= -->

    <!-- LG: Button Primary -->
    <style name="LiquidGlass_Button_Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="cornerRadius">@dimen/lg_radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/lg_btn_primary</item>
        <item name="android:textColor">@color/lg_text_primary</item>
        <item name="android:stateListAnimator">@animator/lg_btn_state_animator</item>
    </style>

    <!-- LG: Button Secondary -->
    <style name="LiquidGlass_Button_Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="cornerRadius">@dimen/lg_radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/lg_btn_secondary</item>
        <item name="android:textColor">@color/lg_text_primary</item>
        <item name="android:stateListAnimator">@animator/lg_btn_state_animator</item>
    </style>

    <!-- LG: Button Ghost -->
    <style name="LiquidGlass_Button_Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="cornerRadius">@dimen/lg_radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/lg_btn_ghost</item>
        <item name="android:textColor">@color/lg_text_secondary</item>
        <item name="android:stateListAnimator">@animator/lg_btn_state_animator</item>
    </style>

    <!-- LG: Icon Button -->
    <style name="LiquidGlass_IconButton" parent="Widget.MaterialComponents.Button.Icon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">12dp</item>
        <item name="cornerRadius">@dimen/lg_radius_small_control</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/lg_text_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/lg_btn_icon</item>
        <item name="android:stateListAnimator">@animator/lg_btn_state_animator</item>
    </style>

    <!-- LG: Pill Button -->
    <style name="LiquidGlass_PillButton" parent="LiquidGlass_Button_Secondary">
        <item name="cornerRadius">24dp</item>
        <item name="android:background">@drawable/lg_btn_pill</item>
    </style>

    <!-- LG: Nav Button -->
    <style name="LiquidGlass_NavButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="cornerRadius">@dimen/lg_radius_nav</item>
        <item name="android:background">@drawable/lg_nav_item_indicator</item>
        <item name="android:stateListAnimator">@animator/lg_btn_state_animator</item>
    </style>

    <!-- LG: Tab Indicator Capsule -->
    <style name="LiquidGlass_TabIndicator">
        <item name="android:background">@drawable/lg_nav_item_indicator</item>
    </style>


    <!-- ========================================== -->
    <!-- 3. DIALOGS & BOTTOMSHEETS (Galactic UI)    -->
    <!-- ========================================== -->

    <style name="GalacticBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/GalacticBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="GalacticBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_peekHeight">@dimen/spacing_100dp</item>
    </style>

    <style name="TransparentBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TransparentBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="TransparentBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="BottomSheetHandle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:background">@drawable/bg_bottomsheet_handle</item>
    </style>

    <!-- ========================================== -->
    <!-- 3. INPUT FIELD ENHANCEMENTS                -->
    <!-- ========================================== -->
    <style name="MoscoTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundMode">none</item>
        <item name="hintEnabled">false</item>
        <item name="android:stateListAnimator">@animator/luxury_input_state_animator</item>
    </style>

    <style name="LiquidGlass_Input" parent="Widget.Design.TextInputEditText">
        <item name="android:background">@drawable/lg_input_bg</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textColor">@color/lg_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Bottom Navigation Text Appearance - Fix Center Alignment -->
    <style name="MoscoBottomNavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="MoscoBottomNavText.Active">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
