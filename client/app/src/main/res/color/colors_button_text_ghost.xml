<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled state -->
    <item android:state_enabled="false" android:color="@color/lg_text_disabled" />
    <!-- Pressed state -->
    <item android:state_pressed="true" android:color="@color/lg_text_primary" />
    <!-- Focused/Hovered state -->
    <item android:state_focused="true" android:color="@color/lg_text_primary" />
    <!-- Default state -->
    <item android:color="@color/lg_text_secondary" />
</selector>
