<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="600dp"
    android:height="600dp"
    android:viewportWidth="600"
    android:viewportHeight="600">

    <!-- Lớp cốt hành tinh -->
    <path android:pathData="M300,300m-280,0a280,280 0,1 1,560 0a280,280 0,1 1,-560 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="250"
                android:centerY="250"
                android:gradientRadius="350"
                android:type="radial">
                <item android:color="#FF3E166A" android:offset="0.0" />
                <item android:color="#FF0D051A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dải đai 1 -->
    <path android:pathData="M300,300m-280,0a280,280 0,1 1,560 0a280,280 0,1 1,-560 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="300"
                android:startY="150"
                android:endX="300"
                android:endY="280"
                android:type="linear">
                <item android:color="#00000000" android:offset="0.0" />
                <item android:color="#669370DB" android:offset="0.5" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dải đai 2 -->
    <path android:pathData="M300,300m-280,0a280,280 0,1 1,560 0a280,280 0,1 1,-560 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="300"
                android:startY="320"
                android:endX="300"
                android:endY="450"
                android:type="linear">
                <item android:color="#00000000" android:offset="0.0" />
                <item android:color="#4D4B0082" android:offset="0.5" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vết bão (Storm Spot) -->
    <path android:pathData="M300,300m-280,0a280,280 0,1 1,560 0a280,280 0,1 1,-560 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="200"
                android:centerY="300"
                android:gradientRadius="80"
                android:type="radial">
                <item android:color="#99BA55D3" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
