<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="600dp"
    android:height="600dp"
    android:viewportWidth="600"
    android:viewportHeight="600">

    <!-- Lớp cốt hành tinh (Nền tảng 3D) -->
    <path android:pathData="M300,300m-280,0a280,280 0,1 1,560 0a280,280 0,1 1,-560 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="250"
                android:centerY="250"
                android:gradientRadius="350"
                android:type="radial">
                <item android:color="#FF3E166A" android:offset="0.0" />
                <item android:color="#FF0D051A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dải đai 1 (Sử dụng Linear Gradient trên hình tròn để triệt tiêu mép) -->
    <path android:pathData="M300,300m-280,0a280,280 0,1 1,560 0a280,280 0,1 1,-560 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="300"
                android:startY="150"
                android:endX="300"
                android:endY="280"
                android:type="linear">
                <item android:color="#00000000" android:offset="0.0" />
                <item android:color="#4D9370DB" android:offset="0.5" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dải đai 2 (Phần dưới) -->
    <path android:pathData="M300,300m-280,0a280,280 0,1 1,560 0a280,280 0,1 1,-560 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="300"
                android:startY="320"
                android:endX="300"
                android:endY="450"
                android:type="linear">
                <item android:color="#00000000" android:offset="0.0" />
                <item android:color="#334B0082" android:offset="0.5" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vết bão (Storm Spot) - Giờ là một điểm tụ mờ ảo -->
    <path android:pathData="M300,300m-280,0a280,280 0,1 1,560 0a280,280 0,1 1,-560 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="200"
                android:centerY="300"
                android:gradientRadius="80"
                android:type="radial">
                <item android:color="#66BA55D3" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lớp tạo khối tối (Tạo chiều sâu 3D cực mịn) -->
    <path android:pathData="M300,300m-280,0a280,280 0,1 1,560 0a280,280 0,1 1,-560 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="480"
                android:centerY="120"
                android:gradientRadius="450"
                android:type="radial">
                <item android:color="#00000000" android:offset="0.4" />
                <item android:color="#E6000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Quầng sáng Atmosphere (Mờ biên hoàn hảo) -->
    <path android:pathData="M300,300m-282,0a282,282 0,1 1,564 0a282,282 0,1 1,-564 0"
        android:strokeWidth="5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:centerX="300"
                android:centerY="300"
                android:gradientRadius="285"
                android:type="radial">
                <item android:color="#4D00FFFF" android:offset="0.95" />
                <item android:color="#0000FFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
