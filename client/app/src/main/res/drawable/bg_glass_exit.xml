<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Outer Glow/Stroke for that 'Thickness' premium feel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/spacing_xl" />
            <solid android:color="#20FF4B4B" /> <!-- Subtle red surrounding glow -->
            <stroke
                android:width="@dimen/spacing_2dp"
                android:color="@color/mosco_white_30" /> <!-- Glass edge -->
        </shape>
    </item>

    <!-- 2. Main Glass Body -->
    <item android:top="@dimen/spacing_2dp" android:left="@dimen/spacing_2dp" android:right="@dimen/spacing_2dp" android:bottom="@dimen/spacing_2dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:startColor="#E60F0F1A"
                android:centerColor="#CC1A1C2E"
                android:endColor="#BF25283D"
                android:angle="135" />
            <stroke
                android:width="1.2dp"
                android:color="#80FF4B4B" /> <!-- Red Inner Neon Stroke -->
        </shape>
    </item>
</layer-list>

