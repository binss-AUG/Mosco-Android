<?xml version="1.0" encoding="utf-8"?>
<!-- 
     Enhanced Hologram Uplight: 
     More intense vertical light beam with a tighter focus to simulate a projector beam.
     Uses multiple color stops for a richer "volumetric" feel.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#CC00E5FF"
        android:centerColor="#4400E5FF"
        android:endColor="#0000E5FF" />
</shape>
