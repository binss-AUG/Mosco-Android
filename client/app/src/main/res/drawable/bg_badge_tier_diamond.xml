<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp dưới: Viền gradient xanh băng/cyan neon -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#22D3EE"
                android:endColor="#3B82F6"
                android:angle="45" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Lớp trên: Nền kính mờ bán trong suốt thụt lề 1.5dp -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <!-- TẠI SAO: Màu nền deep cyan mờ 60% tạo chiều sâu huyền hoặc như đang nhìn vào khối kim cương xanh ngọc đại dương -->
            <solid android:color="#99083344" />
            <corners android:radius="10.5dp" />
        </shape>
    </item>
</layer-list>
