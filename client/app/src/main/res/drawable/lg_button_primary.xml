<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: Primary button surface -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/lg_accent_primary_alpha_25">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/lg_radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_accent_primary" />
            <corners android:radius="@dimen/lg_radius_button" />
        </shape>
    </item>
</ripple>
