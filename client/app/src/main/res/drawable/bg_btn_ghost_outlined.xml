<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Trạng thái nhấn: Nền mờ nhẹ, viền rõ hơn -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_full" />
            <solid android:color="@color/mosco_white_10" />
            <stroke android:width="1dp" android:color="@color/mosco_white_50" />
        </shape>
    </item>
    <!-- Trạng thái mặc định: Viền Obsidian 300 tinh tế -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_full" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/lg_outline" />
        </shape>
    </item>
</selector>

