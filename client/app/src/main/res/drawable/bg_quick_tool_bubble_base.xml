<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp nền thủy tinh + Viền -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
    <!-- Vệt sáng bóng đứng yên ở đỉnh -->
    <item android:top="2dp" android:left="8dp" android:right="8dp" android:bottom="30dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#A6FFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- Vệt sáng đứng yên ở đáy -->
    <item android:top="35dp" android:left="10dp" android:right="10dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#40FFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
