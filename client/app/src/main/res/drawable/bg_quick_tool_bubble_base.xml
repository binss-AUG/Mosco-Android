<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp nền thủy tinh + Viền -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/mosco_white_15" />
            <stroke android:width="@dimen/stroke_thin" android:color="@color/mosco_white_30" />
        </shape>
    </item>
    <!-- Vệt sáng bóng đứng yên ở đỉnh -->
    <item android:top="@dimen/spacing_2dp" android:left="@dimen/spacing_sm" android:right="@dimen/spacing_sm" android:bottom="30dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#A6FFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- Vệt sáng đứng yên ở đáy -->
    <item android:top="35dp" android:left="@dimen/spacing_10dp" android:right="@dimen/spacing_10dp" android:bottom="@dimen/spacing_xs">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="@color/mosco_white_25"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>

