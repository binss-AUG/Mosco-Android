<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26FFFFFF">
    <item>
        <layer-list>
            <!-- Base Surface -->
            <item><shape android:shape="rectangle"><corners android:radius="@dimen/lg_radius_chip" /><solid android:color="@color/lg_nav_surface" /></shape></item>
            <!-- Primary Accent Glow -->
            <item><shape android:shape="rectangle"><corners android:radius="@dimen/lg_radius_chip" /><solid android:color="@color/lg_accent_primary_alpha_25" /></shape></item>
            <!-- Inner Gradient -->
            <item><shape android:shape="rectangle"><corners android:radius="@dimen/lg_radius_chip" /><gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#00FFFFFF" android:type="linear" /></shape></item>
            <!-- Stroke -->
            <item><shape android:shape="rectangle"><corners android:radius="@dimen/lg_radius_chip" /><stroke android:width="@dimen/lg_stroke_hairline" android:color="@color/lg_glass_stroke_strong" /></shape></item>
        </layer-list>
    </item>
</ripple>
