<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: Ghost/Glass button surface -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mosco_white_15">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/lg_radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_glass_surface_elevated" />
            <corners android:radius="@dimen/lg_radius_button" />
            <stroke
                android:width="@dimen/lg_stroke_hairline"
                android:color="@color/lg_glass_stroke" />
        </shape>
    </item>
</ripple>
