<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: Filter chip selector (Shop, Inventory) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/lg_accent_primary" />
            <corners android:radius="@dimen/lg_radius_chip" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/lg_glass_surface" />
            <corners android:radius="@dimen/lg_radius_chip" />
            <stroke android:width="@dimen/lg_stroke_hairline" android:color="@color/lg_glass_stroke" />
        </shape>
    </item>
</selector>
