<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1AFFFFFF">
    <!-- Mask to restrict ripple to corners -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_lg" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>

    <item>
        <selector>
            <!-- Disabled State -->
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>

            <!-- Focused / Hovered State -->
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="@color/lg_glass_surface" />
                    <stroke android:width="@dimen/lg_stroke_hairline" android:color="@color/lg_glass_stroke_subtle" />
                </shape>
            </item>

            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="@color/lg_glass_surface" />
                    <stroke android:width="@dimen/lg_stroke_hairline" android:color="@color/lg_glass_stroke_subtle" />
                </shape>
            </item>

            <!-- Default State -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
