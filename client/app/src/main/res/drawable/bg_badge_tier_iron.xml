<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp dưới: Viền gradient sắt xám -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#64748B"
                android:endColor="#334155"
                android:angle="45" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Lớp trên: Nền kính mờ bán trong suốt thụt lề 1.5dp -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <!-- TẠI SAO: Sử dụng màu nền xám mờ đục 60% để tạo hiệu ứng kính mờ (Glassmorphism) cực kỳ sang trọng cho người dùng năm 2026 -->
            <solid android:color="#991E293B" />
            <corners android:radius="10.5dp" />
        </shape>
    </item>
</layer-list>
