<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: Filter Bar unified container surface (V1.1 Adaptive) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Obsidian layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_nav_surface" />
            <corners android:radius="@dimen/lg_radius_nav" />
        </shape>
    </item>
    <!-- Hairline depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lg_radius_nav" />
            <stroke android:width="@dimen/lg_stroke_hairline" android:color="@color/lg_glass_stroke_strong" />
        </shape>
    </item>
</layer-list>
