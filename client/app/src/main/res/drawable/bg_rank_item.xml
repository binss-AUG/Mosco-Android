<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Viền phát sáng nhẹ bao quanh (Glowing Stroke) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#30FFFFFF" />
        </shape>
    </item>
    
    <!-- Lớp nền chính bên trong, trong suốt kiểu kính (Frosted Glass) -->
    <item android:bottom="1dp" android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#2A2A40"
                android:endColor="#151525" />
        </shape>
    </item>
</layer-list>
