<?xml version="1.0" encoding="utf-8"?>
<!-- Tại sao: Chuyển sang thiết kế phẳng đơn lớp dạng vuông bo 12dp để tối ưu hóa hiệu năng render trên giả lập Android 9 (API 28), dạng viền (outlined) trong suốt -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#20FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_lg" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>

    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/lg_stroke_thin" android:color="#4D94A3B8" />
                </shape>
            </item>

            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="#1AFFFFFF" />
                    <stroke android:width="@dimen/lg_stroke_thin" android:color="@color/brand_primary" />
                </shape>
            </item>

            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="#1AFFFFFF" />
                    <stroke android:width="@dimen/lg_stroke_thin" android:color="@color/brand_primary" />
                </shape>
            </item>

            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="#1AFFFFFF" />
                    <stroke android:width="@dimen/lg_stroke_thin" android:color="@color/brand_primary" />
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/lg_stroke_thin" android:color="@color/brand_primary" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
