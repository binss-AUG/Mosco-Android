<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#20FFFFFF">
    <!-- Mask to restrict ripple to corners -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_lg" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>

    <item>
        <selector>
            <!-- Disabled State -->
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_lg" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/lg_stroke_hairline" android:color="#0DFFFFFF" />
                </shape>
            </item>

            <!-- Focused / Hovered State -->
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <solid android:color="@color/lg_nav_surface" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <solid android:color="@color/lg_glass_surface_high" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <stroke android:width="@dimen/lg_stroke_thin" android:color="@color/white" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <item android:state_hovered="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <solid android:color="@color/lg_nav_surface" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <solid android:color="@color/lg_glass_surface_high" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <stroke android:width="@dimen/lg_stroke_thin" android:color="@color/white" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <!-- Default State -->
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <solid android:color="@color/lg_nav_surface" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <solid android:color="@color/lg_glass_surface_elevated" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <gradient android:angle="270" android:startColor="#1AFFFFFF" android:endColor="#00FFFFFF" android:type="linear" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_lg" />
                            <stroke android:width="@dimen/lg_stroke_hairline" android:color="@color/lg_glass_stroke" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
