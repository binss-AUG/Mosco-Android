<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: Selected chip background (No Insets, matching unselected sizes) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_nav_indicator" />
            <corners android:radius="@dimen/lg_radius_chip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lg_radius_chip" />
            <stroke android:width="@dimen/lg_stroke_hairline" android:color="@color/lg_glass_stroke_strong" />
        </shape>
    </item>
</layer-list>
