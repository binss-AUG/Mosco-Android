<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow / Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="@color/mosco_primary_alpha_10" />
        </shape>
    </item>
    
    <!-- Actual button bg -->
    <item android:top="@dimen/spacing_2dp" android:left="@dimen/spacing_2dp" android:right="@dimen/spacing_2dp" android:bottom="@dimen/spacing_2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="@color/mosco_primary" />
            <!-- Inner hairline for premium feel -->
            <stroke android:width="@dimen/stroke_thin" android:color="@color/mosco_white_25" />
        </shape>
    </item>
</layer-list>

