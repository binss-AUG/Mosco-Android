<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow / Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="#1A6C29FD" />
        </shape>
    </item>
    
    <!-- Actual button bg -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="@color/mosco_primary" />
            <!-- Inner hairline for premium feel -->
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
