<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow / Outer Glow (mosco_surface_tint - 8% opacity is #146c29fd, but we'll use android:alpha or direct mosco_surface_tint) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#146c29fd" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/mosco_primary" />
        </shape>
    </item>
    <!-- Actual button bg (Gradient inner) -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="@color/mosco_primary"
                android:endColor="@color/mosco_primary_dim"
                android:angle="135"/>
            <!-- Inner Glow simulation using stroke -->
            <stroke android:width="1dp" android:color="@color/mosco_on_surface" />
        </shape>
    </item>
</layer-list>
