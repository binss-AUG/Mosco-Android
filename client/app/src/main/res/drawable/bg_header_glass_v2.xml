<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle Inner Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#0DFFFFFF" />
            <stroke
                android:width="0.8dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- Main Glass Body with Obsidian Matte Gradient -->
    <item android:top="0.8dp" android:left="0.8dp" android:right="0.8dp" android:bottom="0.8dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:startColor="#F20E0E0E"
                android:endColor="#CC161622"
                android:angle="135" />
            <stroke
                android:width="1dp"
                android:color="#20FFFFFF" /> 
        </shape>
    </item>
</layer-list>
