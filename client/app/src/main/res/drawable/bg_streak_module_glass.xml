<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Glass Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_m" />
            <gradient
                android:angle="135"
                android:endColor="@color/mosco_white_10"
                android:startColor="@color/mosco_white_05" />
            <stroke
                android:width="@dimen/stroke_thin"
                android:color="@color/mosco_white_10" />
        </shape>
    </item>
    
    <!-- Subtle Inner Pattern (Simulated with a gradient) -->
    <item android:top="@dimen/spacing_20dp" android:left="@dimen/spacing_20dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="@dimen/spacing_100dp"
                android:startColor="#0800E5FF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>

