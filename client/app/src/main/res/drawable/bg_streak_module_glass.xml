<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Glass Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lg_radius_card" />
            <gradient
                android:angle="135"
                android:endColor="@color/lg_glass_surface_elevated"
                android:startColor="@color/lg_glass_surface" />
            <stroke
                android:width="@dimen/lg_stroke_hairline"
                android:color="@color/lg_glass_stroke_subtle" />
        </shape>
    </item>
    
    <!-- Subtle Inner Pattern (Electric Blue accent glow) -->
    <item android:top="@dimen/spacing_20dp" android:left="@dimen/spacing_20dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="@dimen/spacing_100dp"
                android:startColor="#083A86FF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
