<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bong bóng đơn giản nhất - Chỉ dùng tông trắng trong suốt -->
    
    <!-- Lớp mờ ảo bên trong -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="@dimen/spacing_40dp"
                android:centerX="0.3"
                android:centerY="0.3"
                android:startColor="@color/mosco_white_10"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- Vệt sáng lung linh xoay nhẹ -->
    <item android:top="@dimen/spacing_xs" android:left="@dimen/spacing_xs" android:right="@dimen/spacing_xs" android:bottom="@dimen/spacing_xs">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="30dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="@color/mosco_white_15"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>

