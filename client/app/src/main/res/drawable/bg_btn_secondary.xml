<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Trạng thái nhấn -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_full" />
            <solid android:color="@color/mosco_white_10" />
            <stroke android:width="1dp" android:color="@color/mosco_primary_dim" />
        </shape>
    </item>
    <!-- Trạng thái mặc định -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_full" />
            <solid android:color="@color/mosco_white_05" />
            <stroke android:width="1dp" android:color="@color/mosco_white_20" />
        </shape>
    </item>
</selector>
