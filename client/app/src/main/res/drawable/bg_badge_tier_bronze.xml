<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp dưới: Viền gradient đồng đỏ metallic -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#D97706"
                android:endColor="#78350F"
                android:angle="45" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Lớp trên: Nền kính mờ bán trong suốt thụt lề 1.5dp -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <!-- TẠI SAO: Sử dụng màu nền đồng mờ đục 60% để tạo hiệu ứng kính mờ (Glassmorphism) ấm áp tương phản cao -->
            <solid android:color="#992D1F10" />
            <corners android:radius="10.5dp" />
        </shape>
    </item>
</layer-list>
