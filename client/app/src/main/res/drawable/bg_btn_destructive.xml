<?xml version="1.0" encoding="utf-8"?>
<!-- Tại sao: Chuyển sang thiết kế phẳng đơn lớp để tối ưu hóa hiệu năng render trên giả lập Android 9 (API 28), dùng tông màu đỏ hủy bỏ/nguy hiểm -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lg_radius_button" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>

    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/lg_radius_button" />
                    <solid android:color="#1F94A3B8" />
                </shape>
            </item>

            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/lg_radius_button" />
                    <solid android:color="@color/red_hard" />
                </shape>
            </item>

            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/lg_radius_button" />
                    <solid android:color="@color/red_hard" />
                </shape>
            </item>

            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/lg_radius_button" />
                    <solid android:color="@color/red_hard" />
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/lg_radius_button" />
                    <solid android:color="@color/red_soft" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
