<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="80"
    android:toDegrees="80"
    android:pivotX="50%"
    android:pivotY="50%">
    <shape android:shape="rectangle">
        <gradient
            android:angle="0"
            android:startColor="@color/mosco_white_00"
            android:centerColor="@color/mosco_white_33"
            android:endColor="@color/mosco_white_00"
            android:type="linear" />
        <size
            android:width="@dimen/spacing_60dp"
            android:height="600dp" />
    </shape>
</rotate>

