<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: Input field với focused state -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Glow effect khi focused -->
            <item>
                <shape>
                    <corners android:radius="@dimen/lg_radius_input" />
                    <solid android:color="@color/lg_accent_primary_alpha_15" />
                    <padding android:bottom="@dimen/lg_stroke_thin" android:left="@dimen/lg_stroke_thin" android:right="@dimen/lg_stroke_thin" android:top="@dimen/lg_stroke_thin" />
                </shape>
            </item>
            <!-- Main Background -->
            <item>
                <shape>
                    <solid android:color="@color/lg_glass_surface_elevated" />
                    <corners android:radius="@dimen/lg_radius_input" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/lg_accent_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="@color/lg_glass_surface" />
            <corners android:radius="@dimen/lg_radius_input" />
            <stroke
                android:width="@dimen/lg_stroke_hairline"
                android:color="@color/lg_glass_stroke" />
        </shape>
    </item>
</selector>
