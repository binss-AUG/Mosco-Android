<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Shadow/Glow effect (Subtle purple shadow) -->
            <item>
                <shape>
                    <corners android:radius="@dimen/radius_md" />
                    <solid android:color="#206C29FD" /> <!-- Very faint primary glow -->
                    <padding android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp" />
                </shape>
            </item>
            <!-- Main Background -->
            <item>
                <shape>
                    <solid android:color="#26FFFFFF" />
                    <corners android:radius="@dimen/radius_md" />
                    <stroke
                        android:width="1.8dp"
                        android:color="@color/mosco_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="#12FFFFFF" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="1.0dp"
                android:color="#44FFFFFF" />
        </shape>
    </item>
</selector>
