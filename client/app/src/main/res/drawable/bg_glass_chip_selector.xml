<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="5dp" android:insetRight="5dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="50dp" /> <!-- Pill shape -->
                <solid android:color="#45FFFFFF" />
                <stroke android:width="1.2dp" android:color="@color/lg_accent_primary" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="5dp" android:insetRight="5dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="50dp" /> <!-- Pill shape -->
                <solid android:color="#15FFFFFF" />
                <stroke android:width="1dp" android:color="#25FFFFFF" />
            </shape>
        </inset>
    </item>
</selector>
