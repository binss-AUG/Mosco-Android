    <!-- 4. Inner Core -->
    <group android:scaleX="0.8" android:scaleY="0.8" android:pivotX="80" android:pivotY="80" android:translateY="-4">
        <path android:fillColor="#FFCA28" android:pathData="M80,30 L123,55 L123,105 L80,130 L37,105 L37,55 Z" />
    </group>

    <!-- 5. Top Jewel -->
    <path android:fillColor="#FFF59D" android:pathData="M80,12 L88,25 L80,38 L72,25 Z" />
    
