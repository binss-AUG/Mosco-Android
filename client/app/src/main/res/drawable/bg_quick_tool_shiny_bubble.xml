<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Lớp nền tối (Glass Base) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>

    <!-- Lớp màu Iridescent (Pink/Violet) - Đậm và sắc nét hơn -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="35dp"
                android:centerX="0.2"
                android:centerY="0.8"
                android:startColor="#66FF00D4"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- Lớp màu Iridescent (Cyan/Blue) - Đậm và sắc nét hơn -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="35dp"
                android:centerX="0.8"
                android:centerY="0.2"
                android:startColor="#6600F2FF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- Lớp bóng (Glossy Highlight) ở đỉnh -->
    <item android:top="2dp" android:left="8dp" android:right="8dp" android:bottom="30dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#A6FFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- Lớp bóng nhẹ ở đáy (Refraction) -->
    <item android:top="35dp" android:left="10dp" android:right="10dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#66FFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

</layer-list>
