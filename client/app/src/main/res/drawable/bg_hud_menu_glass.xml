<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Stroke Style 2026 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#40000000" />
            <stroke
                android:width="0.8dp"
                android:color="#20FFFFFF" />
        </shape>
    </item>

    <!-- Glass Interior Obsidian Matte -->
    <item android:top="0.8dp" android:left="0.8dp" android:right="0.8dp" android:bottom="0.8dp">
        <shape android:shape="rectangle">
            <corners android:radius="23.2dp" />
            <gradient
                android:startColor="#F20E0E0E"
                android:endColor="#CC141414"
                android:angle="225" />
            <stroke
                android:width="0.5dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
